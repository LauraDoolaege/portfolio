---
// The toolkit: stacked lists. Each row is a category on the left and a comma-separated list on the right,
// with a line between rows (the one place lines are used on this page).
const groups = [
  {
    title: 'Skills',
    rows: [
      {
        label: 'UX & Research',
        items:
          'User interviews, insight gathering, wireframing, paper and digital prototyping, user testing, UI design, information architecture, data analysis (SPSS), creative data visualisation',
      },
      { label: 'Visual', items: 'Brand identity, campaign design, motion, 3D' },
      {
        label: 'Marketing & Communication',
        items:
          'Content strategy, copywriting, persuasion & nudging, workshop facilitation, pitching and presenting',
      },
    ],
  },
  {
    title: 'Tools',
    rows: [
      { label: 'Design', items: 'Figma, Photoshop, Illustrator, After Effects, Blender' },
      { label: 'Research & code', items: 'SPSS, VS Code' },
    ],
  },
  {
    title: 'Experience',
    rows: [
      {
        label: 'Marketing & Communication Intern, CAW Oost-Vlaanderen',
        items:
          'Planned content and created social media posts for key dates, wrote the letters sent to policy makers across Belgium, led a workshop on my own to restructure the new website’s content',
      },
    ],
  },
  {
    title: 'Education',
    rows: [
      {
        label: 'Digital Design & Development (Devine)',
        items: 'Howest Kortrijk, 2024 to now, major in UX design',
      },
      {
        label: 'Bachelor in Marketing Communication',
        items:
          'Cum laude. Thesis: how do you get colleagues to actually contribute to the internal newsletter? Using Cialdini’s principles of persuasion and nudging',
      },
    ],
  },
];
---

<section class="toolkit" aria-label="Toolkit">
  <div class="container">
    {groups.map((g) => (
      <div class="toolkit__group" data-reveal>
        <h2 class="toolkit__title">{g.title}</h2>
        <ul class="toolkit__list">
          {g.rows.map((r) => (
            <li class="toolkit__row">
              <h3 class="toolkit__label">{r.label}</h3>
              <p class="toolkit__items">{r.items}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .toolkit {
    padding-bottom: var(--space-section);
  }

  .toolkit__group + .toolkit__group {
    margin-top: clamp(4rem, 3rem + 5vw, 8rem);
  }

  .toolkit__title {
    font-size: clamp(2rem, 1rem + 4vw, 5rem);
    line-height: 1;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* Rows are stacked directly under each other, so they get a line between them */
  .toolkit__list {
    border-bottom: var(--hairline);
  }

  .toolkit__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem var(--grid-gutter);
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-top: var(--hairline);
  }

  .toolkit__label {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: 1.4;
  }

  .toolkit__items {
    max-width: 52ch;
    font-size: var(--text-body);
    font-weight: var(--weight-light);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .toolkit__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .toolkit__label {
      grid-column: 1 / span 4;
    }

    .toolkit__items {
      grid-column: 5 / span 7;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const groups = gsap.utils.toArray<HTMLElement>('.toolkit [data-reveal]');

  if (groups.length && !prefersReducedMotion()) {
    gsap.set(groups, { y: 28, opacity: 0 });
    ScrollTrigger.batch(groups, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', stagger: 0.12 }),
    });
  }
</script>
