---
// Site-wide header/navigation. Nav items per PROJECT_BRIEF.md Section 4
// (LOCKED): Laura Doolaege | Work | About | CV | Contact. The wordmark is
// back, but small this time — a quiet corner mark rather than a masthead
// statement, since the Hero now carries its own big headline moment (see
// Hero.astro) and the two shouldn't compete for the same visual weight.
//
// Open decisions this component had to fill in (see CLAUDE.md "Open
// decisions" — not locked anywhere yet):
// - Mobile nav pattern: regular inline text nav from tablet (768px) up.
//   Below that, a hamburger + overlay panel — phone-only. The CV button
//   stays visible at every width — only Work/About/Contact collapse into
//   the panel.
// - Sticky vs. static: static (scrolls with the page).
// - No border under the header, per explicit request — the header and
//   Hero now read as one continuous opening screen (see index.astro),
//   so a hard rule between them would cut that in half.
import { withBase } from '../../utils/url';
import Button from '../ui/Button.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={withBase('/')} class="site-header__name">
      Laura Doolaege
    </a>

    <div class="site-header__right">
      <nav aria-label="Primary" class="site-header__nav" id="primary-nav">
        <ul class="site-header__links">
          <li>
            <a href={withBase('/work')} class="site-header__link">
              Work
            </a>
          </li>
          <li>
            <a href={withBase('/about')} class="site-header__link">
              About
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="site-header__link">
              Contact
            </a>
          </li>
        </ul>
      </nav>

      <!-- TODO: replace href="#" with the real CV PDF path once supplied (PROJECT_BRIEF.md Section 6) -->
      <Button href="#" variant="primary" icon="download" class="site-header__cv">
        CV
      </Button>

      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Menu"
      >
        <span class="site-header__toggle-bar"></span>
        <span class="site-header__toggle-bar"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.site-header__toggle');
  const nav = header?.querySelector('.site-header__nav');

  if (header && toggle && nav) {
    const closeMenu = () => {
      nav.classList.remove('is-open');
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.classList.toggle('is-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) {
        closeMenu();
      }
    });

    const tabletUpQuery = window.matchMedia('(min-width: 768px)');
    tabletUpQuery.addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    padding-block: clamp(1.5rem, 1.5vw + 1rem, 2.25rem);
  }

  .site-header__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    row-gap: 0.75rem;
    column-gap: 2rem;
  }

  /* Small corner mark, not a masthead — see the file header comment. */
  .site-header__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.95rem, 0.3vw + 0.85rem, 1.1rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
    transition: color var(--motion-duration) var(--motion-easing);
  }

  .site-header__name:hover {
    color: var(--color-accent);
  }

  .site-header__name:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Groups the nav links and the CV button together, CV last so it stays
     the far-right, distinct CTA — not just another item in the nav's own
     rhythm. Below tablet width the toggle becomes the actual rightmost
     item instead (see media query). */
  .site-header__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  /* Editorial "/" rhythm between nav items, in place of pure whitespace
     — decorative punctuation, not content, so it's CSS-generated rather
     than markup. */
  .site-header__links li:not(:first-child)::before {
    content: '/';
    margin-inline-end: 0.6rem;
    color: var(--color-text-secondary);
  }

  /* Light and subtle, per explicit request: text-secondary rather than
     full ink, weight stays at the brief's locked "Body Medium" nav spec
     (PROJECT_BRIEF.md Section 3 type hierarchy) — only the color recedes. */
  .site-header__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-nav);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    padding-block: 0.2em;
    border-bottom: var(--border-hairline) solid transparent;
    transition:
      color var(--motion-duration) var(--motion-easing),
      border-color var(--motion-duration) var(--motion-easing);
  }

  .site-header__link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .site-header__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .site-header__toggle {
    display: none;
    position: relative;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .site-header__toggle-bar {
    position: absolute;
    left: 6px;
    right: 6px;
    height: 2px;
    background: var(--color-ink);
    transition:
      transform var(--motion-duration) var(--motion-easing),
      top var(--motion-duration) var(--motion-easing);
  }

  .site-header__toggle-bar:first-child {
    top: 12px;
  }

  .site-header__toggle-bar:last-child {
    top: 20px;
  }

  .site-header__toggle.is-open .site-header__toggle-bar:first-child {
    top: 16px;
    transform: rotate(45deg);
  }

  .site-header__toggle.is-open .site-header__toggle-bar:last-child {
    top: 16px;
    transform: rotate(-45deg);
  }

  .site-header__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      padding-inline: 1.5rem;
    }
  }

  /* Below tablet (phone only): Work/About/Contact collapse into a
     hamburger panel. CV stays visible outside it — an always-reachable
     primary action, not buried behind a menu tap. 768px is the standard
     tablet-starts boundary, not a value locked anywhere in the brief (see
     the note at the top of this file) — tablet and up keeps the plain
     inline nav. */
  @media (max-width: 767px) {
    .site-header__toggle {
      display: block;
    }

    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg-secondary);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity var(--motion-duration-slow) var(--motion-easing),
        transform var(--motion-duration-slow) var(--motion-easing),
        visibility var(--motion-duration-slow);
    }

    .site-header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .site-header__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 1.5rem;
    }

    .site-header__links li {
      width: 100%;
    }

    .site-header__links li:not(:first-child)::before {
      content: none;
    }

    .site-header__link {
      display: block;
      padding-block: 0.85em;
      font-size: 1rem;
    }
  }
</style>
