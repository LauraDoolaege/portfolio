---
// Navigation bar: wordmark left, links centred, Resume right (the one thing a recruiter wants, always in reach).
// The light/dark switch is a fixed control in the bottom-right corner, outside the bar.
import { withBase } from '../../utils/url';
import { cvHref } from '../../utils/contact';
import Button from '../ui/Button.astro';

const links = [
  { href: `${withBase('/')}#work`, label: 'Work' },
  { href: withBase('/about'), label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand">
      <a href={withBase('/')} class="site-header__name">
        Laura Doolaege
      </a>
      <!-- Light/dark: just the half-moon; the mode it will switch to is named on hover or focus -->
      <button class="theme-toggle theme-icon" type="button" aria-label="Switch to dark mode">
        <span class="theme-toggle__icon" aria-hidden="true"></span>
        <span class="theme-toggle__label">Dark</span>
      </button>
    </div>
    <div class="site-header__right">
    <nav aria-label="Primary">
      <ul class="site-header__links">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link"
              data-magnetic
              aria-current={l.href === currentPath ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__end">
      <Button class="site-header__resume" href={cvHref} icon="down" download>Resume</Button>
    </div>
    </div>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>

  <!-- Phones: the links move into a full-screen menu in the inverted palette -->
  <div class="menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <ul class="menu__links">
      {links.map((l) => (
        <li>
          <a href={l.href} class="menu__link">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="menu__tag">
      <span class="menu__dot" aria-hidden="true"></span>
      Open to internships · Feb 2027
    </p>
    <!-- The way to the CV lives here on phones, under the links -->
    <Button class="menu__resume" href={cvHref} icon="down" download>Resume</Button>
  </div>

  <!-- Phones: the light/dark switch is a toggle fixed in the bottom-right corner -->
  <button class="theme-toggle theme-switch" type="button" aria-label="Switch to dark mode">
    <span class="theme-toggle__track" aria-hidden="true">
      <span class="theme-toggle__icon"></span>
    </span>
    <span class="theme-toggle__label sr-only">Dark</span>
  </button>
</header>

<style>
  /* Sticky, and it steps out of the way while reading down and returns on the first scroll up (class set by the script) */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg-primary);
    /* Hidden by moving its sticky offset, not by a transform: a transform would carry the fixed corner switch away with it */
    transition: top 0.45s var(--ease-out);
  }

  .site-header.is-hidden {
    top: -6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  /* Above the open menu */
  .site-header__inner {
    position: relative;
    z-index: 2;
  }

  /* Hamburger: two bars that cross into an X. Hidden above the phone breakpoint. */
  .menu-toggle {
    display: none;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.75rem;
    margin-left: -0.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.5s var(--ease-out),
      top 0.5s var(--ease-out);
  }

  .menu-toggle__bar:first-child {
    top: calc(50% - 4px);
  }

  .menu-toggle__bar:last-child {
    top: calc(50% + 3px);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:first-child {
    top: 50%;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:last-child {
    top: 50%;
    transform: rotate(-45deg);
  }

  /* The menu: full screen, the page's ink as its ground and the page's ground as its type (so it is beige in
     dark mode and charcoal in light). Revealed with the same grainy sweep as the theme switch (see the script). */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 5rem var(--page-margin) 3rem;
    background: var(--text-main);
    color: var(--bg-primary);
    /* Left-aligned like every page: the links hang from the page margin */
    text-align: left;
  }

  .menu[hidden] {
    display: none;
  }

  .menu {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(2rem, 6vh, 3.5rem);
  }

  .menu__tag {
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Resume in the menu: outlined in the menu's own ink (the page's ground) */
  :global(.menu .menu__resume) {
    border-color: var(--bg-primary);
    color: var(--bg-primary);
  }

  :global(.menu .menu__resume:hover),
  :global(.menu .menu__resume:focus-visible) {
    color: var(--text-main);
  }

  :global(.menu .menu__resume::before) {
    background: linear-gradient(to right, var(--bg-primary) var(--fill), transparent calc(var(--fill) + 45%));
  }

  .menu__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 4vh, 2rem);
  }

  .menu__link {
    display: block;
    padding: 0.2em 0;
    font-size: clamp(2.75rem, 1.5rem + 11vw, 4.5rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .menu__link:focus-visible {
    outline: 1.5px solid currentColor;
    outline-offset: 0.1em;
  }

  /* Open: the header's own marks flip to the menu's palette so they stay readable on it */
  :global(html.menu-open) {
    overflow: hidden;
  }

  :global(html.menu-open) .site-header {
    border-color: color-mix(in srgb, var(--bg-primary) 22%, transparent);
    color: var(--bg-primary);
  }

  @media (max-width: 719px) {
    .menu-toggle {
      display: block;
    }

    /* The links and Resume live in the menu; the theme icon is replaced by the corner switch */
    .site-header .site-header__inner {
      display: flex;
      justify-content: space-between;
    }

    .site-header__inner .site-header__links {
      display: none;
    }

    .site-header .site-header__end,
    .site-header__brand .theme-icon {
      display: none;
    }
  }

  /* Wide screens have the icon beside the name; the corner switch is for phones only */
  .theme-switch {
    display: none;
  }

  @media (max-width: 719px) {
    .theme-switch {
      position: fixed;
      right: max(var(--page-margin), env(safe-area-inset-right));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      z-index: 70;
      display: inline-flex;
      justify-content: center;
      width: 3.5rem;
      height: 2.75rem;
      padding: 0;
      color: var(--text-muted);
      /* A chip, so it stays readable over text and over the dark footer */
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 999px;
    }

    .theme-switch::after {
      display: none;
    }

    .theme-toggle__track {
      position: relative;
      display: block;
      width: 3.25rem;
      height: 1.75rem;
      border: 1.5px solid currentColor;
      border-radius: 999px;
    }

    .theme-switch .theme-toggle__icon {
      position: absolute;
      top: 50%;
      left: 0.2rem;
      width: 1.1rem;
      height: 1.1rem;
      margin-top: -0.55rem;
      transition: transform 0.5s var(--ease-out);
    }

    :global(:root[data-theme='dark']) .theme-switch .theme-toggle__icon {
      transform: translateX(1.5rem);
    }

    /* Over the open menu the switch takes the menu's colours */
    :global(html.menu-open) .theme-switch {
      color: var(--bg-primary);
      background: var(--text-main);
      border-color: transparent;
    }

    .menu__resume {
      align-self: flex-start;
    }
  }

  @media (min-width: 720px) {
    .menu {
      display: none;
    }
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--grid-gutter);
    padding-block: 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-regular);
  }

  .site-header__name {
    white-space: nowrap;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-title);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: var(--text-muted);
  }

  /* Right end of the bar: availability, then Resume (outlined, with the site's sand-fill hover) */
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  /* The theme icon: it takes the toggle's look from global.css but sits in the bar (not fixed). The label is hidden at
     rest and fades in beside the icon on hover or keyboard focus. */
  .site-header__brand .theme-icon {
    position: relative;
    right: auto;
    bottom: auto;
    z-index: auto;
    gap: 0.6em;
    padding: 0.35em 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .site-header__brand .theme-icon::after {
    display: none;
  }

  .site-header__brand .theme-icon .theme-toggle__label {
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.45s var(--ease-out);
    white-space: nowrap;
  }

  .site-header__brand .theme-icon .theme-toggle__label::before {
    content: '( ';
  }

  .site-header__brand .theme-icon .theme-toggle__label::after {
    content: ' )';
  }

  .site-header__brand .theme-icon:hover .theme-toggle__label,
  .site-header__brand .theme-icon:focus-visible .theme-toggle__label {
    opacity: 1;
    transform: none;
  }

  /* On touch there is no hover: icon only */
  @media (hover: none) {
    .site-header__brand .theme-icon .theme-toggle__label {
      display: none;
    }
  }

  .site-header__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }

  .site-header__links li {
    white-space: nowrap;
  }

  .site-header__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }

  :global(.site-header__resume) {
    padding: 0.7em 1.1em;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
  }

  /* Thin vertical rules sit between items only: never before the first one */
  .site-header__links li + li::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.95em;
    margin-inline: clamp(0.6rem, 0.3rem + 1vw, 1.1rem);
    vertical-align: -0.12em;
    background: var(--border-color);
  }

  .site-header__links a {
    position: relative;
    padding-block: 0.35em;
    transition:
      color var(--duration) var(--ease-out),
      opacity var(--duration) var(--ease-out);
  }

  /* Hover: the hovered link stays full strength, its siblings dim */
  .site-header__links:hover a {
    opacity: 0.5;
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    opacity: 1;
    color: var(--text-main);
  }

  /* Current page: full ink, with the same thin line the hover draws, held open */
  .site-header__links a[aria-current='page'] {
    color: var(--text-main);
  }

  .site-header__links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Touch and phone widths: the marks stay small, their hit areas grow to ~44px without moving anything */
  @media (hover: none), (max-width: 719px) {
    .site-header__name,
    .site-header__links a {
      position: relative;
    }

    .site-header__name::before,
    .site-header__links a::before {
      content: '';
      position: absolute;
      inset: -0.75rem -0.5rem;
    }
  }


  /* Phones: the bar is just the name and the menu button; Resume and the theme live in the menu and the corner */
  @media (max-width: 719px) {
    .site-header .site-header__end {
      display: none;
    }

    .site-header__brand .theme-icon {
      display: none;
    }
  }
</style>

<script>
  import { sweepWith } from '../../scripts/theme';

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const wide = window.matchMedia('(min-width: 720px)');
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function set(open: boolean) {
    if (!button || !menu) return;
    menu.hidden = !open;
    root.classList.toggle('menu-open', open);
    // The page behind an open menu is out of reach (Tab, screen reader and pointer alike)
    document.querySelectorAll('main, footer').forEach((el) => el.toggleAttribute('inert', open));
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  function toggle(open: boolean, animate = true) {
    if (!button || !menu || root.classList.contains('menu-open') === open) return;
    if (animate && !reduce() && 'startViewTransition' in document) {
      sweepWith(() => set(open));
    } else {
      set(open);
      // No View Transitions: a plain fade in
      if (open && animate && !reduce())
        menu.animate({ opacity: [0, 1] }, { duration: 400, easing: 'ease-out' });
    }
    if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (animate) button.focus({ preventScroll: true });
  }

  button?.addEventListener('click', () => toggle(!root.classList.contains('menu-open')));
  // Picking a link closes the menu at once, then the browser follows the link
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) toggle(false, false);
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggle(false);
    // Focus stays inside the open menu: the toggle, the links and the theme button, in a loop
    if (e.key === 'Tab' && root.classList.contains('menu-open') && button && menu) {
      const ring = [button, ...Array.from(menu.querySelectorAll<HTMLElement>('a, button'))];
      const first = ring[0];
      const last = ring[ring.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
  wide.addEventListener('change', () => {
    if (wide.matches) toggle(false, false);
  });
</script>

<script>
  // Hide on the way down, show on the way up (ScrollTrigger reports the direction; no scroll listeners). Always shown near
  // the top of the page and while the phone menu is open.
  import { ScrollTrigger } from '../../utils/motion';

  const bar = document.querySelector<HTMLElement>('.site-header');
  if (bar) {
    ScrollTrigger.create({
      start: 0,
      end: 'max',
      onUpdate: (self) => {
        const open = document.documentElement.classList.contains('menu-open');
        const hide = self.direction === 1 && self.scroll() > 240 && !open;
        bar.classList.toggle('is-hidden', hide);
      },
    });
    // Keyboard focus inside the bar brings it back
    bar.addEventListener('focusin', () => bar.classList.remove('is-hidden'));
  }
</script>
