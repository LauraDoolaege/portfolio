---
// One chapter of a case study: title in the left rail, content on the right, a hairline above.
// Stacks on small screens. Text and images share the right column so images stay proportional to it.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="case-section">
  <h2 class="case-section__title">{title}</h2>
  <div class="case-section__body">
    <slot />
  </div>
</section>

<style>
  .case-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: var(--hairline);
  }

  .case-section__title {
    font-size: var(--text-title);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    text-wrap: balance;
  }

  .case-section__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 52rem;
  }

  @media (min-width: 900px) {
    .case-section {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    .case-section__title {
      grid-column: 1 / span 4;
      max-width: 10ch;
    }

    .case-section__body {
      grid-column: 5 / -1;
    }
  }
</style>
