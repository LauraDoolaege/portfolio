---
// Navigation bar: wordmark left, links right, hairline underneath.
import { withBase } from '../../utils/url';

const links = [
  { href: `${withBase('/')}#work`, label: 'Work' },
  { href: withBase('/about'), label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase('/')} class="site-header__name">Laura Doolaege</a>
    <nav aria-label="Primary">
      <ul class="site-header__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === currentPath ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--grid-gutter);
    padding-block: 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-regular);
  }

  .site-header__name {
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
  }

  .site-header__links {
    display: flex;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    color: var(--text-muted);
  }

  .site-header__links a {
    transition: color var(--duration) var(--ease-out);
  }

  .site-header__links a:hover,
  .site-header__links a[aria-current='page'] {
    color: var(--text-main);
  }

  .site-header__links a:hover {
    color: var(--accent);
  }
</style>
