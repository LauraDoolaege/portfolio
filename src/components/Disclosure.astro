---
// Secondary material that should not weigh on a long page: a native <details>, closed by default, with a plain
// label and a chevron. Keyboard and screen-reader behaviour come from the element itself.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<details class="disclosure">
  <summary class="disclosure__summary">
    <span>{label}</span>
    <svg class="disclosure__chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"></path>
    </svg>
  </summary>
  <div class="disclosure__body">
    <slot />
  </div>
</details>

<style>
  .disclosure {
    margin-top: 1.5rem;
    border-block: var(--hairline);
  }

  .disclosure__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    cursor: pointer;
    list-style: none;
  }

  .disclosure__summary::-webkit-details-marker {
    display: none;
  }

  .disclosure__chevron {
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.4s var(--ease-out);
  }

  .disclosure[open] .disclosure__chevron {
    transform: rotate(180deg);
  }

  .disclosure__body {
    padding-bottom: 1.25rem;
  }

  /* Lists inside match the page's ruled lists: bold lead-ins, one soft rule between items */
  .disclosure__body :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .disclosure__body :global(li) {
    max-width: 62ch;
    padding-block: 0.9rem;
    font-size: var(--text-paragraph);
    font-weight: var(--weight-light);
    line-height: var(--leading-paragraph);
    text-wrap: pretty;
  }

  .disclosure__body :global(li + li) {
    border-top: var(--hairline);
  }
</style>
