---
// Homepage "Selected work," rebuilt around content.md's own structure and
// projects.json (see that file's own header comment for its shape - real
// titles/tags/one-liners, several fields still bracketed placeholders
// like "[Solo or team]", used verbatim per content.md's own rule).
//
// Replaces the previous two-group expanding-accordion device outright
// (see AGENTS.md's earlier entries for that whole history) with a plain
// filterable grid: content.md asks for "Filters: All / UX / Visual," not
// groups, and projects.json is one flat, ordered list rather than two
// separate arrays - the accordion's whole reason for existing (two named
// categories, each its own disclosure) no longer matches the content
// model. ProjectCard.astro itself (the full-bleed image + hover-reveal
// overlay) is unchanged - only how this section arranges and filters it.
//
// The filter is plain client-side JS: each button sets data-filter, each
// card carries data-tag (from ProjectCard.astro), and a click just
// toggles `hidden` - no framework needed for three buttons and six
// cards. content.md's "Same brain, different canvas" line renders once,
// shown only while the Visual filter is active.
//
// The custom "go" cursor over a hovered card is unchanged from the
// accordion version (adapted from Gallery.astro's own, per direct
// request - see that entry in AGENTS.md) - it only ever depended on
// `.selected-work .project-card`, which still exists here.
//
// The closing "Like what you see? Let's talk." line and its terracotta
// wink aren't part of content.md, but nothing asked for them to go, and
// removing them would also break their pairing with CurrentlyWorkingOn's
// own wink directly below (see that file's header comment) - kept as-is.
import SectionMarker from '../ui/SectionMarker.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import projectsData from '../../data/projects.json';

const projects = [...projectsData.projects].sort((a, b) => a.order - b.order);
const uxCount = projects.filter((p) => p.tag === 'UX').length;
const visualCount = projects.filter((p) => p.tag === 'Visual').length;
const filters = ['All', 'UX', 'Visual'] as const;
---

<section class="selected-work" id="work">
  <div class="selected-work__inner">
    <SectionMarker
      index="01"
      label="Selected work"
      description={`${projects.length} projects, ${uxCount} UX and ${visualCount} visual`}
    />

    <div class="selected-work__filters" role="group" aria-label="Filter projects by type">
      {filters.map((filter, i) => (
        <button
          type="button"
          class="selected-work__filter"
          data-filter={filter}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {filter}
        </button>
      ))}
    </div>

    <!-- content.md "Selected work": "Intro line shown with the visual projects," verbatim. -->
    <p class="selected-work__visual-line" hidden>
      Same brain, different canvas. Even when there's no app to test, I'm still asking the UX
      questions: who is this for, what should they feel, and does it make sense?
    </p>

    <ul class="selected-work__grid">
      {projects.map((project) => (
        <li>
          <ProjectCard
            order={project.order}
            title={project.title}
            tag={project.tag}
            oneLiner={project.oneLiner}
            team={project.team}
            role={project.role}
          />
        </li>
      ))}
    </ul>

    <p class="selected-work__cta">
      <span class="selected-work__cta-wink" aria-hidden="true">
        *
      </span>
      Like what you see?{' '}
      <a href="#contact" class="selected-work__cta-link">
        Let's talk.
      </a>
    </p>
  </div>
</section>

<!--
  A sibling of <section>, not a descendant - see Gallery.astro's own
  comment on why a `position: fixed` cursor needs to stay outside
  anything that might grow a transform (.project-card gets one on
  hover).
-->
<div class="selected-work__cursor" aria-hidden="true">
  <span class="selected-work__cursor-inner">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</div>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  // --- Filter ---
  const section = document.querySelector('.selected-work');
  if (section) {
    const buttons = section.querySelectorAll<HTMLButtonElement>('.selected-work__filter');
    const cards = section.querySelectorAll<HTMLElement>('.project-card');
    const visualLine = section.querySelector<HTMLElement>('.selected-work__visual-line');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        cards.forEach((card) => {
          const li = card.closest('li');
          const matches = filter === 'All' || card.dataset.tag === filter;
          if (li) li.hidden = !matches;
        });

        if (visualLine) visualLine.hidden = filter !== 'Visual';
      });
    });
  }

  // --- Custom "go" cursor, hovering a project card ---
  const reduceMotion = prefersReducedMotion();
  if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
    const cursor = document.querySelector<HTMLElement>('.selected-work__cursor');
    // .project-card is a plain <article> now, not a link (see
    // ProjectCard.astro's own comment) - the cursor still tracks
    // pointer position over it the same way regardless of element type.
    const cards = document.querySelectorAll<HTMLElement>('.selected-work .project-card');

    if (cursor && cards.length) {
      document.querySelector('.selected-work')?.classList.add('selected-work--custom-cursor');

      const moveX = gsap.quickTo(cursor, 'x', { duration: 0.35, ease: 'power3.out' });
      const moveY = gsap.quickTo(cursor, 'y', { duration: 0.35, ease: 'power3.out' });

      cards.forEach((card) => {
        card.addEventListener('pointerenter', (event) => {
          gsap.set(cursor, { x: event.clientX, y: event.clientY });
          cursor.classList.add('is-active');
        });
        card.addEventListener('pointermove', (event) => {
          moveX(event.clientX);
          moveY(event.clientY);
        });
        card.addEventListener('pointerleave', () => {
          cursor.classList.remove('is-active');
        });
      });
    }
  }
</script>

<style>
  .selected-work {
    padding-block: var(--space-section) 1.5rem;
  }

  .selected-work__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
  }

  .selected-work__filters {
    margin-top: 2.5rem;
    display: flex;
    gap: var(--space-24);
  }

  .selected-work__filter {
    padding: 0 0 0.35em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    background: none;
    border: none;
    border-bottom: var(--border-hairline) solid transparent;
    cursor: pointer;
    transition:
      color var(--motion-duration) var(--motion-easing-soft),
      border-color var(--motion-duration) var(--motion-easing-soft);
  }

  .selected-work__filter:hover {
    color: var(--color-ink);
  }

  .selected-work__filter[aria-pressed='true'] {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .selected-work__filter:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .selected-work__visual-line {
    margin-top: var(--space-24);
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  .selected-work__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-32);
  }

  .selected-work__grid > li {
    aspect-ratio: 4 / 3;
  }

  .selected-work__grid :global(.project-card) {
    height: 100%;
  }

  @media (min-width: 640px) {
    .selected-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .selected-work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* The other half of the footnote-and-reference pair (see
     .selected-work__cta-wink below) - a matching terracotta asterisk
     closing this section's own SectionMarker description. */
  .selected-work :global(.section-marker__description)::after {
    content: ' *';
    display: inline-block;
    font-family: var(--font-display);
    color: var(--color-accent-signal);
    transform: rotate(-8deg);
  }

  .selected-work__cta {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 3rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .selected-work__cta-wink {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent-signal);
    transform: rotate(-8deg);
  }

  .selected-work__cta-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color var(--motion-duration) var(--motion-easing-soft);
  }

  .selected-work__cta-link:hover,
  .selected-work__cta-link:focus-visible {
    color: var(--color-accent);
  }

  .selected-work__cta-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .selected-work__inner {
      padding-inline: 1.5rem;
    }
  }

  /* --- Cursor, adapted from Gallery.astro's own version --- */

  .selected-work--custom-cursor :global(.project-card) {
    cursor: none;
  }

  .selected-work__cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 55;
    width: 3.5rem;
    height: 3.5rem;
    margin: -1.75rem;
    pointer-events: none;
  }

  .selected-work__cursor-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-bg-primary);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity var(--motion-duration) var(--motion-easing-soft),
      transform var(--motion-duration) var(--motion-easing-soft);
  }

  .selected-work__cursor-inner svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .selected-work__cursor.is-active .selected-work__cursor-inner {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 900px) {
    .selected-work__cursor {
      display: none;
    }
  }
</style>
