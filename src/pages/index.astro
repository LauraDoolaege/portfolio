---
// Homepage. Section order and content per PROJECT_BRIEF.md Section 4
// "Homepage structure (LOCKED)" / Section 5 "Homepage — LOCKED" — with
// one deliberate departure from that original order, per direct request:
// Selected Work now leads (01), Currently Working On sits directly below
// it, then Principles (02) and Gallery (03), into ContactCTA/Footer.
// "How I think" is gone outright (its 3 principle titles were folded
// into Principles.astro first - see that file's own comment - then this
// import/usage was deleted, not just skipped, since nothing else needs
// HowIThink.astro any more).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import CurrentlyWorkingOn from '../components/sections/CurrentlyWorkingOn.astro';
import Principles from '../components/sections/Principles.astro';
import Gallery from '../components/sections/Gallery.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
---

<BaseLayout title="Laura Doolaege | Portfolio">
  <div class="intro">
    <Header />
    <Hero />
  </div>
  <SelectedWork />
  <CurrentlyWorkingOn />
  <Principles />
  <Gallery />
  <ContactCTA />
  <Footer />
</BaseLayout>

<style>
  /* Header + Hero fill the opening viewport as one screen, per explicit
     request — dvh rather than vh so mobile browser chrome doesn't clip
     it, min-height rather than height so content is never forced to
     overflow/clip on a short viewport. Hero.astro's own `flex: 1` is what
     lets it absorb the remaining space and center its content within it. */
  .intro {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>
