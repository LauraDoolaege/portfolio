---
// About page "What drives me" (PROJECT_BRIEF.md Section 4/5, item 4).
// Copy is final, supplied directly by the user.
//
// Redesigned per direct follow-up request: "Summarize the what drives
// me section to 3 points and make the layout the same as the design
// principle cards on the homepage." This replaces the page's earlier
// "tactile centerpiece" treatment (four short statements as small
// rotated note cards on a chalk field - see this project's own AGENTS.md
// for that pass's full reasoning) outright, not a variant layered
// alongside it - a direct instruction to match a specific existing
// layout supersedes the earlier "have fun with it, make it tactile"
// brief this replaces.
//
// Four statements summarized to three, without inventing new claims:
// the original items 3 ("Turning insights into concepts") and 4
// ("Making things creative and grounded") are combined into one - both
// were about the same step (turning raw insight into a considered,
// grounded concept), so folding them together is a real summary of her
// own words, not new content. Items 1 and 2 are unchanged verbatim.
//
// Layout now reuses Principles.astro's own device exactly - a 3-column
// grid, hairline dividers between items (skipped on the first so the
// row doesn't open with a stray rule), mono index above a bold
// Barlow Condensed line - rather than inventing a new one, per the
// direct request to match it. AboutDrives' own items are single short
// phrases with no separate title/body split the way Principles' three
// sentences have, so there's no second `<p>` here - just the phrase
// itself, styled the same weight Principles' own title line uses. The
// chalk section background and the tilted-card shadow/sharp-corner
// styling from the previous version are gone with it - Principles
// itself has no section-level background of its own, and matching its
// layout means matching that too, not just the grid.
import SectionMarker from '../ui/SectionMarker.astro';

const items = [
  'Understanding why things do or don’t work',
  'Those "lightbulb" moments',
  'Turning insights into concepts that are creative and grounded',
];
---

<section class="about-drives">
  <div class="about-drives__inner">
    <SectionMarker index="04" label="What drives me" />

    <ul class="about-drives__list">
      {items.map((text, index) => (
        <li class="about-drives__item">
          <span class="about-drives__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <p class="about-drives__text">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const items = document.querySelectorAll<HTMLElement>('.about-drives__item');
  if (items.length && !prefersReducedMotion()) {
    // Same plain fade/rise stagger Principles.astro's own list uses -
    // matching that layout means matching its motion too, not just its
    // markup/CSS, rather than keeping the previous version's rotational
    // settle for a shape this section no longer has.
    gsap.set(items, { autoAlpha: 0, y: 20 });
    gsap.to(items, {
      autoAlpha: 1,
      y: 0,
      duration: 0.65,
      ease: 'power2.out',
      stagger: 0.1,
      scrollTrigger: { trigger: '.about-drives__list', start: 'top 85%' },
    });
  }
</script>

<style>
  .about-drives {
    padding-block: var(--space-section);
    /* Plate boundary - see AboutStory's matching rule for why. */
    border-top: var(--border-hairline) solid var(--color-text-secondary);
  }

  .about-drives__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
  }

  .about-drives__list {
    margin-top: var(--space-48);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
  }

  .about-drives__item {
    padding-left: var(--space-24);
    /* A hairline divider between columns, not a border/background per
           item - only items after the first get one, so the row doesn't
           open with a stray rule before any content. */
    border-left: var(--border-hairline) solid var(--color-text-secondary);
  }

  .about-drives__item:first-child {
    padding-left: 0;
    border-left: none;
  }

  .about-drives__number {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .about-drives__text {
    margin: 0;
    margin-top: var(--space-8);
    max-width: 28ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .about-drives__list {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }

    /* Horizontal dividers instead of vertical ones once the columns
           stack - the same device rotated 90 degrees, matching Principles'
           own mobile fallback exactly. */
    .about-drives__item {
      padding-left: 0;
      padding-top: var(--space-24);
      border-left: none;
      border-top: var(--border-hairline) solid var(--color-text-secondary);
    }

    .about-drives__item:first-child {
      padding-top: 0;
      border-top: none;
    }
  }

  @media (max-width: 639px) {
    .about-drives__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
