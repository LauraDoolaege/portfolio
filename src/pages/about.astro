---
// About page - reset to a blank slate for a fresh direction. Every
// section component that used to render here (AboutIntro, AboutStory,
// AboutProcess, AboutDrives, ContactCTA, Footer) is kept in
// src/components/ in case it's reused, just not imported here. Header
// (the nav) is the only thing still on the page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import UnderConstruction from '../components/ui/UnderConstruction.astro';
---

<BaseLayout
  title="About | Laura Doolaege"
  description="Laura's portfolio: digital development & design."
>
  <div class="page">
    <Header />
    <main id="main">
      <UnderConstruction />
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>
