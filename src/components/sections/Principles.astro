---
// Homepage process section, rebuilt around content.md's "How I detangle
// (process)" - replaces the previous "3 design principles" (3 short
// items, reused verbatim from About's old "How I work" section) with the
// new 7-step process content.md supplies directly, word for word. Same
// SectionMarker device every other numbered homepage section uses,
// index "02" (Selected Work is "01" - see that file's own comment).
//
// The "Get to know me" CTA that used to sit under the 3-item list stays
// - not part of content.md, but nothing asked for it to go, and it's
// still a reasonable link into the About page from here.
import { withBase } from '../../utils/url';
import SectionMarker from '../ui/SectionMarker.astro';
import Button from '../ui/Button.astro';

const steps = [
  {
    title: 'Sparks',
    text: 'The brief is barely out and tiny ideas are already popping up. I write them all down, even the weird ones.',
  },
  {
    title: 'Mapping',
    text: 'Little mind maps everywhere. Everything connects to everything.',
  },
  {
    title: 'The knot',
    text: "And then it gets messy. Too many ideas, too many angles. That's fine. That's where it gets fun.",
  },
  {
    title: 'Detangling',
    text: 'I gather as much info as I can about the brand, the people, and the market. The base keeps getting bigger.',
  },
  {
    title: 'Looking away',
    text: "The answer rarely comes from staring at a screen. It comes during a long drive home, a walk with my dog, a game of pool I'm probably losing, or a venting session at the dinner table. Saying things out loud to a sparring partner is often where the knot starts to loosen.",
  },
  {
    title: 'The string',
    text: 'Somewhere in there is one loose string. Pull it and the whole knot comes undone.',
  },
  {
    title: 'Then I build',
    text: 'First my assumption, then the creative direction, then the technical part. In that order.',
  },
];
---

<section class="principles" id="process">
  <div class="principles__inner">
    <SectionMarker index="02" label="How I detangle" />

    <ol class="principles__list">
      {steps.map((step, index) => (
        <li class="principles__item">
          <span class="principles__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="principles__title">{step.title}</h3>
          <p class="principles__text">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="principles__cta">
      <Button href={withBase('/about')} variant="primary" icon="arrow">
        Get to know me
      </Button>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const items = document.querySelectorAll<HTMLElement>('.principles__item');
  if (items.length && !prefersReducedMotion()) {
    gsap.set(items, { autoAlpha: 0, y: 20 });
    gsap.to(items, {
      autoAlpha: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      stagger: 0.06,
      scrollTrigger: { trigger: '.principles__list', start: 'top 88%' },
    });
  }

  const cta = document.querySelector<HTMLElement>('.principles__cta');
  if (cta && !prefersReducedMotion()) {
    gsap.set(cta, { autoAlpha: 0, y: 16 });
    gsap.to(cta, {
      autoAlpha: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: cta, start: 'top 92%' },
    });
  }
</script>

<style>
  .principles {
    padding-block: var(--space-section);
  }

  .principles__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
  }

  .principles__list {
    margin-top: var(--space-48);
    display: flex;
    flex-direction: column;
  }

  .principles__item {
    display: grid;
    grid-template-columns: minmax(0, 6rem) 1fr;
    align-items: baseline;
    gap: var(--space-24);
    padding-block: var(--space-24);
    border-top: var(--border-hairline) solid var(--color-text-secondary);
  }

  .principles__item:last-child {
    border-bottom: var(--border-hairline) solid var(--color-text-secondary);
  }

  .principles__number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    line-height: 1;
    color: var(--color-text-secondary);
    opacity: 0.5;
  }

  .principles__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-ink);
  }

  .principles__text {
    margin-top: var(--space-8);
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  .principles__cta {
    margin-top: var(--space-48);
  }

  @media (max-width: 640px) {
    .principles__inner {
      padding-inline: 1.5rem;
    }

    .principles__item {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
