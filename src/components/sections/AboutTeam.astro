---
// In a team: a large pull-quote in the same 12-column architecture as the journey.
---

<section class="team" aria-labelledby="team-label">
  <div class="container">
    <div class="team__row grid">
      <h2 id="team-label" class="team__label" data-reveal>
        In a team
      </h2>
      <blockquote class="team__quote" data-reveal>
        <p>
          A good project starts with alignment. I focus on getting the team talking and comfortable
          early on. I love facilitating brainstorms, but I also play the role of the grounded
          researcher—always asking, 'Does this still solve the user's core problem?' When it's time
          to pitch, I help structure our findings into a clear, compelling narrative.
        </p>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .team {
    padding-bottom: var(--space-section);
  }

  .team__row {
    row-gap: 1rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem);
    border-block: var(--hairline);
  }

  .team__label,
  .team__quote {
    grid-column: 1 / -1;
  }

  .team__label {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .team__quote {
    margin: 0;
    max-width: 30em;
    font-size: clamp(1.5rem, 1rem + 2.1vw, 3rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1.12;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .team__label {
      grid-column: 1 / span 4;
    }

    .team__quote {
      grid-column: 5 / -1;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const items = gsap.utils.toArray<HTMLElement>('.team [data-reveal]');

  if (items.length && !prefersReducedMotion()) {
    gsap.set(items, { y: 28, opacity: 0 });
    ScrollTrigger.batch(items, {
      start: 'top 88%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', stagger: 0.12 }),
    });
  }
</script>
