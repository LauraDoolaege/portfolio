---
import '../styles/global.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
}

// @font-face lives here, not in a CSS file: withBase() keeps the public/fonts URLs correct in dev and build.
const fontFaces = ['', 'Italic']
  .map(
    (v) =>
      `@font-face{font-family:'Switzer';src:url('${withBase(`/fonts/Switzer-Variable${v}.woff2`)}') format('woff2');font-weight:100 900;font-style:${v ? 'italic' : 'normal'};font-display:swap}`,
  )
  .join('');

const { title, description = "Laura's portfolio: digital development & design." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
