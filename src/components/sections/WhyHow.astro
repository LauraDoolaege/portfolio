---
// Section 1: two questions, two approaches. A massive black heading, then two light-weight
// questions in an offset (not boxed) two-column layout. Structure comes from whitespace, not lines.
const columns = [
  {
    question: 'How do we design an experience people actually need, love, and connect with?',
    approach: 'Devine (UX Major)',
    value:
      'Human-centered research, mapping user journeys, and prototyping interactions across physical and digital touchpoints.',
  },
  {
    question: 'How do we make sure people discover it and engage with it?',
    approach: 'Bachelor in Marketing Communication (Cum Laude)',
    value:
      'Content strategy, persuasion, nudging, and understanding human behavior to bridge user needs with business goals.',
  },
];
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="why-how" aria-labelledby="why-how-title">
  <div class="container">
    <SectionLabel num="01" text="Philosophy" />
    <h2 id="why-how-title" class="section-title why-how__title">
      2 Questions Every Product Needs to Answer
    </h2>

    <div class="why-how__grid">
      {columns.map((c) => (
        <article class="why-how__cell">
          <h3 class="why-how__question">{c.question}</h3>
          <p class="why-how__approach tag">{c.approach}</p>
          <p class="why-how__value">{c.value}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-how {
    padding-top: var(--space-section);
  }

  .why-how__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3.5rem, 2rem + 6vw, 7rem) var(--grid-gutter);
  }

  .why-how__cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .why-how__question {
    max-width: 20ch;
    font-size: clamp(1.75rem, 1rem + 2.4vw, 3.25rem);
    font-weight: var(--weight-light);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .why-how__value {
    max-width: 38ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.25rem);
    font-weight: var(--weight-light);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .why-how__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .why-how__cell:first-child {
      grid-column: 1 / span 5;
    }

    /* The second column sits lower and further right, so the pair reads as a staggered pair, not a table */
    .why-how__cell:last-child {
      grid-column: 7 / span 5;
      margin-top: clamp(4rem, 2rem + 8vw, 10rem);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.why-how');
  const title = section?.querySelector<HTMLElement>('.why-how__title');
  const cells = gsap.utils.toArray<HTMLElement>('.why-how__cell');

  if (section && title && !prefersReducedMotion()) {
    // Start states set in JS so no-JS visitors still see the content.
    gsap.set(title, { y: 24, opacity: 0 });
    gsap.set(cells, { y: 30, opacity: 0 });

    ScrollTrigger.create({
      trigger: section,
      start: 'top 75%',
      once: true,
      onEnter: () => {
        gsap
          .timeline({ defaults: { duration: 1, ease: 'power3.out', y: 0, opacity: 1 } })
          .to(title, {})
          .to(cells, { stagger: 0.18 }, '-=0.6');
      },
    });
  }
</script>
