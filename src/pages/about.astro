---
// About page, phases 1-2: hero, journey, team, inspiration and the data.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import AboutHero from '../components/sections/AboutHero.astro';
import AboutJourney from '../components/sections/AboutJourney.astro';
import AboutTeam from '../components/sections/AboutTeam.astro';
import AboutInspiration from '../components/sections/AboutInspiration.astro';
import AboutData from '../components/sections/AboutData.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="About | Laura Doolaege"
  description="Laura's portfolio: digital development & design."
>
  <div class="page">
    <Header />
    <main id="main">
      <AboutHero />
      <AboutJourney />
      <AboutTeam />
      <AboutInspiration />
      <AboutData />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>
