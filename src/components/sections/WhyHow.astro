---
// Section 01: two questions, two educations. On desktop the headline is pinned in the left columns while the two
// question blocks scroll past on the right; the block in the middle of the screen is the active one (the rest dim,
// and the matching segment in the pinned column darkens). A third step closes it ("...and I want to answer both!"),
// where every segment goes dark. Below 1000px it is a plain stack.
import SectionLabel from '../ui/SectionLabel.astro';

type Part = string | { word: string; tail?: string };

const columns: { parts: Part[]; approach: string; value: string }[] = [
  {
    parts: [
      'How do we ',
      {
        word: 'design',
      },
      ' an experience people actually ',
      {
        word: 'need',
        tail: '?',
      },
    ],
    approach: 'Devine (UX Major)',
    value:
      'Human-centered research, mapping user journeys, and prototyping interactions across physical and digital touchpoints.',
  },
  {
    parts: ['How do we make sure ', { word: 'people' }, ' ', { word: 'discover', tail: ' it?' }],
    approach: 'Bachelor in Marketing Communication (Cum Laude)',
    value:
      'Content strategy, persuasion, nudging, and understanding human behavior to bridge user needs with business goals.',
  },
];
---

<section class="sec why" aria-labelledby="why-how-title" data-why>
  <div class="container why__grid">
    <div class="why__pin">
      <SectionLabel num="01" text="The big idea" data-reveal />
      <h2 id="why-how-title" class="sec-title" data-reveal>
        Every company has 2 questions...
      </h2>
      <div class="why__bars" aria-hidden="true">
        {[...columns, null].map(() => (
          <span class="why__bar"></span>
        ))}
      </div>
      <!-- The closing line, set in the headline's own type and lined up with its last line by the script, so on the
           last step the two read as one quote. The list item below keeps the real text for assistive tech. -->
      <p class="why__merge" aria-hidden="true" data-why-merge>
        and I want to answer both!
      </p>
    </div>

    <ol class="why__list">
      {columns.map((c) => (
        <li class="why__item" data-why-item>
          <h3 class="why__question" data-reveal>
            {c.parts.map((part) =>
              typeof part === 'string' ? (
                part
              ) : (
                <span class="why__nw">
                  <mark class="hl">{part.word}</mark>
                  {part.tail}
                </span>
              ),
            )}
          </h3>
          <div class="why__answer" data-reveal>
            <p class="tag">{c.approach}</p>
            <p class="text">{c.value}</p>
          </div>
        </li>
      ))}
      <li class="why__item why__item--close" data-why-item>
        <p class="why__close" data-reveal>
          and I want to answer both!
        </p>
      </li>
    </ol>
    <!-- Phones: the answers swipe sideways. Counter, progress and previous/next sit under the track, so the row can
         also be driven with a thumb tap or the keyboard. -->
    <div class="why__controls" role="group" aria-label="Browse the answers">
      <button class="why__nav" type="button" data-why-prev aria-label="Previous">
        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M9 6H2.5M5.5 3L2.5 6l3 3"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </button>
      <p class="why__count" aria-live="polite" data-why-count>
        1 / {columns.length + 1}
      </p>
      <div class="why__bars why__bars--below" aria-hidden="true">
        {[...columns, null].map(() => (
          <span class="why__bar"></span>
        ))}
      </div>
      <button class="why__nav" type="button" data-why-next aria-label="Next">
        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M3 6h6.5M6.5 3l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .why__pin .sec-title {
    margin-bottom: 0;
  }

  .why__list {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4rem);
  }

  .why__item {
    padding-top: 1.75rem;
  }

  .why__question {
    position: relative;
    isolation: isolate;
    max-width: 16ch;
    font-size: clamp(2rem, 1rem + 2.8vw, 3.75rem);
    font-weight: var(--weight-bold);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .why__answer {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    max-width: 46ch;
  }

  /* Nowrap keeps the question mark with its word */
  .why__nw {
    white-space: nowrap;
  }

  .why__close {
    max-width: 12ch;
    font-size: clamp(2.5rem, 1rem + 4.2vw, 5.5rem);
    font-weight: var(--weight-heavy);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .why__bars {
    display: none;
  }

  .why__merge {
    display: none;
  }

  @media (min-width: 1000px) {
    .why__grid {
      position: relative;
      isolation: isolate;
    }

    .why__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    .why__pin {
      grid-column: 1 / 6;
      position: sticky;
      top: clamp(5rem, 14vh, 9rem);
      align-self: start;
    }

    .why__list {
      grid-column: 7 / 13;
      gap: 0;
      margin-top: 0;
    }

    /* Each block is most of a screen tall, so it takes real scrolling to move from one answer to the next */
    .why__item {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 85vh;
      padding-block: 3rem;
      transition: opacity 0.6s var(--ease-out);
    }

    .why__item--close {
      min-height: 70vh;
    }

    /* The list's own copy only holds the scroll distance (and the text for screen readers) */
    .why__grid.is-armed .why__item--close .why__close {
      /* !important: the scroll reveal writes an inline opacity onto it */
      opacity: 0 !important;
    }

    /* Same type as the headline, so the two are one voice. The script places it beside the headline's last line:
           --merge-left is the list's left edge, --merge-top the top of that line (both measured, never guessed). */
    .why__grid.is-armed .why__merge {
      position: absolute;
      left: var(--merge-left, 100%);
      top: var(--merge-top, 0);
      width: var(--merge-width, 30rem);
      display: block;
      margin: 0;
      font-size: clamp(2.5rem, 1.4rem + 4.2vw, 5.25rem);
      font-weight: var(--weight-heavy);
      letter-spacing: var(--tracking-display);
      line-height: 0.98;
      text-wrap: balance;
      pointer-events: none;
      opacity: 0;
      transform: translateX(2rem);
      filter: blur(6px);
      transition:
        opacity 0.9s var(--ease-out),
        transform 1.1s var(--ease-out),
        filter 0.9s var(--ease-out);
    }

    .why__grid.is-closing .why__merge {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .why__grid.is-armed .why__item {
      opacity: 0.3;
    }

    .why__grid.is-armed .why__item.is-active {
      opacity: 1;
    }

    /* The closing line stands alone: the answers above it are gone, not dimmed behind it */
    .why__grid.is-closing .why__item:not(.why__item--close) {
      opacity: 0;
    }

    /* Progress in the pinned column: one segment per answer, the active one in ink */
    .why__bars {
      display: flex;
      gap: 0.5rem;
      margin-top: clamp(2rem, 1.5rem + 3vw, 4rem);
    }

    .why__bar {
      width: 3.5rem;
      height: 2px;
      background: var(--border-color);
      transition: background-color 0.5s var(--ease-out);
    }

    .why__bar.is-active {
      background: var(--text-main);
    }
  }

  .why__controls,
  .why__bars--below {
    display: none;
  }

  /* Phones: the two questions (and the closing line) become swipeable cards in a native scroll-snap track:
     no scroll hijack, so the page itself always scrolls. The next card peeks in as the hint to swipe. */
  @media (max-width: 699px) {
    .why__list {
      display: flex;
      gap: 0.9rem;
      margin-top: clamp(1.5rem, 1rem + 3vw, 2.5rem);
      margin-inline: calc(var(--page-margin) * -1);
      padding: 1.5rem var(--page-margin);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-margin);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .why__list::-webkit-scrollbar {
      display: none;
    }

    .why__item {
      flex: 0 0 min(88%, 22rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.25rem;
      padding: 1.25rem;
      border: var(--hairline);
      border-radius: var(--radius);
      scroll-snap-align: start;
    }

    .why__item--close {
      justify-content: center;
    }

    .why__question {
      max-width: none;
      font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2rem);
    }

    .why__close {
      font-size: clamp(2rem, 1.5rem + 2vw, 2.5rem);
    }

    .why__answer {
      margin-top: 0;
    }

    .why__controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .why__bars--below {
      display: flex;
      flex: 1;
      gap: 0.5rem;
    }

    .why__count {
      min-width: 3ch;
      font-size: var(--text-small);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }

    .why__nav {
      display: grid;
      place-items: center;
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: var(--hairline);
      border-radius: var(--radius);
      background: transparent;
      color: var(--text-main);
      cursor: pointer;
      transition: background-color 0.3s var(--ease-out);
    }

    .why__nav:active {
      background: var(--tag-fill);
    }

    .why__nav:disabled {
      opacity: 0.35;
    }

    .why__nav svg {
      width: 1rem;
      height: 1rem;
    }

    .why__bar {
      width: 2.25rem;
      height: 2px;
      background: var(--border-color);
      transition: background-color 0.5s var(--ease-out);
    }

    .why__bar.is-active {
      background: var(--text-main);
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-why] .why__grid');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-why-item]'));
  const bars = Array.from(document.querySelectorAll<HTMLElement>('.why__bar'));
  const desktop = matchMedia('(min-width: 1000px)');
  const phone = matchMedia('(max-width: 699px)');

  if (grid && items.length) {
    // Armed by script, so no-JS visitors and narrow screens just see everything at full strength
    const activate = (index: number) => {
      items.forEach((el, i) => el.classList.toggle('is-active', i === index));
      // The closing line also comes in beside the headline; each step darkens only its own stripe
      grid.classList.toggle('is-closing', index === items.length - 1);
      bars.forEach((el, i) => el.classList.toggle('is-active', i % items.length === index));
    };

    // Phones: counter, progress and buttons follow the card the swipe has settled on
    const track = grid.querySelector<HTMLElement>('.why__list');
    const count = document.querySelector<HTMLElement>('[data-why-count]');
    const prev = document.querySelector<HTMLButtonElement>('[data-why-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-why-next]');
    if (track) {
      const stepOf = () =>
        items.length > 1
          ? items[1].getBoundingClientRect().left - items[0].getBoundingClientRect().left
          : items[0].offsetWidth;
      const current = () =>
        Math.min(items.length - 1, Math.max(0, Math.round(track.scrollLeft / stepOf())));
      const sync = () => {
        const i = current();
        activate(i);
        if (count) count.textContent = `${i + 1} / ${items.length}`;
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === items.length - 1;
      };
      const go = (i: number) =>
        track.scrollTo({
          left: Math.max(0, Math.min(items.length - 1, i)) * stepOf(),
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });

      let queued = false;
      track.addEventListener(
        'scroll',
        () => {
          if (queued || !phone.matches) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            sync();
          });
        },
        { passive: true },
      );
      prev?.addEventListener('click', () => go(current() - 1));
      next?.addEventListener('click', () => go(current() + 1));

      // Keyboard: the row is a focusable region while it is a swipe row
      const arm = () => {
        if (phone.matches) {
          track.tabIndex = 0;
          track.setAttribute('aria-label', 'The two questions, swipe or use the arrow keys');
          sync();
        } else {
          track.removeAttribute('tabindex');
          track.removeAttribute('aria-label');
        }
      };
      track.addEventListener('keydown', (e) => {
        if (!phone.matches) return;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(current() + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(current() - 1);
        }
      });
      phone.addEventListener('change', arm);
      arm();

      // One nudge the first time the row is on screen: it slides a little and returns, so the swipe is no secret
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const nudgeIo = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting || !phone.matches) return;
            nudgeIo.disconnect();
            let stop = false;
            const halt = () => (stop = true);
            track.addEventListener('touchstart', halt, { once: true, passive: true });
            track.style.scrollSnapType = 'none';
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / 1100);
              if (stop || t >= 1) {
                track.style.scrollSnapType = '';
                return;
              }
              track.scrollLeft = 44 * Math.sin(Math.PI * t) ** 2;
              requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          },
          { threshold: 0.7 },
        );
        nudgeIo.observe(track);
      }
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          // On phones the active card follows the sideways swipe (below), not the vertical position
          if (!phone.matches) activate(items.indexOf(entry.target as HTMLElement));
        }
      },
      // A thin band across the middle of the screen: whichever block crosses it is the active one
      { rootMargin: '-45% 0px -45% 0px' },
    );

    // The closing line sits where the headline's last line ends: same top, and at the list's left edge. Measured from
    // layout (offsets ignore the reveal transforms), re-measured on resize and once the fonts have loaded.
    const merge = grid.querySelector<HTMLElement>('[data-why-merge]');
    const title = grid.querySelector<HTMLElement>('.why__pin .sec-title');
    const list = grid.querySelector<HTMLElement>('.why__list');
    const pin = grid.querySelector<HTMLElement>('.why__pin');
    const place = () => {
      if (!merge || !title || !list || !pin || !desktop.matches) return;
      const lh = parseFloat(getComputedStyle(title).lineHeight);
      const lines = Math.max(1, Math.round(title.offsetHeight / lh));
      merge.style.setProperty('--merge-top', `${title.offsetTop + (lines - 1) * lh}px`);
      merge.style.setProperty('--merge-left', `${list.offsetLeft - pin.offsetLeft}px`);
      merge.style.setProperty('--merge-width', `${list.offsetWidth}px`);
    };

    const arm = () => {
      grid.classList.toggle('is-armed', desktop.matches);
      place();
    };
    new ResizeObserver(place).observe(grid);
    document.fonts?.ready.then(place);
    arm();
    desktop.addEventListener('change', arm);
    activate(0);
    items.forEach((el) => io.observe(el));
  }
</script>
