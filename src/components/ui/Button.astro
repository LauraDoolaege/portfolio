---
// Button system (supersedes the original PROJECT_BRIEF.md Section 3 "solid
// ink pill for primary actions" rule — see CLAUDE.md "Tech stack" for the
// documented revision). Two roles:
// - primary: hairline-bordered ink/charcoal box, fill sweeps in on
//   hover/focus. No bracket glyphs — the box itself is the affordance.
// - secondary: unchanged — a quiet underline text link.
//
// Hover/press transitions use `--motion-easing-soft` (global.css), not
// the plain ease-out `--motion-easing` this used before - per direct
// feedback that ProjectCard's own hover motion read as "very harsh,"
// with the same fix asked for on "the buttons on the page" too. Applies
// to both variants (the base `.btn` rule owns the color transition both
// share) plus the primary fill-sweep and its new press transform.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  icon?: 'download' | 'arrow';
  class?: string;
}

const { href, variant = 'primary', icon, class: className } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]}>
  <span class="btn__label">
    <slot />
  </span>
  {icon === 'download' && (
    <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M8 2.5V10M8 10L4.75 6.75M8 10L11.25 6.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M3 13H13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'arrow' && (
    <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M3 8H13M13 8L9.25 4.25M13 8L9.25 11.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )}
</a>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  // GSAP-driven icon nudge, not a CSS transition — a quick spring-out on
  // the way in and a plain ease back on the way out reads as a tactile
  // nudge rather than the icon just sliding a fixed distance at a fixed
  // rate. Queried once for every .btn on the page (this script runs once
  // per page load regardless of how many Button instances are rendered).
  const reduceMotion = prefersReducedMotion();
  const duration = reduceMotion ? 0 : 0.5;

  document.querySelectorAll<HTMLElement>('.btn').forEach((btn) => {
    const icon = btn.querySelector<HTMLElement>('.btn__icon');
    if (!icon) return;

    const nudgeIn = () => gsap.to(icon, { x: '0.25em', duration, ease: 'back.out(2)' });
    const nudgeOut = () => gsap.to(icon, { x: 0, duration, ease: 'power3.out' });

    btn.addEventListener('mouseenter', nudgeIn);
    btn.addEventListener('mouseleave', nudgeOut);
    btn.addEventListener('focus', nudgeIn);
    btn.addEventListener('blur', nudgeOut);
  });
</script>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 500;
    /* --motion-easing-soft, not the plain ease-out --motion-easing -
                                                                                     same "tactile glide, not a mechanical ease-out" fix applied to
                                                                                     ProjectCard's hover motion, per direct feedback to bring it to
                                                                                     the buttons too. */
    transition: color var(--motion-duration) var(--motion-easing-soft);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Primary: hairline ink box, fill sweeps in on hover. */
  .btn--primary {
    position: relative;
    z-index: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    border: var(--border-hairline) solid var(--color-ink);
    border-radius: 0;
    padding: 0.75em 1.1em;
    transition: transform var(--motion-duration) var(--motion-easing-soft);
  }

  .btn--primary > * {
    position: relative;
    z-index: 1;
  }

  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-duration-slow) var(--motion-easing-soft);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    color: var(--color-bg-primary);
  }

  .btn--primary:hover::before,
  .btn--primary:focus-visible::before {
    transform: scaleX(1);
  }

  .btn--primary:active {
    transform: scale(0.98);
  }

  /* No transition here — the nudge on hover/focus is GSAP-driven (see
     the script above), not a CSS transition. */
  .btn__icon {
    width: 0.9em;
    height: 0.9em;
  }

  /* Secondary: quiet underline text link — unchanged. */
  .btn--secondary {
    padding-block: 0.2em;
    font-family: var(--font-body);
    font-size: var(--text-nav);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border-bottom: var(--border-hairline) solid currentColor;
    color: var(--color-ink);
  }

  .btn--secondary:hover {
    color: var(--color-accent);
  }
</style>
