---
// One project in the homepage work grid. With a cover it is a card: title and type on one line, the image at the
// group's fixed ratio, a hairline, a few lines about the project with an arrow, then its tools as chips.
// Without a cover it is a plain ruled text row. Both link to the case study.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/url';

interface Props {
  project: CollectionEntry<'works'>;
  /** Image sizes hint for the grid this card sits in */
  sizes: string;
}

const { project: p, sizes } = Astro.props;
const TYPE_LABEL = { ux: 'UX Strategy', visual: 'Visual Exploration' } as const;
const cover = p.data.coverImage;
const href = withBase(`/works/${p.id}`);
const tools = p.data.tools.slice(0, 3);
---

{cover ? (
  <li class="card" data-reveal>
    <a class="card__link" href={href}>
      <header class="card__top">
        <h4 class="card__title">{p.data.title}</h4>
        <p class="card__type">{TYPE_LABEL[p.data.type]}</p>
      </header>
      <div class="card__media">
        <Image
          class="card__img"
          src={cover}
          alt={`${p.data.title}: cover`}
          widths={[400, 700, 1000, 1400]}
          sizes={sizes}
        />
      </div>
      <div class="card__body">
        <p class="card__desc">{p.data.description}</p>
        <svg class="card__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M3 9L9 3M4 3h5v5" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" />
        </svg>
      </div>
      <ul class="card__tags" aria-label="Tools">
        {tools.map((t) => (
          <li class="card__chip">{t}</li>
        ))}
      </ul>
    </a>
  </li>
) : (
  <li class="entry" data-reveal>
    <a class="entry__link" href={href}>
      <h4 class="entry__title">{p.data.title}</h4>
      <p class="tag">{p.data.tools.slice(0, 2).join(' · ')}</p>
    </a>
  </li>
)}

<style>
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .card__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
  }

  .card__type {
    flex: none;
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  /* Every cover in a group is cropped to the same ratio (--ratio, set by the grid), so edges and baselines line up.
     Soft mask, spotlight and grain come from .card__media in global.css; the pan (x/y) and resting scale are GSAP's. */
  .card__media {
    aspect-ratio: var(--ratio, 4 / 3);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .card__body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: var(--hairline);
  }

  .card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 52ch;
    font-size: var(--text-body);
    font-weight: var(--weight-light);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .card__arrow {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    transition: transform 0.4s ease-in-out;
  }

  .card__link:hover .card__arrow,
  .card__link:focus-visible .card__arrow {
    transform: translate(3px, -3px);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .card__chip {
    padding: 0.4em 0.8em;
    border: var(--hairline);
    font-size: var(--text-small);
    line-height: 1.2;
    color: var(--text-muted);
  }

  /* Text-only entry: spans the whole grid as a row, like the rows elsewhere on the page */
  .entry {
    grid-column: 1 / -1;
    border-top: var(--hairline);
  }

  .entry__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .entry__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    transition: opacity 0.4s var(--ease-out);
  }

  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    opacity: 0.6;
  }
</style>
