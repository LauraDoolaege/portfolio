---
// The Journey: asymmetric typographic blocks. Each opens with a large pull line (heavy weight),
// then a smaller, dense paragraph offset to the side. No rules, no boxes: spacing and offsets do the work.
const blocks = [
  {
    label: 'The Foundation',
    pull: "Before I ever mapped a user journey or opened Figma, I earned a Bachelor's in Marketing Communication (Cum Laude).",
    copy: "During my internship at CAW Oost-Vlaanderen, I planned content, wrote nationwide policy letters, and independently led a workshop to restructure their website's content. Looking back, facilitating that workshop was my first UX project—I just didn't know it yet!",
  },
  {
    label: 'The Storyteller',
    pull: 'But honestly, it started way earlier. On the playground, I invented storylines where everyone got a part.',
    copy: "At home, I wrote stories starring my sister's favourite Nintendo characters to get her excited about reading. (It worked—she now reads more books than I do).",
  },
  {
    label: 'The Experience Designer',
    pull: "Now I'm in my third year of Digital Design and Development (Devine), majoring in UX design.",
    copy: 'I have the same love for stories, just with more tools. Devine has taught me how to research and design experiences a user actually needs. My marketing skills help me position those experiences so they actually reach people.',
  },
];
---

<section class="journey" aria-label="The journey">
  <div class="container">
    <ol class="journey__list">
      {blocks.map((b) => (
        <li class="journey__block grid">
          <h2 class="journey__label" data-reveal>
            {b.label}
          </h2>
          <p class="journey__pull" data-reveal>
            {b.pull}
          </p>
          <p class="journey__copy" data-reveal>
            {b.copy}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .journey {
    padding-bottom: var(--space-section);
  }

  .journey__list {
    display: grid;
    gap: clamp(5rem, 3rem + 9vw, 12rem);
  }

  .journey__block {
    row-gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }

  .journey__label,
  .journey__pull,
  .journey__copy {
    grid-column: 1 / -1;
  }

  .journey__label {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .journey__pull {
    max-width: 19em;
    font-size: clamp(1.75rem, 1rem + 3.4vw, 4.5rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    text-wrap: balance;
  }

  .journey__copy {
    max-width: 38ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.25rem);
    font-weight: var(--weight-light);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Alternate the offsets: pull and paragraph swing left and right so the blocks never repeat */
  @media (min-width: 900px) {
    .journey__block:nth-child(odd) .journey__pull {
      grid-column: 1 / span 10;
    }

    .journey__block:nth-child(odd) .journey__copy {
      grid-column: 7 / span 5;
    }

    .journey__block:nth-child(even) .journey__pull {
      grid-column: 3 / span 10;
    }

    .journey__block:nth-child(even) .journey__copy {
      grid-column: 3 / span 4;
    }

    .journey__block:nth-child(even) .journey__label {
      grid-column: 3 / -1;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const items = gsap.utils.toArray<HTMLElement>('.journey [data-reveal]');

  if (items.length && !prefersReducedMotion()) {
    gsap.set(items, { y: 28, opacity: 0 });

    ScrollTrigger.batch(items, {
      start: 'top 88%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', stagger: 0.12 }),
    });
  }
</script>
