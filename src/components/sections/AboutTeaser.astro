---
// Section 04: who am I. The same row again: the statement on the left, the way into the About page in the rail.
// Hero's "Get to know me" link jumps here (#about).
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { withBase } from '../../utils/url';
---

<section class="sec" id="about" aria-labelledby="about-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel num="04" text="Who am I" data-reveal />
      <h2 id="about-title" class="sec-title" data-reveal>
        Who am I
      </h2>
    </header>

    <div class="row" data-reveal>
      <p class="lede about__statement">
        A marketer turned experience designer. A storyteller since the playground. I bridge human
        needs with smart strategy to create concepts that actually reach people.
      </p>
      <div class="row__rail">
        <Button variant="link" href={withBase('/about')}>
          Get to know me better
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* A paragraph, not a question: a touch smaller and wider than the shared lede */
  .about__statement {
    max-width: 32ch;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.5rem);
  }
</style>
