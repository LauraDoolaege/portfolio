---
// The hero video of a motion project: a large, responsive 16:9 frame that spans the page.
// Give it one of:
//   embed="https://player.vimeo.com/video/123456789"   (Vimeo / YouTube embed URL)
//   src="/portfolio/videos/izumi.mp4"                  (a self-hosted file; plays with controls)
// With neither it renders a clearly labelled placeholder, so the layout can be reviewed before the
// video exists. `poster` is the still shown before play (and under the placeholder).
import { Image } from 'astro:assets';

interface Props {
  title: string;
  embed?: string;
  src?: string;
  poster?: ImageMetadata;
  /** CSS aspect-ratio of the frame, default 16 / 9 (use "4 / 3" for a 4:3 film) */
  ratio?: string;
}

const { title, embed, src, poster, ratio = '16 / 9' } = Astro.props;
---

<figure class="theater">
  <div class="theater__frame" style={`aspect-ratio:${ratio}`}>
    {embed ? (
      <>
        <!-- Facade: the poster and a play button; the player (and Vimeo's scripts) load only on tap -->
        <button
          class="theater__facade"
          type="button"
          data-embed={embed}
          data-title={title}
          aria-label={`Play ${title}`}
        >
          {poster && (
            <Image
              class="theater__poster theater__poster--facade"
              src={poster}
              alt=""
              widths={[800, 1400, 2000]}
              sizes="100vw"
            />
          )}
          <span class="theater__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.5v13l11-6.5z"></path>
            </svg>
          </span>
        </button>
        <noscript>
          <iframe class="theater__media" src={embed} title={title} allowfullscreen></iframe>
        </noscript>
      </>
    ) : src ? (
      <video
        class="theater__media"
        src={src}
        poster={poster?.src}
        controls
        playsinline
        preload="metadata"
      />
    ) : (
      <div class="theater__placeholder" role="img" aria-label={`${title}: video placeholder`}>
        {poster && (
          <Image
            class="theater__poster"
            src={poster}
            alt=""
            widths={[800, 1400, 2000]}
            sizes="100vw"
          />
        )}
        <span class="theater__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.5v13l11-6.5z"></path>
          </svg>
        </span>
        <figcaption class="theater__label tag">
          Hero video: add a Vimeo / YouTube link or an MP4
        </figcaption>
      </div>
    )}
  </div>
</figure>

<style>
  .theater {
    margin: 0;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0;
  }

  /* Dark stage in both themes: the film sits on black, not on the page colour */
  .theater__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: #0e0d0c;
  }

  /* :global because the click script creates the iframe, and scoped styles don't reach elements made at runtime */
  .theater__frame :global(.theater__media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
  }

  .theater__placeholder {
    position: absolute;
    inset: 0;
  }

  .theater__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .theater__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #f3f2ee;
  }

  /* The ring scales with --size; the glyph's padding is a share of it, so the triangle stays centred and
     readable from phone to desktop (fixed padding left almost no room for it on small screens) */
  .theater__play svg {
    --size: clamp(3.25rem, 2.25rem + 4vw, 5.5rem);
    box-sizing: border-box;
    width: var(--size);
    height: var(--size);
    padding: calc(var(--size) * 0.27) calc(var(--size) * 0.23) calc(var(--size) * 0.27) calc(var(--size) * 0.31);
    border: 1px solid rgba(243, 242, 238, 0.7);
    border-radius: 50%;
    /* A dark disc behind the ring, so the button reads on any poster */
    background: rgba(14, 13, 12, 0.7);
  }

  .theater__facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .theater__poster--facade {
    opacity: 0.85;
  }

  .theater__label {
    position: absolute;
    left: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    bottom: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    color: rgba(243, 242, 238, 0.8);
  }
</style>

<script>
  // Swap each facade for the real player the moment it is tapped
  document.querySelectorAll<HTMLButtonElement>('.theater__facade').forEach((facade) => {
    facade.addEventListener('click', () => {
      const url = facade.dataset.embed;
      if (!url) return;
      const frame = document.createElement('iframe');
      frame.className = 'theater__media';
      frame.src = url + (url.includes('?') ? '&' : '?') + 'autoplay=1';
      frame.title = facade.dataset.title ?? '';
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.allowFullscreen = true;
      facade.replaceWith(frame);
      frame.focus();
    });
  });
</script>
