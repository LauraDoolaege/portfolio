---
// Section 01: two questions, two answers. Each question is a row: the question on the left, where it
// comes from (the degree) and what it covers in the narrow rail, the same split as the hero.
import SectionLabel from '../ui/SectionLabel.astro';

const columns = [
  {
    question: 'How do we design an experience people actually need, love, and connect with?',
    approach: 'Devine (UX Major)',
    value:
      'Human-centered research, mapping user journeys, and prototyping interactions across physical and digital touchpoints.',
  },
  {
    question: 'How do we make sure people discover it and engage with it?',
    approach: 'Bachelor in Marketing Communication (Cum Laude)',
    value:
      'Content strategy, persuasion, nudging, and understanding human behavior to bridge user needs with business goals.',
  },
];
---

<section class="sec" aria-labelledby="why-how-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel num="01" text="Philosophy" data-reveal />
      <h2 id="why-how-title" class="sec-title" data-reveal>
        2 questions every product needs to answer
      </h2>
    </header>

    <ol>
      {columns.map((c) => (
        <li class="row" data-reveal>
          <h3 class="lede">{c.question}</h3>
          <div class="row__rail">
            <p class="tag">{c.approach}</p>
            <p class="text">{c.value}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
