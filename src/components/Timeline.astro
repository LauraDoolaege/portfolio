---
// A vertical timeline for a sequence of steps (the initiator's journey). A fine line runs down the
// side and fills in as you scroll; each step's dot lights up when the line reaches it.
// Use with <TimelineStep title="...">text</TimelineStep> children. Without JS or with reduced
// motion the line is drawn in full.
---

<ol class="timeline" data-timeline>
  <span class="timeline__track" aria-hidden="true">
    <span class="timeline__fill"></span>
  </span>
  <slot />
</ol>

<script>
  import { onScrollFrame } from '../utils/scroll';

  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((tl) => {
    const fill = tl.querySelector<HTMLElement>('.timeline__fill')!;
    const steps = Array.from(tl.querySelectorAll<HTMLElement>('.tl-step'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    onScrollFrame(() => {
      // Read everything first, then write, so each frame costs one layout
      const rect = tl.getBoundingClientRect();
      // The line reaches as far down as the reading line (60% down the viewport) has travelled
      const reach = reduce
        ? rect.height
        : Math.min(Math.max(window.innerHeight * 0.6 - rect.top, 0), rect.height);
      const reached = steps.map((s) => reduce || s.offsetTop <= reach);
      fill.style.transform = `scaleY(${rect.height ? reach / rect.height : 0})`;
      steps.forEach((s, i) => s.classList.toggle('is-reached', reached[i]));
    });
  });
</script>

<style is:global>
  .timeline {
    --dot: 0.75rem;
    position: relative;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  /* The fine line, down the left edge, centred on the dots */
  .timeline__track {
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: calc(var(--dot) / 2);
    width: 1px;
    background: var(--border-color);
  }

  .timeline__fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
  }

  .tl-step {
    position: relative;
    padding: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem) calc(var(--dot) + 1.5rem);
  }

  .tl-step:last-child {
    padding-bottom: 0;
  }

  .tl-step::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: var(--bg-primary);
    transition:
      background 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }

  .tl-step.is-reached::before {
    border-color: var(--accent);
    background: var(--accent);
  }

  /* Methods / result lines: a small muted key, then the text */
  .timeline .tl-step .tl-step__line {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0 1rem;
    font-size: var(--text-paragraph);
    line-height: var(--leading-paragraph);
  }

  .timeline .tl-step .tl-step__line + .tl-step__line {
    margin-top: 0.6rem;
  }

  .tl-step__key {
    padding-top: 0.2em;
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 599px) {
    .timeline .tl-step .tl-step__line {
      display: block;
    }

    .tl-step__key {
      display: block;
      padding-top: 0;
    }
  }

  .timeline .tl-step .tl-step__title {
    margin: 0 0 0.5rem;
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
    text-transform: none;
    color: var(--text-main);
  }
</style>
