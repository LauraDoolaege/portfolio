---
// Where inspiration strikes: pure typography. A huge black list, then the closing line in light weight, offset right.
const list =
  'Movies. Comedy series. Long drives. Walks with my dog. Losing at pool. Scanning groceries.';
const closing = 'And anywhere I can just sit on a bench and observe people.';
---

<section class="inspo" aria-labelledby="inspo-label">
  <div class="container">
    <h2 id="inspo-label" class="inspo__label" data-reveal>
      Where inspiration strikes
    </h2>
    <p class="inspo__list" data-reveal>
      {list}
    </p>
    <p class="inspo__closing" data-reveal>
      {closing}
    </p>
  </div>
</section>

<style>
  .inspo {
    padding-bottom: var(--space-section);
  }

  .inspo__label {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .inspo__list {
    max-width: 14em;
    font-size: clamp(2.5rem, 1rem + 7vw, 8.5rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 0.98;
    text-wrap: balance;
  }

  .inspo__closing {
    max-width: 22ch;
    margin-top: clamp(2rem, 1rem + 4vw, 6rem);
    font-size: clamp(1.375rem, 1rem + 1.8vw, 2.5rem);
    font-weight: var(--weight-light);
    line-height: 1.3;
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .inspo__closing {
      margin-left: calc(6 / 12 * 100%);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const items = gsap.utils.toArray<HTMLElement>('.inspo [data-reveal]');

  if (items.length && !prefersReducedMotion()) {
    gsap.set(items, { y: 28, opacity: 0 });
    ScrollTrigger.batch(items, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', stagger: 0.14 }),
    });
  }
</script>
