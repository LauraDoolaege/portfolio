---
// The journey: a small portrait on the left, the story on the right. Same section header as the homepage
// (label + title), same photo treatment as the homepage teaser (whole portrait, black and white).
import { Image } from 'astro:assets';
import SectionLabel from '../ui/SectionLabel.astro';
import photo from '../../assets/images/photo_aboutTeaser.png';

const paragraphs = [
  "As a kid, I couldn't play without a plot. On the playground I invented royal storylines where everyone got a part, and at home I wrote a crossover where Kirby falls in love with Barbie, to get my little sister excited about reading. It worked: she now reads more than I do.",
  "That love of stories led me to Marketing Communication, where consumer psychology was my favourite subject. At my internship I was asked to design social media posts and banners, and design got hold of me. My thesis, on why colleagues weren't contributing to their internal newsletter, was my first UX project, avant la lettre.",
  "So when I found out that Devine taught UX, I knew where I wanted to be. I used to write about experiences. Now I'm learning to build them.",
];
---

<section class="sec" aria-labelledby="story-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel text="The journey" data-reveal />
      <h2 id="story-title" class="sec-title" data-reveal>
        From{' '}
        <span class="story__word">
          <mark class="hl">stories</mark>
        </span>{' '}
        to experiences
      </h2>
    </header>

    <div class="story__grid">
      <figure class="story__figure media-frame" data-no-pan data-reveal>
        <Image
          class="media-frame__img story__photo"
          src={photo}
          alt="Portrait of Laura Doolaege looking at the camera"
          widths={[240, 480, 720]}
          sizes="(min-width: 1000px) 22rem, 14rem"
        />
      </figure>

      <div class="story__text">
        <p class="text" data-reveal>
          {paragraphs[0]}
        </p>
        <div
          class="story__more"
          data-reveal
          data-fold
          data-fold-more="Read more"
          data-fold-less="Show less"
        >
          {paragraphs.slice(1).map((p) => (
            <p class="text">{p}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem var(--grid-gutter);
  }

  /* Small on phones so the first paragraph shows without scrolling, larger beside the text on desktop */
  .story__figure {
    width: min(100%, 10rem);
  }

  /* The one hand-made moment on this page: a terracotta double underline under "stories", drawn in once */
  .story__word {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .story__figure :global(.story__photo) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.05);
  }

  .story__text {
    display: grid;
    gap: 1.1em;
    align-content: start;
  }

  .story__text .text {
    max-width: 52ch;
  }

  /* The rest of the story: folded behind "Read more" on phones (see the inline script in about.astro) */
  .story__more {
    display: grid;
    gap: 1.1em;
  }

  /* Tablet and up: portrait and text side by side on the 12 columns (portrait in 4, text in 5-12), wider
     portrait once the contents list takes the left rail */
  @media (min-width: 700px) {
    .story__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .story__figure {
      grid-column: 1 / span 4;
      width: 100%;
    }

    .story__text {
      grid-column: 5 / span 8;
    }
  }

  @media (min-width: 1000px) {
    .story__figure {
      grid-column: 1 / span 5;
    }

    .story__text {
      grid-column: 7 / span 6;
    }
  }

  /* Phones: the marks are drawn small, so the pen is lighter */
</style>
