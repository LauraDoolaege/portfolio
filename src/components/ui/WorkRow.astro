---
// One project in the homepage list (the lighter tier, for visual work). At rest: a small thumbnail,
// a number and the title, between hairlines. On hover or keyboard focus the row opens: the thumbnail
// grows and the discipline, year and a "View project" link appear under the title. Where there is no
// hover (touch, narrow screens) the details are simply always shown. Links to the case study.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/url';

interface Props {
  project: CollectionEntry<'works'>;
  /** 1-based position in the list, shown as 01, 02... */
  index: number;
}

const { project: p, index } = Astro.props;
const cover = p.data.coverImage;
const href = withBase(`/works/${p.id}`);
const num = String(index).padStart(2, '0');
const details = p.data.discipline ?? p.data.role;
---

<li class="wrow-item" data-reveal>
  <a class="wrow" href={href}>
    <div class="wrow__thumb" aria-hidden="true">
      {cover ? (
        <Image
          class="wrow__img"
          src={cover}
          alt=""
          widths={[200, 400, 700]}
          sizes="(max-width: 699px) 62vw, 160px"
        />
      ) : (
        <div class="wrow__img wrow__img--empty"></div>
      )}
    </div>
    <h4 class="wrow__title">
      {p.data.title}
      <span class="wrow__num">{num}</span>
    </h4>
    <div class="wrow__more">
      <div class="wrow__more-inner">
        <p class="wrow__details">
          {details}
          <span class="wrow__year">{p.data.timeline}</span>
        </p>
        <span class="wrow__view">
          <span class="wrow__view-label">View project</span>
          <svg class="wrow__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path
              d="M3 9L9 3M4 3h5v5"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="square"
            />
          </svg>
        </span>
      </div>
    </div>
  </a>
</li>

<style>
  .wrow-item {
    border-top: var(--hairline);
  }

  .wrow-item:last-child {
    border-bottom: var(--hairline);
  }

  .wrow {
    --thumb-rest: 4rem;
    --thumb-open: 4rem;
    display: grid;
    grid-template-columns: var(--thumb-open) minmax(0, 1fr);
    grid-template-areas:
      'thumb title'
      'thumb more';
    column-gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    align-items: start;
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .wrow__thumb {
    grid-area: thumb;
    width: var(--thumb-rest);
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--frame-bg);
  }

  .wrow__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wrow__img--empty {
    background: var(--frame-bg);
  }

  /* Number: fine and quiet, set just after the title like a footnote mark */
  .wrow__num {
    margin-left: 0.7rem;
    font-size: var(--text-small);
    font-weight: var(--weight-light);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    vertical-align: top;
    color: var(--text-muted);
  }

  .wrow__title {
    grid-area: title;
    font-size: var(--title-size, clamp(1.75rem, 1.1rem + 2.8vw, 4.75rem));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    text-wrap: balance;
  }

  .wrow__more {
    grid-area: more;
    align-self: start;
    display: grid;
    grid-template-rows: 1fr;
  }

  .wrow__more-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: 0;
    overflow: hidden;
    padding-top: 0.6rem;
  }

  .wrow__details {
    font-size: var(--text-body);
    font-weight: var(--weight-light);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .wrow__year {
    margin-left: 0.9em;
    font-variant-numeric: tabular-nums;
  }

  /* Underlined label, then the site's standard up-right arrow. Flush right. */
  .wrow__view {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    line-height: 1.4;
  }

  .wrow__view-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .wrow__arrow {
    width: 0.85em;
    height: 0.85em;
    align-self: center;
    transition: transform 0.5s var(--ease-out);
  }

  /* Desktop with hover: no thumbnail at rest (it was too small to say anything); the title carries the row, and a
     larger preview follows the pointer while it is over the row (see the script below). The details open on hover. */
  @media (hover: hover) and (pointer: fine) and (min-width: 700px) {
    .wrow {
      --title-size: clamp(1.75rem, 1.1rem + 2.8vw, 4.75rem);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      grid-template-areas:
        'title'
        'more';
    }

    .wrow__thumb {
      display: none;
    }

    .wrow__more {
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.7s var(--ease-out);
    }

    .wrow__more-inner {
      opacity: 0;
      transition: opacity 0.4s var(--ease-out);
    }

    .wrow:hover .wrow__more,
    .wrow:focus-visible .wrow__more {
      grid-template-rows: 1fr;
    }

    .wrow:hover .wrow__more-inner,
    .wrow:focus-visible .wrow__more-inner {
      opacity: 1;
      transition-delay: 0.15s;
    }

    .wrow:hover .wrow__arrow,
    .wrow:focus-visible .wrow__arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wrow__more,
    .wrow__more-inner,
    .wrow__arrow {
      transition: none;
    }
  }

  /* Phones: the list at rest, as on desktop before the hover (thumbnail, title, number between hairlines). With no hover
     to open a row, the details stay out; the whole row is the link. */
  @media (max-width: 699px) {
    .wrow {
      align-items: center;
      grid-template-areas: 'thumb title';
    }

    .wrow__more {
      display: none;
    }

    .wrow__thumb {
      border-radius: var(--radius-sm);
    }
  }
</style>

<script>
  // The floating preview for the visual-work list: one image that follows the pointer while it is over a row.
  // Desktop with hover only; elsewhere the row keeps its small thumbnail.
  import { gsap } from 'gsap';

  const desktop = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 700px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rows = document.querySelectorAll<HTMLAnchorElement>('.wrow');

  if (rows.length && desktop.matches) {
    const box = document.createElement('div');
    box.className = 'row-preview';
    box.setAttribute('aria-hidden', 'true');
    const img = document.createElement('img');
    img.alt = '';
    box.appendChild(img);
    document.body.appendChild(box);

    gsap.set(box, { xPercent: 0, yPercent: -50, opacity: 0, scale: 0.94 });
    const moveX = gsap.quickTo(box, 'x', { duration: 0.55, ease: 'power3.out' });
    const moveY = gsap.quickTo(box, 'y', { duration: 0.55, ease: 'power3.out' });

    // The widest candidate of the row's own thumbnail, so the larger preview stays sharp
    const biggest = (el: HTMLImageElement) => {
      const set = el.getAttribute('srcset');
      if (!set) return el.currentSrc || el.src;
      const parts = set.split(',').map((p) => p.trim().split(/\s+/));
      return parts[parts.length - 1][0];
    };

    let showing = false;
    const place = (e: PointerEvent) => {
      const w = box.offsetWidth;
      const h = box.offsetHeight;
      // To the right of the pointer, flipped to the left near the edge, and never off the top or bottom
      const x = e.clientX + 32 + w > window.innerWidth ? e.clientX - 32 - w : e.clientX + 32;
      const y = Math.min(Math.max(e.clientY, h / 2 + 12), window.innerHeight - h / 2 - 12);
      moveX(x);
      moveY(y);
      return { x, y };
    };

    rows.forEach((row) => {
      const thumb = row.querySelector<HTMLImageElement>('.wrow__img');
      if (!thumb || !(thumb instanceof HTMLImageElement)) return;
      row.addEventListener('pointerenter', (e) => {
        img.src = biggest(thumb);
        const p = place(e);
        if (!showing) {
          gsap.set(box, { x: p.x, y: p.y });
          showing = true;
        }
        gsap.to(box, { opacity: 1, scale: 1, duration: reduce ? 0 : 0.45, ease: 'power3.out', overwrite: 'auto' });
      });
      row.addEventListener('pointermove', place);
      row.addEventListener('pointerleave', () => {
        showing = false;
        gsap.to(box, { opacity: 0, scale: 0.94, duration: reduce ? 0 : 0.3, ease: 'power2.out', overwrite: 'auto' });
      });
    });
  }
</script>

<style is:global>
  .row-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: clamp(15rem, 22vw, 24rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--frame-bg);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .row-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
