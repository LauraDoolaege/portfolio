---
// Homepage "Gallery of older works / process screenshots" (PROJECT_BRIEF.md
// Section 4, item 3). No real images exist yet (Section 6) - flat gray
// placeholders. Each tile now also carries a small category tag and a
// one-line caption below the image, per direct request ("like in the
// example add a tag below the image and space for a few words on what it
// is about") - a reference image showed each photo followed by a
// bracket-style medium/year tag and a short line of copy. No real project
// facts exist for this section yet, so both are clearly-labeled
// placeholders (CLAUDE.md "Content"): the tag rotates through three
// generic documentary/process categories rather than inventing specific
// client names, and the caption is a literal placeholder sentence with a
// TODO marking where real copy goes - not fabricated flavor text.
//
// Interaction model, fourth pass - back to continuous auto-scroll, not a
// page-scroll-driven pin: direct request ("I want the images to auto
// scroll... stop the auto scroll while hovering an image"). This
// replaces the third pass's pinned scroll-linked reveal (see AGENTS.md
// for that pass's own history, and the second pass before it, an
// earlier independent auto-scrolling/draggable marquee this is closer
// to than the pin ever was - just without the drag gesture, which wasn't
// asked for this time).
//
// A GSAP xPercent loop, not a scrollLeft-driven one: the track renders
// the tile list twice (real set + a decorative clone set, width:
// max-content over both), and a single tween moves it from xPercent: 0
// to xPercent: -50 on repeat - since both halves are pixel-identical,
// the loop point is invisible with no manual wrap-detection needed. This
// sidesteps the earlier scrollLeft-based marquee's own documented bug
// (the browser silently rounds/drops sub-pixel scrollLeft writes at slow
// speeds) entirely, since a CSS transform doesn't get rounded the same
// way. Only the real (first) set of triggers is keyboard/screen-reader
// reachable and wired to the hover effects below; the clone set is
// aria-hidden, untabbable, and pointer-events: none - present purely for
// the loop illusion, same "only the real set is interactive" principle
// the old 3x-duplicated version already established, just 2x now (a
// one-directional transform loop doesn't need a third copy the way the
// old bidirectional-drag scrollLeft version did).
//
// Pausing on hover happens at the viewport level (entering the strip
// anywhere pauses the tween, leaving it resumes), not per-tile - simpler
// than per-tile pause/resume, and it means a tile never drifts out from
// under a stationary cursor while its hover effects are active (the
// exact bug the pin-era version needed a synthetic-pointerleave hack to
// work around - see AGENTS.md - which is why that hack isn't needed
// here at all: pausing the whole track on hover keeps geometry fixed for
// as long as the pointer is engaged, so there's nothing to resync).
//
// The progress bar (numbers flanking a line, a scroll-position thumb) is
// removed outright, markup/script/CSS - per direct request. It measured
// page-scroll progress through the old pin, a concept that doesn't
// exist anymore now that the strip moves on its own timer rather than in
// response to scrolling.
//
// Reduced motion: unchanged principle, adjusted for the new mechanism -
// no auto-scroll at all, a plain native-scrollable strip
// (overflow-x: auto) instead, with the clone set hidden outright (a
// static strip has no loop to sell, so a second copy of all 15 images
// would just be confusing, not decorative).
import SectionMarker from '../ui/SectionMarker.astro';
import Tag from '../ui/Tag.astro';

const TOTAL = 15;
const ASPECTS = ['wide', 'tall', 'square'] as const;
const FLOATS = ['up', 'flat', 'down'] as const;
const TAGS = ['Process', 'Detail', 'Concept'] as const;

const tiles = Array.from({ length: TOTAL }, (_, i) => ({
  number: String(i + 1).padStart(2, '0'),
  aspectClass: ASPECTS[i % ASPECTS.length],
  // Offset by 1 from the aspect cycle so the two patterns don't lock
  // step and repeat identically every 3 tiles.
  floatClass: FLOATS[(i + 1) % FLOATS.length],
  tag: TAGS[i % TAGS.length],
}));
---

<section class="gallery">
  <div class="gallery__inner">
    <SectionMarker index="03" label="Gallery" />
  </div>

  <div class="gallery__stage">
    <div class="gallery__viewport" data-total={TOTAL}>
      <ul class="gallery__track">
        {[...tiles, ...tiles].map((tile, i) => {
          const isClone = i >= TOTAL;
          return (
            <li
              class:list={[
                'gallery__tile',
                `gallery__tile--${tile.aspectClass}`,
                `gallery__tile--${tile.floatClass}`,
                { 'gallery__tile--clone': isClone },
              ]}
              aria-hidden={isClone ? 'true' : undefined}
            >
              <button
                type="button"
                class="gallery__trigger"
                data-index={i % TOTAL}
                tabindex={isClone ? -1 : undefined}
                aria-label={isClone ? undefined : `View image ${tile.number} of ${TOTAL} larger`}
              >
                <span class="gallery__placeholder">
                  <!--
                    Touch-only tap affordance ("for screens where hover
                    functions do not apply, make it clear you can tap the
                    images to enlarge") - the custom cursor is gated on
                    pointer:fine, so touch needs its own always-visible
                    cue in the same corner it would otherwise fade in
                    from.
                  -->
                  <span class="gallery__tap-hint" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none">
                      <path
                        d="M2 6V2H6M10 2H14V6M14 10V14H10M6 14H2V10"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </span>
              </button>

              <div class="gallery__tile-footer">
                <Tag>{tile.tag}</Tag>
                <!-- TODO: replace with a real one-line description once real work is supplied (PROJECT_BRIEF.md Section 6 - no case-study copy exists yet). -->
                <p class="gallery__tile-caption">Short description of this piece, once supplied.</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<!--
  Deliberately a sibling of <section class="gallery">, not nested inside
  it - a fixed, full-viewport cursor needs an ancestor chain with no
  active transform on it (see AGENTS.md's stacking-context notes for why
  a transformed ancestor silently breaks position: fixed descendants).
  Nothing in this section is transformed anymore (the marquee moves
  .gallery__track, not the section or stage), but keeping the cursor
  outside the section is still the simplest way to guarantee that stays
  true regardless of future changes in here.

  Two elements, not one: GSAP's x/y follow (script) writes an inline
  `transform` on the outer .gallery__cursor every frame, which would
  silently override a CSS `transform: scale()` on the same element - the
  is-active state's scale-in never actually took effect once GSAP had
  touched the property, another instance of the same "GSAP vs static
  transform" conflict documented elsewhere in this file. The inner
  .gallery__cursor-inner instead owns the CSS transform/opacity for the
  hover state, so the two never fight over the same property.
-->
<div class="gallery__cursor" aria-hidden="true">
  <span class="gallery__cursor-inner">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M2 6V2H6M10 2H14V6M14 10V14H10M6 14H2V10"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</div>

<!--
  Same reasoning as the cursor above for living outside <section
  class="gallery"> - a fixed, full-viewport element. The "hole" is a
  single small box-shadow trick (0 0 0 9999px), not a page-wide dim
  layer plus a raised tile: the hovered tile never needs its own z-index
  above this at all, since a box-shadow never paints inside its own
  element's box - whatever's genuinely underneath that rectangle (the
  real tile, in normal DOM order) just shows through unobscured, while
  everywhere else on the page goes dark.
-->
<div class="gallery__spotlight" aria-hidden="true"></div>

<div
  class="lightbox"
  id="gallery-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  hidden
>
  <button type="button" class="lightbox__backdrop" aria-label="Close image viewer"></button>

  <!--
    Close/prev/next are pinned to the lightbox's own (viewport) edges, not
    laid out as flex-siblings of the image: a flex row of [prev, image,
    next] adds each control's width on top of the image's own width, which
    stopped fitting in a phone-width viewport (the next button measured
    outside the 390px viewport entirely - a real bug, caught via
    getBoundingClientRect, not visual guesswork). Pinning to the edges
    means the controls' position never depends on the image's size.
  -->
  <button type="button" class="lightbox__close" aria-label="Close">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M4 4L12 12M12 4L4 12"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Previous image">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M13 8H3M3 8L6.75 4.25M3 8L6.75 11.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Next image">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M3 8H13M13 8L9.25 4.25M13 8L9.25 11.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <div class="lightbox__stage">
    <span class="lightbox__placeholder">
      <span class="lightbox__number" aria-hidden="true"></span>
    </span>
    <p class="lightbox__counter">
      <span class="lightbox__current">1</span> / <span>{TOTAL}</span>
    </p>
  </div>
</div>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const viewport = document.querySelector<HTMLElement>('.gallery__viewport');
  const track = document.querySelector<HTMLElement>('.gallery__track');
  const cursor = document.querySelector<HTMLElement>('.gallery__cursor');
  const spotlight = document.querySelector<HTMLElement>('.gallery__spotlight');
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxStage = lightbox?.querySelector<HTMLElement>('.lightbox__stage');
  const lightboxPlaceholder = lightbox?.querySelector<HTMLElement>('.lightbox__placeholder');
  const lightboxCounter = lightbox?.querySelector<HTMLElement>('.lightbox__counter');
  const numberEl = lightbox?.querySelector<HTMLElement>('.lightbox__number');
  const currentEl = lightbox?.querySelector<HTMLElement>('.lightbox__current');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__close');
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__nav--prev');
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__nav--next');
  const backdrop = lightbox?.querySelector<HTMLButtonElement>('.lightbox__backdrop');

  if (
    viewport &&
    track &&
    lightbox &&
    lightboxStage &&
    lightboxPlaceholder &&
    lightboxCounter &&
    numberEl &&
    currentEl &&
    closeBtn &&
    prevBtn &&
    nextBtn &&
    backdrop
  ) {
    const reduceMotion = prefersReducedMotion();
    const total = Number(viewport.dataset.total || '0');

    // Only the real (first) set of triggers - the clone set exists
    // purely for the loop illusion (see the file header comment) and is
    // aria-hidden/untabbable/pointer-events:none, so it's never wired to
    // the lightbox or any hover effect below.
    const triggers = Array.from(
      viewport.querySelectorAll<HTMLButtonElement>('.gallery__trigger'),
    ).slice(0, total);

    if (reduceMotion) {
      // No auto-scroll, no scroll-hijack of any kind - a plain native
      // horizontal strip instead, so every tile stays reachable with
      // zero motion (see the file header comment). The clone set is
      // hidden via CSS in this mode - a static strip has nothing to
      // loop, so a second copy of all 15 images would just be a
      // confusing duplicate, not decorative.
      viewport.classList.add('gallery__viewport--static');
    } else {
      // Continuous auto-scroll: a single GSAP tween walks the track from
      // xPercent 0 to -50 and repeats indefinitely. Both halves of the
      // track (real set + clone set) are pixel-identical, so the loop
      // point at -50% is invisible - the moment it snaps back to 0% it's
      // showing exactly the same content the -50% frame just showed.
      const PX_PER_SECOND = 45;
      let tween: gsap.core.Tween | null = null;
      let resizeTimer: number | undefined;

      const startMarquee = () => {
        tween?.kill();
        gsap.set(track, { xPercent: 0 });
        const setWidth = track.scrollWidth / 2;
        tween = gsap.to(track, {
          xPercent: -50,
          duration: setWidth / PX_PER_SECOND,
          ease: 'none',
          repeat: -1,
        });
      };

      startMarquee();

      // Re-measure on resize (tile widths are viewport-relative via
      // clamp()) - debounced so a drag-resize doesn't restart the tween
      // dozens of times a second.
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(startMarquee, 200);
      });

      // Pausing at the viewport level, not per-tile - per direct request
      // ("stop the auto scroll while hovering an image"). Simpler than a
      // per-tile pause/resume, and it means the track's geometry stays
      // fixed for the whole time a pointer is engaged with any tile, so
      // none of the hover effects below ever need to resync against a
      // tile that moved out from under a stationary cursor (the exact
      // problem the old pin-driven version needed a synthetic-
      // pointerleave workaround for - see AGENTS.md).
      viewport.addEventListener('pointerenter', () => tween?.pause());
      viewport.addEventListener('pointerleave', () => tween?.resume());
    }

    // Continuous "breathing" bob: every real tile's trigger (not the
    // tile itself - the tile already carries a static CSS transform for
    // its up/down float, and GSAP animating a second transform on the
    // same element would silently fight that one, same "GSAP vs static
    // transform" conflict documented elsewhere in this file) drifts a
    // few px up and down in a slow, soft loop for as long as the page is
    // open. Hovering a specific tile freezes only that one (pause, not
    // kill, so it resumes from the same point in its cycle rather than
    // resetting).
    if (!reduceMotion) {
      const bobTweens = triggers.map((el, i) =>
        gsap.to(el, {
          y: 7,
          duration: 2.4 + (i % 5) * 0.2,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true,
        }),
      );

      triggers.forEach((trigger, i) => {
        trigger.addEventListener('pointerenter', () => bobTweens[i].pause());
        trigger.addEventListener('pointerleave', () => bobTweens[i].resume());
      });
    }

    // Mouse-magnetic tile shift, per direct request ("like a lot of
    // Awwwards type websites, the images kind of shift to the mouse
    // position") - the placeholder drifts a few px toward wherever the
    // cursor sits within the tile, on top of its existing hover scale.
    if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      const SHIFT_RANGE = 16;

      triggers.forEach((trigger) => {
        const placeholder = trigger.querySelector<HTMLElement>('.gallery__placeholder');
        if (!placeholder) return;

        const moveX = gsap.quickTo(placeholder, 'x', { duration: 0.5, ease: 'power3.out' });
        const moveY = gsap.quickTo(placeholder, 'y', { duration: 0.5, ease: 'power3.out' });

        trigger.addEventListener('pointerenter', () => {
          gsap.to(placeholder, { scale: 1.05, duration: 0.5, ease: 'power2.out' });
        });
        trigger.addEventListener('pointermove', (event) => {
          const rect = trigger.getBoundingClientRect();
          const relX = (event.clientX - rect.left) / rect.width - 0.5;
          const relY = (event.clientY - rect.top) / rect.height - 0.5;
          moveX(relX * SHIFT_RANGE);
          moveY(relY * SHIFT_RANGE);
        });
        trigger.addEventListener('pointerleave', () => {
          gsap.to(placeholder, { x: 0, y: 0, scale: 1, duration: 0.6, ease: 'power3.out' });
        });
      });
    }

    // Custom "expand" cursor: a small circle that follows the pointer
    // and only appears over a tile, replacing the system cursor there.
    // Gated on a fine pointer as well as reduced motion.
    if (!reduceMotion && cursor && window.matchMedia('(pointer: fine)').matches) {
      viewport.classList.add('gallery__viewport--custom-cursor');
      const moveX = gsap.quickTo(cursor, 'x', { duration: 0.35, ease: 'power3.out' });
      const moveY = gsap.quickTo(cursor, 'y', { duration: 0.35, ease: 'power3.out' });

      triggers.forEach((trigger) => {
        trigger.addEventListener('pointerenter', (event) => {
          gsap.set(cursor, { x: event.clientX, y: event.clientY });
          cursor.classList.add('is-active');
        });
        trigger.addEventListener('pointermove', (event) => {
          moveX(event.clientX);
          moveY(event.clientY);
        });
        trigger.addEventListener('pointerleave', () => cursor.classList.remove('is-active'));
      });
    }

    // Spotlight: dims the rest of the page while a tile is hovered.
    // Tracked on a gsap.ticker loop rather than positioned once on
    // pointerenter, since the mouse-magnetic shift above moves and
    // scales the placeholder continuously while it's hovered - reading
    // getBoundingClientRect() every frame means the hole always matches
    // whatever's actually on screen without needing to know how the
    // placeholder got there.
    if (!reduceMotion && spotlight && window.matchMedia('(pointer: fine)').matches) {
      let activePlaceholder: HTMLElement | null = null;

      const syncSpotlight = () => {
        if (!activePlaceholder) return;
        const rect = activePlaceholder.getBoundingClientRect();
        spotlight.style.left = `${rect.left}px`;
        spotlight.style.top = `${rect.top}px`;
        spotlight.style.width = `${rect.width}px`;
        spotlight.style.height = `${rect.height}px`;
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('pointerenter', () => {
          activePlaceholder = trigger.querySelector<HTMLElement>('.gallery__placeholder');
          syncSpotlight();
          gsap.ticker.add(syncSpotlight);
          spotlight.classList.add('is-active');
        });
        trigger.addEventListener('pointerleave', () => {
          gsap.ticker.remove(syncSpotlight);
          activePlaceholder = null;
          spotlight.classList.remove('is-active');
        });
      });
    }

    // --- Lightbox ---
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const label = (i: number) => String(i + 1).padStart(2, '0');

    const render = () => {
      numberEl.textContent = `[ ${label(currentIndex)} ]`;
      currentEl.textContent = String(currentIndex + 1);
    };

    const step = (delta: number) => {
      currentIndex = (currentIndex + delta + total) % total;
      render();
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeLightbox();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'Tab') {
        const focusable = [closeBtn, prevBtn, nextBtn];
        const activeIndex = focusable.indexOf(document.activeElement as HTMLButtonElement);
        event.preventDefault();
        const dir = event.shiftKey ? -1 : 1;
        const nextFocus = focusable[(activeIndex + dir + focusable.length) % focusable.length];
        nextFocus?.focus();
      }
    };

    // FLIP (First/Last/Invert/Play): reads the origin tile's current box
    // ("first"), diffs it against the lightbox image's own natural,
    // already-laid-out box ("last"), and plays that difference as a
    // transform, so the tile visually grows into the detail view instead
    // of two competing effects (a fade plus an unrelated move).
    const flipDelta = (fromEl: HTMLElement, toEl: HTMLElement) => {
      const from = fromEl.getBoundingClientRect();
      const to = toEl.getBoundingClientRect();
      return {
        x: from.left + from.width / 2 - (to.left + to.width / 2),
        y: from.top + from.height / 2 - (to.top + to.height / 2),
        scaleX: from.width / to.width,
        scaleY: from.height / to.height,
      };
    };

    // The tile currently associated with whichever image is on screen -
    // looked up fresh by data-index rather than trusting the trigger the
    // lightbox was originally opened from, so closing after stepping to
    // a different image (prev/next) flies back into the right tile.
    const currentTrigger = () =>
      triggers.find((trigger) => Number(trigger.dataset.index) === currentIndex) ?? null;

    function closeLightbox() {
      const finish = () => {
        lightbox!.hidden = true;
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
        gsap.set(lightboxPlaceholder!, { clearProps: 'transform' });
        lastFocused?.focus();
      };
      if (!reduceMotion) {
        const origin = currentTrigger()?.querySelector<HTMLElement>('.gallery__placeholder');
        const chrome = [closeBtn, prevBtn, nextBtn, lightboxCounter];
        gsap.to(backdrop!, { opacity: 0, duration: 0.35, ease: 'sine.inOut' });
        gsap.to(chrome, { opacity: 0, duration: 0.25, ease: 'sine.inOut' });
        if (origin) {
          gsap.to(lightboxPlaceholder!, {
            ...flipDelta(origin, lightboxPlaceholder!),
            duration: 0.5,
            ease: 'power3.inOut',
            onComplete: finish,
          });
        } else {
          // Origin tile isn't in the DOM for some reason - fall back to a
          // plain fade rather than leaving the placeholder stuck mid-animation.
          gsap.to(lightboxPlaceholder!, { opacity: 0, duration: 0.35, onComplete: finish });
        }
      } else {
        finish();
      }
    }

    const openLightbox = (index: number, trigger: HTMLElement) => {
      currentIndex = index;
      lastFocused = trigger;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';

      if (!reduceMotion) {
        // Already-hovered state shouldn't linger, visually hidden but
        // still "active," underneath the now-opaque lightbox.
        cursor?.classList.remove('is-active');
        spotlight?.classList.remove('is-active');
        gsap.set(triggers.map((t) => t.querySelector('.gallery__placeholder')).filter(Boolean), {
          x: 0,
          y: 0,
          scale: 1,
        });

        gsap.set(backdrop, { opacity: 0 });
        gsap.set([closeBtn, prevBtn, nextBtn, lightboxCounter], { opacity: 0 });
        gsap.to(backdrop, { opacity: 1, duration: 0.4, ease: 'sine.inOut' });
        gsap.to([closeBtn, prevBtn, nextBtn, lightboxCounter], {
          opacity: 1,
          duration: 0.4,
          ease: 'sine.inOut',
          delay: 0.15,
        });

        const origin = trigger.querySelector<HTMLElement>('.gallery__placeholder') ?? trigger;
        gsap.set(lightboxPlaceholder, flipDelta(origin, lightboxPlaceholder!));
        gsap.to(lightboxPlaceholder, {
          x: 0,
          y: 0,
          scaleX: 1,
          scaleY: 1,
          duration: 0.65,
          ease: 'power3.out',
        });
      }
      closeBtn.focus();
      document.addEventListener('keydown', onKeydown);
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        openLightbox(Number(trigger.dataset.index), trigger);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    backdrop.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
  }
</script>

<style>
  .gallery {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    /* No background fill (per earlier direct request) - the section sits
         directly on the page's own bg-primary. */
    overflow-x: hidden;
  }

  .gallery__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  /* Full-bleed breakout, per earlier direct request: standard 100vw +
     negative-margin technique, independent of .gallery__inner's own
     max-width above it. */
  .gallery__stage {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
  }

  .gallery__viewport {
    position: relative;
    z-index: 1;
    overflow: hidden;
    /* Vertical room for the float offset and hover bob so nothing clips.
         Negative margin cancels the padding's footprint on .gallery__stage's
         own auto height. */
    padding-block: 2.5rem;
    margin-block: -2.5rem;
  }

  /* Custom cursor replaces the system pointer only where it's shown -
     falls back to the native cursor everywhere else. */
  .gallery__viewport--custom-cursor .gallery__trigger {
    cursor: none;
  }

  /* Reduced-motion fallback: a plain native-scrollable strip, no
     auto-scroll, no transform-driven track. */
  .gallery__viewport--static {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  /* The clone set exists purely to sell the auto-scroll loop (see the
     file header comment) - a static, user-scrolled strip has no loop to
     sell, so showing it here would just be the same 15 images twice. */
  .gallery__viewport--static .gallery__tile--clone {
    display: none;
  }

  .gallery__track {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    width: max-content;
