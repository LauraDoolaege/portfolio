---
// Homepage/About contact CTA (PROJECT_BRIEF.md Section 4, item 6). Copy is
// exact, final text from the brief. Uses dark-field — locked as "footer /
// at most one controlled CTA band" (CLAUDE.md Design system, Section 3
// palette table) — as the one sanctioned dark moment leading straight into
// the (also dark-field) Footer, so the two read as one deliberate closing
// zone rather than two unrelated dark patches.
//
// id="contact" now lives here (moved off Footer.astro - see that file's
// own comment) since this is the section that actually carries the
// contact methods now; Header.astro's "Contact" nav item points at a bare
// `#contact` from any page.
//
// Structure pass - "the cta just needs to be a lot clearer," plus a
// reference image (a blue closing section: an outlined setup line + a
// huge solid payoff word, then a numbered link list, then an
// availability/copyright row) used for layout inspiration only, not
// copied - explicit instruction not to reuse its literal look, just its
// structure. What actually changed:
//
// The old version was a centered headline over one small boxed "Get in
// touch" button linking to /contact, a page that doesn't exist yet
// (PROJECT_BRIEF.md Section 5 - Contact is PROPOSED, unapproved) - a weak,
// somewhat dead-ended CTA. PROJECT_BRIEF.md Section 5's own draft layout
// for the (still unbuilt) full Contact page already sketches almost
// exactly what "a lot clearer" calls for here: the same "Enough about
// me... Let's hear your side of the story." copy as two headline lines,
// a large tappable email link, and a compact "Email · LinkedIn · CV" link
// row - so this borrows that already-approved-in-spirit structure for the
// homepage/About *teaser* block specifically (not the full unbuilt page,
// which stays out of scope), scaled down: the brief's two separate
// buttons ("[Get in touch]" / "[Download my CV]") would have duplicated
// the big email link and the link row below it for no real benefit at
// this block's smaller scale, so they're left out here rather than
// carried over just because the draft has them.
//
// Left-aligned now, not centered - three stacked pieces of unequal
// visual weight (two-line headline, one big email link, a small link
// row) read as a considered hierarchy left-aligned; centered, the same
// pieces stack without one clear "start here."
// TODO: replace with the real email/LinkedIn/CV destinations once
// supplied (same open item as Header.astro's own CV button and
// Footer.astro's former email/LinkedIn row, moved here) - href="#" for
// LinkedIn/CV matches Header.astro's own placeholder convention exactly.
const email = 'hello@example.com';
const linkedinHref = '#';
const cvHref = '#';
---

<section class="contact-cta" id="contact">
  <div class="contact-cta__inner">
    <h2 class="contact-cta__headline">
      <span class="contact-cta__headline-line contact-cta__headline-line--soft">
        Enough about me.
      </span>
      <span class="contact-cta__headline-line contact-cta__headline-line--bold">
        Let's hear your side of the story.
      </span>
    </h2>

    <a href={`mailto:${email}`} class="contact-cta__email">
      {email}
    </a>

    <ul class="contact-cta__links">
      <li>
        <a href={`mailto:${email}`} class="contact-cta__link">
          Email
        </a>
      </li>
      <li>
        <a href={linkedinHref} class="contact-cta__link">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={cvHref} class="contact-cta__link">
          CV
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const headlineLines = document.querySelectorAll<HTMLElement>('.contact-cta__headline-line');
  const email = document.querySelector<HTMLElement>('.contact-cta__email');
  const links = document.querySelector<HTMLElement>('.contact-cta__links');
  if (headlineLines.length && email && links && !prefersReducedMotion()) {
    // A calm fade/rise, three beats instead of the previous two (headline,
    // then button) - the headline's own two lines stagger in together,
    // then the big email link, then the compact link row a beat after
    // that, so the eye is guided down the new hierarchy in order rather
    // than everything arriving at once.
    gsap.set([...headlineLines, email, links], { autoAlpha: 0, y: 20 });
    gsap
      .timeline({ scrollTrigger: { trigger: headlineLines[0], start: 'top 85%' } })
      .to(headlineLines, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power2.out', stagger: 0.08 })
      .to(email, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, 0.35)
      .to(links, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, 0.5);
  }
</script>

<style>
  .contact-cta {
    padding-block: var(--space-section);
    background: var(--color-dark-field);
    color: var(--color-bg-primary);
  }

  .contact-cta__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
  }

  .contact-cta__headline {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    /* Wide enough that the bold line's six words wrap into two lines, not
                                                       one-or-two words per line - --text-h1's own 96px ceiling (below)
                                                       is tuned for a single short word (Hero's "PORTFOLIO"), not a full
                                                       sentence, so this needs real width to go with it or it reads as
                                                       broken instead of bold. */
    max-width: 42ch;
  }

  /* The setup line - smaller, lighter weight, on-dark secondary color -
     against the payoff line's full display treatment below. Same two
     sentences the old single-line version already used (PROJECT_BRIEF.md
     Section 4, item 6, and the same copy Section 5's own Contact-page
     draft breaks into these exact two lines) - split for hierarchy here,
     not rewritten. */
  .contact-cta__headline-line--soft {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.1rem, 1vw + 0.9rem, 1.375rem);
    color: var(--color-text-secondary-on-dark);
  }

  .contact-cta__headline-line--bold {
    font-family: var(--font-display);
    font-weight: 700;
    /* A smaller ceiling than --text-h1 (96px, tuned for Hero's single
                                                       short word) - at that size, six words wrapped one-or-two per line
                                                       instead of reading as a bold sentence. */
    font-size: clamp(2.25rem, 3vw + 1.25rem, 4.25rem);
    line-height: var(--text-h1-leading);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* The large tappable link PROJECT_BRIEF.md Section 5's own Contact-page
     draft calls for - reusing the exact display-email treatment
     Footer.astro's old contact row used to carry (font-display, bold,
     lowercase), just relocated here since this is now the section that
     actually needs to read as "the" primary contact method. */
  .contact-cta__email {
    display: block;
    margin-top: var(--space-48);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.5vw + 1rem, 3.5rem);
    text-transform: lowercase;
    letter-spacing: -0.01em;
    transition: color var(--motion-duration) var(--motion-easing-soft);
  }

  .contact-cta__email:hover,
  .contact-cta__email:focus-visible {
    /* var(--color-accent) drops to 3.49:1 on dark-field - the on-dark tint (global.css) keeps the same hue at a legible weight here. */
    color: var(--color-accent-on-dark);
  }

  /* The brief's own "Email · LinkedIn · CV" compact row - a quick-scan
     alternative to the big email link above it, not a duplicate of it:
     the big link is the one obvious tap target, this is the fine-print
     fallback for someone who wants LinkedIn or the CV specifically. */
  .contact-cta__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    margin-top: var(--space-32);
    padding-top: var(--space-24);
    border-top: var(--border-hairline) solid rgb(248 246 241 / 0.2);
  }

  .contact-cta__links li {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  /* A plain middot between items instead of a border/divider, matching
     the brief's own "Email · LinkedIn · CV" punctuation exactly - only
     items after the first get one, so the row doesn't open with a stray
     mark before any content. */
  .contact-cta__links li:not(:first-child)::before {
    content: '·';
    color: var(--color-text-secondary-on-dark);
  }

  .contact-cta__link {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-bg-primary);
    transition: color var(--motion-duration) var(--motion-easing-soft);
  }

  .contact-cta__link:hover,
  .contact-cta__link:focus-visible {
    color: var(--color-accent-on-dark);
  }

  @media (max-width: 640px) {
    .contact-cta__inner {
      padding-inline: 1.5rem;
    }

    .contact-cta__headline {
      max-width: none;
    }
  }
</style>
