---
// Hero: status pill, massive H1, hook, tags. Each text line sits in an
// overflow-hidden mask; the script slides the inner element up into view.
---

<section class="hero" aria-label="Introduction">
  <div class="container hero__inner">
    <div class="hero__top mask">
      <p class="hero__pill reveal">
        <span class="hero__dot" aria-hidden="true"></span>
        Seeking UX &amp; Experience Design Internship (Feb – May 2027)
      </p>
    </div>

    <div class="hero__main">
      <div class="hero__stage">
        <h1 class="hero__title">
          <span class="mask">
            <span class="reveal reveal--title">Experience</span>
          </span>
          <span class="mask">
            <span class="reveal reveal--title">Designer</span>
          </span>
        </h1>

        <div class="hero__hook">
          <p class="mask">
            <span class="reveal reveal--hook">
              I detangle briefs into creative concepts that are feasible and grounded in marketing.
            </span>
          </p>
          <p class="mask">
            <span class="reveal reveal--hook">Online and offline.</span>
          </p>
        </div>
      </div>

      <ul class="hero__tags reveal--tags" aria-label="Focus">
        <li>UX Design</li>
        <li>
          <a
            href="https://www.howest.be/en/programmes/bachelor/digital-design-and-development"
            target="_blank"
            rel="noopener"
          >
            Devine 3rd Year
            <svg class="hero__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M3 9L9 3M4 3h5v5"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="square"
              />
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    flex: 1;
    display: flex;
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(2rem, 1rem + 3vw, 4rem);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* Clip container for the reveal. Bottom padding + matching negative margin keeps descenders from being cut at line-height < 1. */
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .reveal {
    display: block;
  }

  .hero__top {
    /* Room for the pill's border so the mask doesn't clip it */
    padding: 1px;
    margin: -1px;
    width: fit-content;
    max-width: 100%;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 1em;
    border: var(--hairline);
    border-radius: 999px;
    font-size: var(--text-small);
    color: var(--text-muted);
    line-height: 1.3;
  }

  .hero__dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Title and hook share one grid cell: the hook sits in the open space right of "Designer" on desktop, and stacks below on small screens. */
  .hero__stage {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .hero__title {
    grid-column: 1 / -1;
    grid-row: 1;
    /* "Experience" is ~5.2em wide: derive the size from the container so it fills it without ever clipping */
    font-size: min(13rem, calc((100vw - 2 * var(--page-margin)) / 5.4));
  }

  .hero__hook {
    grid-column: 1 / -1;
    grid-row: 2;
    max-width: 32ch;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--weight-light);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    border-top: var(--hairline);
    font-size: var(--text-small);
  }

  .hero__tags li,
  .hero__tags a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.9em;
    border: var(--hairline);
    border-radius: 999px;
    color: var(--text-muted);
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .hero__tags li:has(a) {
    padding: 0;
    border: 0;
  }

  .hero__tags a:hover {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .hero__arrow {
    width: 0.75em;
    height: 0.75em;
  }

  /* Side-by-side only once the H1 is capped at its max size and "Designer" leaves the right quarter open */
  @media (min-width: 1360px) {
    .hero__hook {
      grid-column: 10 / -1;
      grid-row: 1;
      align-self: end;
      /* Aligns the last hook line with the baseline area of "Designer" */
      padding-bottom: 1.6vw;
      max-width: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const pill = document.querySelector<HTMLElement>('.hero__pill');
  const title = gsap.utils.toArray<HTMLElement>('.reveal--title');
  const hook = gsap.utils.toArray<HTMLElement>('.reveal--hook');
  const tags = document.querySelector<HTMLElement>('.reveal--tags');

  if (!prefersReducedMotion() && pill && tags) {
    // Start states are set in JS, not CSS, so no-JS visitors still see everything.
    // The tags aren't masked, so they get a short travel instead of a full-height slide.
    gsap.set([pill, ...title, ...hook], { yPercent: 100, opacity: 0 });
    gsap.set(tags, { y: 24, opacity: 0 });

    // Sequence: status pill, then H1 lines, then hook, then tags.
    const defaults = { duration: 1.2, ease: 'expo.out', opacity: 1 };
    gsap
      .timeline()
      .to(pill, { ...defaults, yPercent: 0 })
      .to(title, { ...defaults, yPercent: 0, stagger: 0.12 }, '-=0.95')
      .to(hook, { ...defaults, yPercent: 0, stagger: 0.1 }, '-=0.9')
      .to(tags, { ...defaults, y: 0 }, '-=1');
  }
</script>
