---
// The brief's "ticket-card" module (PROJECT_BRIEF.md Section 3 principle 5
// and Section 7): one component, reused everywhere a project thumbnail
// appears (homepage Selected Work now, Work index later). Content-agnostic
// via props, so it lives in ui/ rather than sections/.
//
// "Ticket" isn't just a name: the dashed rule between image and info block
// is a literal stub tear-line, and the corner number is a plate/ticket
// numeral — small, load-bearing details rather than decoration for its
// own sake.
//
// href defaults to "#" — case-study pages are PROPOSED, not built yet
// (PROJECT_BRIEF.md Section 5), same placeholder-link pattern already used
// by the header CV button until a real destination exists.
import Tag from './Tag.astro';

interface Props {
  number: string;
  title: string;
  roleTag: string;
  year?: string;
  href?: string;
  class?: string;
}

const { number, title, roleTag, year = 'TBD', href = '#', class: className } = Astro.props;
---

<a href={href} class:list={['project-card', className]} aria-label={`${title} — ${roleTag}`}>
  <span class="project-card__frame">
    <span class="project-card__image">
      <!-- TODO: replace with a real project image once photography exists (PROJECT_BRIEF.md Section 6) -->
    </span>
    <span class="project-card__number" aria-hidden="true">
      {number}
    </span>
  </span>

  <span class="project-card__stub" aria-hidden="true"></span>

  <span class="project-card__info">
    <span class="project-card__meta">
      <Tag>{roleTag}</Tag>
      <span class="project-card__year" aria-hidden="true">
        {year}
      </span>
    </span>
    <span class="project-card__title">{title}</span>
    <span class="project-card__link" aria-hidden="true">
      [ view project → ]
    </span>
  </span>
</a>

<script>
  // Mouse-magnetic image shift, per direct request ("like a lot of
  // Awwwards type websites, the images kind of shift to the mouse
  // position") - the image drifts a few px toward wherever the cursor
  // sits within the frame, on top of the existing scale-up. Gated on
  // `pointer: fine` as well as reduced motion, same as the Gallery
  // cursor/spotlight - this is a continuous mouse-follow effect, not
  // something touch has an equivalent of. The CSS `:hover { transform:
  // scale(1.03) }` rule stays in the stylesheet as the reduced-motion/
  // no-JS fallback: GSAP's inline `transform` always wins over it once
  // this script runs, but when it doesn't (reduced motion, or JS never
  // loads), the plain CSS hover state still gives a functional response,
  // just without the mouse-follow.
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  if (!prefersReducedMotion() && window.matchMedia('(pointer: fine)').matches) {
    // Total px range the image can travel corner-to-corner within the
    // frame - modest on purpose (the frame clips via overflow: hidden,
    // and the hover scale-up is what gives the image the few px of
    // buffer to shift within without revealing the frame's own
    // background at an edge).
    const SHIFT_RANGE = 20;

    document.querySelectorAll<HTMLAnchorElement>('.project-card').forEach((card) => {
      const frame = card.querySelector<HTMLElement>('.project-card__frame');
      const image = card.querySelector<HTMLElement>('.project-card__image');
      if (!frame || !image) return;

      const moveX = gsap.quickTo(image, 'x', { duration: 0.5, ease: 'power3.out' });
      const moveY = gsap.quickTo(image, 'y', { duration: 0.5, ease: 'power3.out' });

      card.addEventListener('pointerenter', () => {
        gsap.to(image, { scale: 1.06, duration: 0.5, ease: 'power2.out' });
      });

      card.addEventListener('pointermove', (event) => {
        const rect = frame.getBoundingClientRect();
        const relX = (event.clientX - rect.left) / rect.width - 0.5;
        const relY = (event.clientY - rect.top) / rect.height - 0.5;
        moveX(relX * SHIFT_RANGE);
        moveY(relY * SHIFT_RANGE);
      });

      card.addEventListener('pointerleave', () => {
        gsap.to(image, { x: 0, y: 0, scale: 1, duration: 0.6, ease: 'power3.out' });
      });
    });
  }
</script>

<style>
  .project-card {
    display: block;
  }

  .project-card__frame {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .project-card__image {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    border-radius: var(--radius-image);
    transition: transform var(--motion-duration-slow) var(--motion-easing);
  }

  /* Reduced-motion/no-JS fallback only - the script above takes over transform entirely (scale + mouse-follow shift) once it runs, and GSAP's inline transform always wins over this rule regardless of source order, so there's no double-scaling risk between the two. */
  .project-card:hover .project-card__image,
  .project-card:focus-visible .project-card__image {
    transform: scale(1.03);
  }

  .project-card__number {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.3em 0.55em;
    background: var(--color-bg-primary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .project-card__stub {
    display: block;
    margin-top: 0.9rem;
    border-top: var(--border-hairline) dashed var(--color-text-secondary);
  }

  .project-card__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding-top: 0.9rem;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .project-card__year {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-ink);
    transition: color var(--motion-duration) var(--motion-easing);
  }

  .project-card__link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-0.4em);
    transition:
      opacity var(--motion-duration) var(--motion-easing),
      transform var(--motion-duration) var(--motion-easing);
  }

  .project-card:hover .project-card__title,
  .project-card:focus-visible .project-card__title {
    color: var(--color-accent);
  }

  .project-card:hover .project-card__link,
  .project-card:focus-visible .project-card__link {
    opacity: 1;
    transform: translateX(0);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
