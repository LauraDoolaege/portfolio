---
// About page, phase 1: hero and the journey. Team, inspiration and skills come later.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import AboutHero from '../components/sections/AboutHero.astro';
import AboutJourney from '../components/sections/AboutJourney.astro';
---

<BaseLayout
  title="About | Laura Doolaege"
  description="Laura's portfolio: digital development & design."
>
  <div class="page">
    <Header />
    <main id="main">
      <AboutHero />
      <AboutJourney />
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>
