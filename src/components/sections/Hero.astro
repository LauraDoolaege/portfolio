---
// Homepage hero (PROJECT_BRIEF.md Section 5 "Homepage — LOCKED", item 1).
// Content is final per the brief (Section 6): role line, intro, CTA, and
// tags. Rebuilt to a precise 12-column grid spec (a target wireframe the
// file attached), replacing the earlier freeform version.
//
// "Motion Design" was dropped from the tag list per direct request - two
// tags now, not three. Nothing else in this file assumes a specific tag
// count (the list wraps via plain flexbox), so removing one needed no
// layout changes.
//
// Grid: shares --intro-max-width / --intro-margin with Header.astro (see
// global.css) so logo, nav/CV, the title, and the bottom block all sit on
// the same margin lines — the earlier version's biggest complaint was
// that these drifted out of alignment with each other.
//
// The visual anchor is now a portrait image slot (replacing the earlier
// organic placeholder blob — a mistake in the sketch this rebuilt from,
// per direct correction) with "PORTFOLIO" overlapping its lower third,
// the same locked object-in-letterform device as before, just a
// different placeholder shape. The word is sized with container query
// units (cqw) rather than a hand-tuned clamp() curve, so it fills the
// full grid width edge-to-edge without overflowing or wrapping at any
// viewport width — a plain-clamp() fallback covers browsers without
// container query support.
//
// Motion: this is the project's first real use of GSAP (previously
// plumbing-only, see src/utils/motion.ts). Every animated property is
// transform/opacity/clip-path only (GPU-only, no layout impact). All
// initial "hidden" states are set imperatively via gsap.set() in the
// script below, never in static CSS — so if JS fails to load, everything
// still renders in its normal, final, fully visible position. See the
// prefersReducedMotion() guard for the reduced-motion path.
//
// Open decisions this component had to fill in (not locked anywhere —
// see CLAUDE.md "Open decisions"):
// - "Get to know me" target: linked to /about (no target was specified).
// - No real photo exists yet (PROJECT_BRIEF.md Section 6) — the image
//   slot is a placeholder block with a TODO showing the exact swap-in
//   markup once one exists.
import { withBase } from '../../utils/url';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';

const titleWord = 'Portfolio';
const letters = titleWord.split('');
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__visual">
      <div class="hero__meta">
        <span class="hero__year" aria-label="2026">
          <span aria-hidden="true">20</span>
          <span aria-hidden="true">26</span>
        </span>

        <ul class="hero__tags">
          <li>
            <Tag>UX / Experience Design</Tag>
          </li>
          <li>
            <Tag>Digital Design</Tag>
          </li>
        </ul>
      </div>

      <span class="hero__image" aria-hidden="true">
        <!--
          TODO: swap for a real photo once one exists (PROJECT_BRIEF.md
          Section 6 — no photography yet). Replace this span's content with:
          <img src={yourImportedImage} alt="Laura Doolaege" class="hero__image-img" />
          — .hero__image-img is already styled (width/height/object-fit)
          and ready for it.
        -->
      </span>

      <!--
        A second image placeholder, per direct request ("maybe just think
        to add more images... to the current image") - a smaller chip
        peeking from behind the main portrait's lower-left corner, the
        same "pinned collage" language the About page's redesign now uses
        too. Grid-placed (overlapping the main image's own column range,
        layered via z-index), not absolutely positioned - simpler to keep
        in sync with the responsive grid than computing an offset by hand.
      -->
      <span class="hero__image-chip" aria-hidden="true">
        <!-- TODO: replace with a second real photo once photography exists (PROJECT_BRIEF.md Section 6) -->
      </span>

      <h1 class="hero__title" aria-label={titleWord}>
        <span class="hero__title-visual" aria-hidden="true">
          {letters.map((letter) => (
            <span class="hero__letter-mask">
              <span class="hero__letter">{letter}</span>
            </span>
          ))}
        </span>
      </h1>
    </div>

    <div class="hero__bottom">
      <p class="hero__role">
        Experience designer <span class="hero__role-soft">to-be</span>
      </p>

      <!--
        Echoes Header's own location/availability line
        (Header.astro's .site-header__status). Per direct request the
        reading order here is now role -> location -> paragraph -> tools
        on every screen size, not just mobile (this used to be
        mobile-only, hidden on desktop/tablet in favor of the header's
        own copy) - it now always shows, right under the role line.
      -->
      <p class="hero__status">
        <svg class="hero__status-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 14.2C8 14.2 12.5 9.8 12.5 6.3C12.5 3.8 10.5 1.8 8 1.8C5.5 1.8 3.5 3.8 3.5 6.3C3.5 9.8 8 14.2 8 14.2Z"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linejoin="round"
          />
          <circle cx="8" cy="6.3" r="1.6" stroke="currentColor" stroke-width="1.2" />
        </svg>
        Belgium <span aria-hidden="true">|</span> Available Feb 2027
      </p>

      <p class="hero__intro">
        I'm Laura, a digital development &amp; design student with a background in marketing
        communication, currently specialising in user experience design.
      </p>

      <!--
        Moved here from About's own dedicated Tools section, per direct
        request ("I think I should include them at the top of the page
        close to the experience designer to-be paragraph") - a plain row
        of icons rather than the bracket-tag chips the About version
        used ("the tools can be just icons like in this example"), still
        placeholder (no real toolkit confirmed yet - see the removed
        AboutTools.astro's own history in AGENTS.md for why). Per a later
        direct request it no longer sits beside the role line on desktop
        (grid_column 8/13, sharing row 1) - it now sits in the same
        column as the role/status/intro above it, after the paragraph,
        so the reading order (role, location, paragraph, tools) is
        identical at every viewport width instead of desktop having its
        own separate order.
      -->
      <div class="hero__tools">
        <p class="hero__tools-label">Tools</p>
        <ul class="hero__tools-list">
          {Array.from({ length: 5 }).map((_, i) => (
            <li>
              <span class="hero__tools-icon" aria-label={`Tool ${i + 1}`}>
                <!-- TODO: replace with a real tool icon once the toolkit is supplied -->
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!--
        Button and scroll cue share one row now, per direct request ("the
        (scroll) should be on the same line as the get to know me button,
        still on the right") - a single flex wrapper (button at its own
        content width, scroll pushed to the far end via
        justify-content: space-between) rather than each keeping its own
        separate grid placement, so "same line, still on the right" holds
        at every viewport without needing a per-breakpoint override -
        this used to need one for the grid columns changing between
        desktop/tablet, and a completely different mobile layout (its own
        line below the button) below 640px.
      -->
      <div class="hero__cta-row">
        <Button href={withBase('/about')} variant="primary" icon="arrow" class="hero__cta">
          Get to know me
        </Button>

        <span class="hero__scroll">(Scroll)</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const hero = document.querySelector('.hero');
  if (hero) {
    const image = hero.querySelector<HTMLElement>('.hero__image');
    const chip = hero.querySelector<HTMLElement>('.hero__image-chip');
    const letters = hero.querySelectorAll<HTMLElement>('.hero__letter');
    const meta = hero.querySelector<HTMLElement>('.hero__meta');
    const bottom = hero.querySelector<HTMLElement>('.hero__bottom');

    if (!prefersReducedMotion() && image && letters.length && meta && bottom) {
      // Initial states live here, not in CSS — if this script never runs,
      // the hero renders fully visible in its final layout, not stuck
      // mid-animation.
      gsap.set(image, { clipPath: 'inset(100% 0% 0% 0%)', scale: 1.05 });
      gsap.set(letters, { yPercent: 115 });
      gsap.set([meta, bottom], { autoAlpha: 0, y: 24 });
      if (chip) gsap.set(chip, { autoAlpha: 0, y: 16 });

      // Each element gets its own weight and character rather than one
      // eased curve applied uniformly to everything — that uniformity is
      // what reads as mechanical. Groups overlap instead of running
      // strictly one-after-another, which is what actually reads as
      // fluid rather than a checklist of steps.
      gsap
        .timeline()
        .to(
          image,
          { clipPath: 'inset(0% 0% 0% 0%)', scale: 1, duration: 1.1, ease: 'power3.out' },
          0,
        )
        .to(
          letters,
          {
            yPercent: 0,
            duration: 0.9,
            ease: 'back.out(1.5)',
            stagger: { each: 0.045, from: 'start', ease: 'sine.inOut' },
          },
          0.35,
        )
        .to(meta, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power2.out' }, 0.65)
        .to(bottom, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power2.out' }, 0.8);

      if (chip) {
        gsap.to(chip, { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 0.5 });
        // A slow, continuous idle float once the entrance settles - per
        // direct request to add "some animation... to the current
        // image." Small amplitude (8px) and a long, gentle duration (4s
        // each way) so it reads as ambient life, not a distracting loop -
        // same "locked-rule exception for a genuine ambient loop" pattern
        // already used for the Gallery tiles' own continuous bob (see
        // AGENTS.md), gated behind prefers-reduced-motion the same way.
        gsap.to(chip, {
          y: '+=8',
          duration: 4,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true,
          delay: 1.3,
        });
      }

      // Gentle scroll parallax on the image, capped at +/-40px. scrub: 1
      // (a one-second smoothing lag) rather than scrub: true (1:1 instant
      // tracking) — the image eases toward the scroll position instead of
      // snapping to it every frame, which is what actually reads as
      // smooth rather than mechanically glued to the scrollbar.
      gsap.fromTo(
        image,
        { y: -40 },
        {
          y: 40,
          ease: 'none',
          scrollTrigger: {
            trigger: hero,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1,
          },
        },
      );

      ScrollTrigger.refresh();
    }
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .hero__inner {
    width: 100%;
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
    padding-block: var(--space-32);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 auto;
    gap: var(--space-32);
  }

  .hero__visual {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--intro-gutter);
    row-gap: var(--space-16);
  }

  /* Right-aligned year + tags, sitting above the word beside the image. */
  .hero__meta {
    grid-column: 9 / 13;
    grid-row: 1;
    align-self: start;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-16);
    text-align: right;
  }

  .hero__year {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    line-height: 1.3;
    color: var(--color-text-secondary);
  }

  .hero__tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-8);
  }

  /* Image slot — replaces the earlier blob placeholder. Row 1 only; its own aspect-ratio (not a grid-row span) determines its height, so the title below can pull up into it by a font-size-relative amount instead of a row-sizing trick that turned out not to place things where it looked like it should. */
  .hero__image {
    grid-column: 5 / 9;
    grid-row: 1;
    align-self: start;
    aspect-ratio: 5 / 7;
    /* Caps how tall the image gets on short/laptop viewports so the hero actually fits 100dvh instead of pushing the bottom block below the fold — without this, a full 5:7 box at this column's width is taller than the viewport at common 900-ish px heights. Width stays grid-determined, so past this cap the box is wider than 5:7 rather than shrinking sideways too; an acceptable trade for a placeholder, worth revisiting once a real photo (with its own crop) is in. */
    max-height: 36dvh;
    overflow: hidden;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
  }

  .hero__image :global(.hero__image-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Overlaps the main image's own grid range (column 5/9) on its left
     edge, aligned to the bottom of row 1 and nudged further down/left -
     a grid-item overlap (z-index alone, no absolute positioning) so it
     tracks the responsive column widths automatically instead of a
     hand-computed offset. */
  .hero__image-chip {
    grid-column: 3 / 6;
    grid-row: 1;
    align-self: end;
    z-index: 1;
    width: 55%;
    aspect-ratio: 4 / 5;
    justify-self: end;
    transform: translateY(28%) rotate(-4deg);
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    box-shadow: 0 16px 28px -18px rgb(23 21 15 / 0.32);
  }

  /* Full-width, edge-to-edge title. container-type turns on cqw sizing for .hero__title-visual below — the word's font-size tracks this element's own rendered width, not the viewport, so it fills the grid at any width from 320px to well past 2560px without a hand-tuned breakpoint ladder. The negative margin-top is in em (title's own font-size), not px or %, so the overlap into the image's lower third scales with the word instead of drifting at other viewports. */
  .hero__title {
    grid-column: 1 / -1;
    grid-row: 2;
    container-type: inline-size;
    /* Without this, the negative margin-top below collapses straight through the h1 (standard block margin-collapsing), leaving the h1 measuring 0 height and the word floating detached from the grid's own row-sizing. flow-root opts out of collapsing without clipping the intentional overflow into the row above. */
    display: flow-root;
    /* Deliberately no position/z-index here: either one establishes a new stacking context, which would isolate .hero__letter's mix-blend-mode from the image and page background behind it (it would only blend against other things inside .hero__title, which is nothing) — paint order alone (title comes after image in the markup) already puts it on top. */
  }

  .hero__title-visual {
    display: flex;
    margin-top: -0.55em;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    /* 27cqw is measured, not guessed: at a given font-size, "PORTFOLIO" in this display font/weight/tracking renders to ~3.71x that font-size in width, so 100 / 3.71 ~= 27 is the cqw value that makes the rendered word width match the container width (edge to edge). The clamp() bounds are a floor/ceiling safety net, not the fallback — that's @supports below. */
    font-size: clamp(2.5rem, 27cqw, 26rem);
  }

  .hero__letter-mask {
    overflow: hidden;
  }

  .hero__letter {
    display: inline-block;
    color: var(--color-bg-primary);
    mix-blend-mode: difference;
  }

  /* Fallback for browsers without mix-blend-mode: plain ink text stays legible instead of rendering invisible cream-on-cream. */
  @supports not (mix-blend-mode: difference) {
    .hero__letter {
      color: var(--color-ink);
      mix-blend-mode: normal;
    }
  }

  /* Fallback for browsers without container query units: a viewport-based clamp() curve, same floor/ceiling as the cqw version above. */
  @supports not (container-type: inline-size) {
    .hero__title-visual {
      font-size: clamp(2.5rem, 11vw + 1rem, 26rem);
    }
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--intro-gutter);
  }

  .hero__role {
    grid-column: 1 / 6;
    grid-row: 1;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* role -> location -> paragraph -> tools, in that order on every
     screen width (explicit grid-row per element rather than relying on
     DOM order + auto-placement, so the sequence can't silently drift if
     a future edit reorders the markup). Used to sit beside .hero__role
     in its own column (8/13, sharing row 1) and only show on mobile at
     all - per direct request it's now always visible, directly under
     the role line, matching Header's own .site-header__status copy. */
  .hero__status {
    grid-column: 1 / 6;
    grid-row: 2;
    position: relative;
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-16);
    padding-left: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .hero__status::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2em;
    bottom: 0.2em;
    width: var(--border-hairline);
    background: var(--color-text-secondary);
  }

  .hero__status-icon {
    width: 0.9em;
    height: 0.9em;
    flex-shrink: 0;
  }

  .hero__status span {
    margin-inline: 0.15em;
  }

  .hero__intro {
    grid-column: 1 / 6;
    grid-row: 3;
    margin-top: var(--space-16);
    max-width: 38ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Now stacked below the paragraph (same 1/6 column, row 4), not beside
     the role line - per direct request that it "not be on the right
     like that" on desktop. */
  .hero__tools {
    grid-column: 1 / 6;
    grid-row: 4;
    margin-top: var(--space-24);
  }

  .hero__tools-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .hero__tools-list {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-8);
  }

  .hero__tools-icon {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    border-radius: var(--radius-image);
  }

  /* Full-width row so the flex children below (button, scroll cue) can
     spread across the whole grid - button at its natural width on the
     left, scroll cue pushed to the far right via
     justify-content: space-between. Spans every column at every width
     (desktop's 12-col grid, tablet's 7-col one, mobile's plain block
     flow), so nothing here needs its own per-breakpoint override the way
     the button and scroll cue each used to. */
  .hero__cta-row {
    grid-column: 1 / -1;
    grid-row: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
    margin-top: var(--space-48);
  }

  /* :global() is required — Button.astro renders its own <a>, which carries Button's own Astro scope hash, not Hero's, so an unscoped ".hero__cta" rule would silently never match it. No grid/margin placement needed anymore - it's a plain flex child of .hero__cta-row now. */
  :global(.hero__cta) {
    flex-shrink: 0;
  }

  .hero__scroll {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .hero__inner {
      /* Same fix as the mobile block below, for the same reason: the base rule's 100dvh space-between is a desktop-only ask (see the mobile comment), but this range never got the override — on a portrait tablet (820x1100 measured) it left a ~265px dead gap between the image/title and the role/intro/CTA block. */
      justify-content: flex-start;
    }

    .hero__image {
      grid-column: 4 / 9;
    }

    /* Hidden below desktop rather than repositioned - the collage overlap
                                                                         is tuned to the desktop image's own 5/9 column range; keeping it in
                                                                         sync with every other width's own image position isn't worth the
                                                                         complexity for a decorative secondary chip. */
    .hero__image-chip {
      display: none;
    }

    .hero__meta {
      grid-column: 9 / 13;
    }

    .hero__bottom {
      grid-template-columns: repeat(7, 1fr);
    }

    /* Same role -> status -> intro -> tools -> CTA row order as the base
                                               rule (unchanged here, just a wider column span) - only the column
                                               range needs overriding for the narrower 7-column grid.
                                               .hero__cta-row already spans 1 / -1 at every width, so it needs
                                               no override here. */
    .hero__role,
    .hero__status,
    .hero__intro,
    .hero__tools {
      grid-column: 1 / 8;
    }
  }

  /* Mobile redesign (taste-skill pass): the old layout put the meta cluster (year + tags) in flow above the image, which collided with "PORTFOLIO" rising up into it — the title's overlap has to land on the element directly before it, and that needs to be the image, not the tags. Fix is a real flex order, not a visual patch: image, then title overlapping it, then the (now-smaller) meta row underneath — "tags under the header image," per direct request, plus year moved down with them rather than left stranded on its own above. */
  @media (max-width: 639px) {
    .hero__inner {
      /* The 100dvh-filling space-between from the base rule is a desktop-only ask (the wireframe spec only calls out 100svh "on desktop") — at mobile it just stretched a short stack of content across the full viewport, leaving a dead gap before the bottom block. Flow naturally instead. */
      justify-content: flex-start;
    }

    .hero__visual {
      display: flex;
      flex-direction: column;
    }

    .hero__image {
      order: 1;
      align-self: center;
      width: 50%;
    }

    /* Same reasoning as the tablet range - hidden rather than
                                                                         repositioned for a decorative secondary chip. */
    .hero__image-chip {
      display: none;
    }

    .hero__title {
      order: 2;
    }

    .hero__meta {
      order: 3;
      align-self: stretch;
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: var(--space-24);
      margin-top: var(--space-16);
    }

    .hero__year {
      flex-direction: row;
      gap: 0.4em;
    }

    .hero__tags {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      /* Pushes the whole tag block to the row's right edge (matching the title's own right edge) while year stays left; justify-content then right-aligns the tags themselves once they wrap to a second line. */
      justify-content: flex-end;
      margin-left: auto;
      gap: var(--space-8);
    }

    /* Smaller, per direct request — a deliberate step below the locked 11-12px tag type-scale (PROJECT_BRIEF.md Section 3), mobile only. :global() because Tag.astro renders its own scoped element. */
    .hero__tags :global(.tag) {
      font-size: 10px;
    }

    .hero__bottom {
      /* Grid becomes irrelevant here - a plain block stack follows the
                                                                                         markup's own DOM order (role, status, intro, tools, CTA, scroll),
                                                                                         which is already the same role -> location -> paragraph -> tools
                                                                                         order the base rule's explicit grid-rows give every wider
                                                                                         breakpoint, so nothing here needs to re-specify row/column
                                                                                         placement the way it used to. */
      display: block;
      margin-top: var(--space-32);
    }

    /* Forces "to-be" onto its own line (display: block after inline text breaks the line, same as the nav "/" separator elsewhere in this project) instead of letting it wrap mid-word wherever the viewport happens to cut it off, and de-emphasizes it slightly against "Experience designer." */
    .hero__role-soft {
      display: block;
      margin-top: 0.15em;
      font-weight: 500;
      color: var(--color-text-secondary);
    }

    .hero__intro {
      max-width: none;
    }

    :global(.hero__cta) {
