---
// Section 01, straight under the hero: two questions, two educations, as a timeline. Its spine is the hero's signature:
// scrolling opens the tangle and the line drops out of the hero (desktop), straight down to here, where it carries on as
// a hand-drawn line that draws itself with the scroll, with a node where each degree sits and a bow at "and I want to
// answer both!". The tangle is the briefing; the straight line is it, detangled.
// Order is the order she lived it: marketing first, then the UX degree (the line reads as time: "Marketer to UX
// designer"), then the two together. Desktop: the title left of the line, the degrees and questions right of it. Phones:
// the line runs down the left edge, with its own sprout head, and everything sits right of it.

type Part = string | { word: string; tail?: string };

const columns: { parts: Part[]; approach: string; value: string }[] = [
  {
    parts: ['How do we make sure ', { word: 'people' }, ' ', { word: 'discover', tail: ' it?' }],
    approach: 'Bachelor in Marketing Communication (Cum Laude)',
    value:
      'Content strategy, persuasion, nudging, and understanding human behavior to bridge user needs with business goals.',
  },
  {
    parts: [
      'How do we ',
      {
        word: 'design',
      },
      ' an experience people actually ',
      {
        word: 'need',
        tail: '?',
      },
    ],
    approach: 'Devine (UX Major)',
    value:
      'Human-centered research, mapping user journeys, and prototyping interactions across physical and digital touchpoints.',
  },
];
---

<section class="sec why" aria-labelledby="why-how-title" data-why>
  <!-- The spine: decorative, drawn by the script (positions are measured from the page, so it holds at every width) -->
  <svg class="why__spine" aria-hidden="true" focusable="false" data-spine>
    <path class="why__line" data-spine-line fill="none"></path>
    <circle class="why__node" data-spine-node r="10"></circle>
    <circle class="why__node" data-spine-node r="10"></circle>
  </svg>

  <div class="container why__grid">
    <h2 id="why-how-title" class="sec-title why__title" data-reveal>
      Every company has 2 questions...
    </h2>

    <ol class="why__list">
      {columns.map((c) => (
        <li class="why__item">
          <p class="tag why__label" data-spine-label>{c.approach}</p>
          <h3 class="why__question" data-reveal>
            {c.parts.map((part) =>
              typeof part === 'string' ? (
                part
              ) : (
                <span class="why__nw">
                  <mark class="hl">{part.word}</mark>
                  {part.tail}
                </span>
              ),
            )}
          </h3>
          <p class="text why__answer" data-reveal>{c.value}</p>
        </li>
      ))}
      <li class="why__item why__item--close">
        <p class="why__close" data-reveal data-spine-end>
          and I want to <mark class="hl">answer both</mark>!
        </p>
      </li>
    </ol>
  </div>
</section>

<style>
  .why {
    position: relative;
  }

  .why__spine {
    position: absolute;
    top: 0;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
    max-width: none;
  }

  .why__line {
    stroke: var(--accent);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The dots are the case pages' dots: a hollow ring with a fine border; when the line reaches one it fills with the accent
     and swells a little before settling back (the same snap as the timeline on the project pages) */
  .why__node {
    fill: var(--bg-primary);
    stroke: var(--border-color);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 0.5s var(--ease-out),
      stroke 0.5s var(--ease-out);
  }

  .why__node.is-reached {
    fill: var(--accent);
    stroke: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .why__node.is-reached {
      animation: why-snap 0.7s linear;
    }
  }

  @keyframes why-snap {
    0% {
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    38% {
      transform: scale(1.55);
      animation-timing-function: cubic-bezier(0.5, 0, 0.2, 1);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Same weight as the hero's line once it is settled */
  @media (min-width: 700px) {
    .why__line {
      stroke-width: 6;
    }

  }

  @media (min-width: 1000px) {
    .why__line {
      stroke-width: 8;
    }
  }

  /* The ragged, grainy edge the hero's line has (not on touch) */
  @media (hover: hover) {
    .why__spine {
      filter: url(#sand-edge);
    }
  }

  .why__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* Phones and tablets: the line hugs the left edge, and the text keeps clear of it */
    padding-left: calc(var(--page-margin) + 3rem);
  }

  .why__title {
    max-width: 14ch;
  }

  .why__list {
    display: grid;
    margin-top: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .why__item {
    padding-block: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
  }

  .why__label {
    margin-bottom: 0.9rem;
    padding-block: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .why__question {
    max-width: 16ch;
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.75rem);
    font-weight: var(--weight-bold);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  /* Nowrap keeps the question mark with its word */
  .why__nw {
    white-space: nowrap;
  }

  .why__answer {
    max-width: 46ch;
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .why__item--close {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    padding-bottom: 0;
  }

  .why__close {
    max-width: 12ch;
    font-size: clamp(2.25rem, 1rem + 4.4vw, 5.25rem);
    font-weight: var(--weight-heavy);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* Desktop: the line is a rail. The title sits left of it; the degrees, questions and the closing line start right of it.
     --rail (the line's distance from the content edge) is measured by the script from the hero's settled line; half the
     container is the no-script fallback. */
  @media (min-width: 1000px) {
    .why__grid {
      grid-template-columns: var(--rail, 50%) minmax(0, 1fr);
      padding-left: var(--page-margin);
    }

    .why__title {
      grid-column: 1;
      padding-right: 3rem;
      max-width: 9ch;
      font-size: clamp(3rem, 1rem + 5.4vw, 7rem);
      line-height: 0.93;
      letter-spacing: -0.04em;
      box-sizing: content-box;
    }

    .why__list {
      grid-column: 2;
      margin-top: 0;
      padding-left: 3rem;
    }

    .why__item:first-child {
      padding-top: 0;
    }

    .why__item--close {
      padding-top: clamp(3rem, 2rem + 5vw, 7rem);
    }

    .why__close {
      max-width: 13ch;
      font-size: clamp(2.75rem, 1rem + 4.8vw, 6rem);
      line-height: 0.95;
    }
  }
</style>

<script>
  // The spine. On desktop it continues the hero's settled line (--spine-vx) from the top of this section down to a bow
  // tied by the closing line, with a node on each degree; it draws itself as the section scrolls into view. On phones it
  // runs down the left edge and begins with its own small sprout head. Reduced motion: fully drawn. No script: absent
  // (it is decoration; the section reads without it).
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('[data-why]');
  const svg = section?.querySelector<SVGSVGElement>('[data-spine]');
  const line = svg?.querySelector<SVGPathElement>('[data-spine-line]');
  const nodes = svg ? Array.from(svg.querySelectorAll<SVGCircleElement>('[data-spine-node]')) : [];
  const labels = section ? Array.from(section.querySelectorAll<HTMLElement>('[data-spine-label]')) : [];
  const end = section?.querySelector<HTMLElement>('[data-spine-end]');
  const grid = section?.querySelector<HTMLElement>('.why__grid');

  const W = 260; // width of the drawing, centred on the line
  let tl: gsap.core.Timeline | null = null;

  function build() {
    if (!section || !svg || !line || !grid || !end || labels.length < nodes.length) return;
    tl?.scrollTrigger?.kill();
    tl?.kill();
    tl = null;

    const wide = window.matchMedia('(min-width: 1000px)').matches;
    const published = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--spine-vx'),
    );
    const sr0 = section.getBoundingClientRect();
    const gr0 = grid.getBoundingClientRect();
    const contentLeft = gr0.left - sr0.left + parseFloat(getComputedStyle(grid).paddingLeft);
    const hasHero = wide && Number.isFinite(published);
    // Where the line runs, from the section's left edge
    const x = hasHero ? published - sr0.left : gr0.left - sr0.left + 16;
    section.style.setProperty('--rail', hasHero ? `${x - contentLeft}px` : '');

    // Layout has moved with --rail: measure the nodes and the bow now
    const sr = section.getBoundingClientRect();
    const centreOf = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const cs = getComputedStyle(el);
      const lh = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.2;
      return r.top - sr.top + (parseFloat(cs.paddingTop) || 0) + lh / 2;
    };
    const ys = labels.slice(0, nodes.length).map((l) => centreOf(l));
    const bowY = centreOf(end) - 4;
    const height = sr.height;

    // The drawing reaches up through the section's top padding, so it meets the hero's line without a gap
    const lift = hasHero ? parseFloat(getComputedStyle(section).paddingTop) || 0 : 0;
    svg.setAttribute('width', String(W));
    svg.setAttribute('height', String(height + lift));
    svg.setAttribute('viewBox', `0 ${-lift} ${W} ${height + lift}`);
    svg.style.left = `${x - W / 2}px`;
    svg.style.top = `${-lift}px`;
    const cx = W / 2;
    const b = bowY - 36;

    // [phones: the sprout's head, so the line begins with the same hand] + stem + bow
    let d = '';
    let headLen = 0;
    if (!hasHero) {
      // Phones: the line comes in from the left edge of the screen (it left the hero the same way), curls down and runs
      // along the left margin
      const edge = cx - (gr0.left - sr0.left + 16) - 30;
      d = `M ${edge} 6 C ${edge + 50} 4, ${cx - 6} 22, ${cx} 70 L ${cx} ${b}`;
      headLen = 80;
    } else {
      d = `M ${cx} ${-lift} L ${cx} ${b}`;
    }
    // The bow swings right on phones (the line hugs the left edge), left on desktop
    const m = hasHero ? -1 : 1;
    d += ` C ${cx} ${b + 30}, ${cx + m * 30} ${b + 44}, ${cx + m * 42} ${b + 28} C ${cx + m * 54} ${b + 10}, ${cx + m * 22} ${b - 6}, ${cx + m * 8} ${b + 22} C ${cx} ${b + 40}, ${cx - m * 4} ${b + 66}, ${cx - m * 36} ${b + 74}`;
    line.setAttribute('d', d);

    const len = line.getTotalLength();
    nodes.forEach((n, i) => {
      n.setAttribute('cx', String(cx));
      n.setAttribute('cy', String(ys[i]));
    });

    nodes.forEach((n) => n.classList.remove('is-reached'));
    if (prefersReducedMotion()) {
      line.style.strokeDasharray = 'none';
      line.style.strokeDashoffset = '0';
      nodes.forEach((n) => n.classList.add('is-reached'));
      return;
    }

    line.style.strokeDasharray = String(len);
    line.style.strokeDashoffset = String(len);

    tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: section,
        // With the hero's line arriving from above, draw from the moment the section is in view; on phones the line is
        // all here, so wait for the section to open
        start: hasHero ? 'top 95%' : 'top 85%',
        end: () => `+=${bowY + window.innerHeight * 0.3}`,
        scrub: 0.6,
        invalidateOnRefresh: true,
        // A dot lights up as the line's tip passes it, and goes back to a ring if the visitor scrolls up past it
        onUpdate: (self) => {
          const tip = self.progress * len;
          nodes.forEach((n, i) => n.classList.toggle('is-reached', tip >= headLen + ys[i]));
        },
      },
    });
    tl.to(line, { strokeDashoffset: 0, duration: 1 }, 0);
  }

  if (section) {
    build();
    // The hero publishes the line's position after layout and on every resize
    document.addEventListener('spine:update', build);
    let raf = 0;
    window.addEventListener(
      'resize',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(build);
      },
      { passive: true },
    );
    document.fonts?.ready.then(() => {
      build();
      ScrollTrigger.refresh();
    });
  }
</script>
