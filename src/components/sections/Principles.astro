---
// Homepage "3 design principles," between Selected Work and Gallery - per
// direct request, in "a really subtle fashion." Body copy is the same
// three sentences as About's own "How I work" section (AboutProcess.astro)
// - reused verbatim rather than rewritten, per this project's own "no
// fabricated copy" rule. Each item's short title is reused too, from the
// homepage's former "How I think" section (HowIThink.astro, now removed
// per direct request - "add the titles from the last section... to the 3
// design principles" then "remove the how I think section... i do not
// need it anymore") - "Understand before designing" / "Creative, but
// defendable" / "Make it make sense", paired in order with the three
// process sentences rather than re-authored.
//
// Now carries a real numbered kicker ("( 02 ) My design principles",
// exact text per direct request) instead of the plain unnumbered
// "Approach" label the first version used - the section is a peer to the
// other numbered sections now, not deliberately outside that rhythm.
// Still kept in the small mono kicker style rather than promoted to a
// full SectionMarker h2, though: Barlow Condensed is this page's
// one-headline-anchor type (PROJECT_BRIEF.md Section 3), already spent
// on Hero's "PORTFOLIO", and a second big display headline here would
// compete with it rather than stay the quiet aside this was asked to be.
//
// Numbering: Selected Work is "01" and this is "02" per the exact text
// requested, with Gallery unchanged at "03" - a clean ascending read.
// Currently Working On sits physically between Selected Work and this
// section on the page ("directly below the selected works", a separate
// direct request), but dropped its own number in the move rather than
// claiming "02" itself and pushing this one to "03" - see that file's
// own comment and SectionMarker.astro's now-optional `index` prop.
const principles = [
  {
    title: 'Understand before designing',
    text: 'Paper, whiteboards, sticky notes, messy diagrams: anything that lets ideas move faster than my concern for how they look.',
  },
  {
    title: 'Creative, but defendable',
    text: "I especially enjoy collaborative ideation: getting different perspectives in the room, throwing ideas around, combining them and challenging each other's assumptions.",
  },
  {
    title: 'Make it make sense',
    text: 'Once the messy thinking starts to make sense, I move into digital tools and prototypes.',
  },
];
---

<section class="principles">
  <div class="principles__inner">
    <p class="principles__kicker">
      <span aria-hidden="true">( 02 )</span>
      My design principles
    </p>

    <ul class="principles__list">
      {principles.map((item) => (
        <li class="principles__item">
          <h3 class="principles__title">{item.title}</h3>
          <p class="principles__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.principles');
  if (section && !prefersReducedMotion()) {
    // One plain, quiet fade/rise for the whole block - no stagger, no
    // per-element choreography. This section's entire point is to not
    // draw attention to itself, so it gets the single stillest reveal on
    // the homepage rather than a scaled-down version of a louder one.
    gsap.set(section, { autoAlpha: 0, y: 16 });
    gsap.to(section, {
      autoAlpha: 1,
      y: 0,
      duration: 0.7,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 92%' },
    });
  }
</script>

<style>
  /* Roughly a third of the sitewide --space-section (140px) - a quiet
     aside reads as one if it takes up noticeably less room than the
     numbered sections around it, not just a different color/type. */
  .principles {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .principles__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .principles__kicker {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .principles__list {
    margin-top: var(--space-24);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
  }

  .principles__item {
    padding-left: var(--space-24);
    /* A hairline divider between columns, not a border/background per
                 item - the same "fine print" register as the kicker above, not a
                 card. Only items after the first get one, so the row doesn't open
                 with a stray rule before any content. */
    border-left: var(--border-hairline) solid var(--color-text-secondary);
  }

  .principles__item:first-child {
    padding-left: 0;
    border-left: none;
  }

  .principles__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-nav);
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .principles__text {
    margin-top: var(--space-8);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .principles__list {
      grid-template-columns: 1fr;
      gap: var(--space-16);
    }

    /* Horizontal dividers instead of vertical ones once the columns
                 stack - the same device rotated 90 degrees rather than a
                 different one. */
    .principles__item {
      padding-left: 0;
      padding-top: var(--space-16);
      border-left: none;
      border-top: var(--border-hairline) solid var(--color-text-secondary);
    }

    .principles__item:first-child {
      padding-top: 0;
      border-top: none;
    }
  }

  @media (max-width: 640px) {
    .principles__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
