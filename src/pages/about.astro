---
// About: the same rhythm as the homepage. Hero, then ruled-free sections with a label and a title
// (journey, toolkit, background, off the clock), and a closing step.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import AboutManifesto from '../components/sections/AboutManifesto.astro';
import AboutStory from '../components/sections/AboutStory.astro';
import AboutProse from '../components/sections/AboutProse.astro';
import AboutLedger from '../components/sections/AboutLedger.astro';
import AboutClosing from '../components/sections/AboutClosing.astro';
import ContentsNav from '../components/ContentsNav.astro';
import Footer from '../components/layout/Footer.astro';

const offClock = [
  'Outside of work, I’m walking my dog, Lemmy, baking something, or watching a funny show. I’ve played The Sims since I was ten, so designing little worlds has been a habit for a while.',
];

const contents = [
  { slug: 'story-title', text: 'The journey' },
  { slug: 'toolkit-title', text: 'Toolkit' },
  { slug: 'offclock-title', text: 'Off the clock' },
  { slug: 'background-title', text: 'Background' },
];

const toolkit = [
  {
    title: 'Skills',
    rows: [
      {
        label: 'UX & Research',
        items: 'User interviews, wireframing, prototyping, user testing, UI design, data analysis',
      },
      { label: 'Visual', items: 'Brand identity, campaign design, motion, 3D' },
      {
        label: 'Marketing & Communication',
        items: 'Content strategy, copywriting, persuasion & nudging, workshop facilitation',
      },
    ],
  },
  {
    title: 'Tools',
    rows: [
      { label: 'Design', items: 'Figma, Photoshop, Illustrator, After Effects, Blender' },
      { label: 'Research & code', items: 'SPSS, VS Code' },
    ],
  },
];

const background = [
  {
    rows: [
      {
        label: 'Digital Design & Development (Devine)',
        items: 'Howest Kortrijk, since 2024. Major in UX design.',
      },
      {
        label: 'Bachelor in Marketing Communication',
        items:
          'Cum laude. Thesis: how do you get colleagues to actually contribute to the internal newsletter? Researched through Cialdini’s principles of persuasion and nudging.',
      },
      {
        label: 'Marketing & Communication Intern, CAW Oost-Vlaanderen',
        items:
          'Planned content and created social media posts for key dates, wrote letters to policy makers across Belgium, and led a workshop on my own to restructure the new website’s content.',
      },
    ],
  },
];
---

<BaseLayout
  title="About | Laura Doolaege"
  description="About Laura Doolaege: UX design student at Howest, with a marketing communication background, looking for an internship from February 2027."
>
  <div class="page">
    <Header />
    <main id="main">
      <AboutManifesto />
      <div class="container about">
        <nav class="about__chips" aria-label="Sections">
          {contents.map((c) => (
            <a href={`#${c.slug}`}>{c.text}</a>
          ))}
        </nav>
        <div class="about__rail">
          <ContentsNav items={contents} />
        </div>
        <div class="about__main">
          <AboutStory />
          <AboutLedger
            id="toolkit-title"
            label="Toolkit"
            title="What I work with"
            groups={toolkit}
          />
          <AboutProse
            id="offclock-title"
            label="Beyond the work"
            title="Off the clock"
            paragraphs={offClock}
          />
          <AboutLedger
            id="background-title"
            label="Background"
            title="Where I’ve been"
            groups={background}
          />
        </div>
      </div>
      <AboutClosing />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  /* Same shape as the case pages: contents list left (sticky), the sections right. The sections bring their own
     .container, so inside this column it drops its side padding. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .about__main {
    min-width: 0;
  }

  .about__main :global(.container) {
    padding-inline: 0;
  }

  .about__main :global(.sec-title) {
    scroll-margin-top: 8rem;
  }

  /* Below the desktop rail the sections stack, so a hairline opens each one: a clear beat to scroll by */
  @media (max-width: 999px) {
    .about__main :global(.sec ~ .sec > .container) {
      padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
      border-top: var(--hairline);
    }

    .about__main :global(.sec ~ .sec) {
      padding-top: 0;
    }
  }

  /* The contents list ends with the last section, not with the closing step below the grid */
  .about__main :global(.sec:last-child) {
    padding-bottom: 0;
  }

  .about__rail {
    display: none;
  }

  /* Tablets and large phones have no sticky list, so the sections get a short row of anchors under the hero */
  .about__chips {
    display: none;
  }

  @media (min-width: 700px) and (max-width: 999px) {
    .about__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.75rem;
      padding-block: 1rem;
      border-block: var(--hairline);
    }

    .about__chips a {
      font-size: 0.875rem;
      color: var(--text-muted);
      transition: color 0.4s var(--ease-out);
    }

    .about__chips a:hover,
    .about__chips a:focus-visible {
      color: var(--text-main);
    }
  }

  @media (min-width: 1000px) {
    /* Rests level with the first section's label (same top padding as .sec) and sticks from there */
    .about__rail {
      display: block;
      padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
    }

    .about {
      grid-template-columns: 15rem minmax(0, 1fr);
      column-gap: clamp(3rem, 2rem + 5vw, 8rem);
    }
  }

  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>

<script>
  import '../scripts/reveal';
</script>
