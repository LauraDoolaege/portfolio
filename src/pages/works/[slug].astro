---
// Project detail page. Two layouts from one template, chosen by the entry's `type`:
// "ux" = editorial article (65ch reading column, images break out to full width)
// "visual" = gallery / lookbook (short punchy text column, edge-to-edge images)
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Button from '../../components/ui/Button.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import Gallery from '../../components/Gallery.astro';
import ContentsNav from '../../components/ContentsNav.astro';
import Lightbox from '../../components/Lightbox.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort((a, b) => a.id.localeCompare(b.id));
  return works.map((entry, i) => ({
    params: { slug: entry.id },
    // "More work": the three projects after this one, wrapping around, never this one
    props: { entry, more: [1, 2, 3].map((n) => works[(i + n) % works.length]) },
  }));
}

const { entry, more } = Astro.props;
const { Content, headings } = await render(entry);
const {
  title,
  description,
  type,
  coverImage,
  role,
  timeline,
  tools,
  team,
  behanceUrl,
  facts,
  hook,
  tags,
} = entry.data;
const isCase = Boolean(facts);
const isGallery = type === 'visual' && Boolean(hook);
// Contents list: the h2s of the article
const contents = headings.filter((h) => h.depth === 2);

const meta = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Tools', value: tools.join(', ') },
  ...(team?.length ? [{ label: 'Team', value: team.join(', ') }] : []),
];
const caseFacts = facts
  ? [
      { label: 'Role', value: role },
      { label: 'Scope', value: facts.scope },
      { label: 'Context', value: facts.context },
    ]
  : [];
---

<BaseLayout title={`${title} | Laura Doolaege`} description={description}>
  <div class="page">
    <Header />
    <main id="main" class={`work-page work-page--${type}`}>
      <div class="container">
        <Button class="back" variant="link" size="sm" icon="left" href={`${withBase('/')}#work`}>
          Back to works
        </Button>
      </div>

      {isGallery ? (
        <>
          <div class="container">
            <header class="vhead">
              <h1 class="vhead__title">{title}</h1>
              {tags && (
                <ul class="vhead__tags" aria-label="Disciplines">
                  {tags.map((t) => (
                    <li class="vhead__tag tag">{t}</li>
                  ))}
                </ul>
              )}
              <p class="vhead__hook">{hook}</p>
            </header>
          </div>
          <div class="container vbody">
            <Content />
          </div>
        </>
      ) : isCase ? (
        <>
          <div class="container">
            <header class="chead">
              <h1 class="hero__title">{title}</h1>
              <p class="hero__description subtitle">{description}</p>
            </header>
            <dl class="facts">
              {caseFacts.map((m) => (
                <div class="facts__item">
                  <dt class="facts__label tag">{m.label}</dt>
                  <dd class="facts__value text">{m.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="container case">
            <ContentsNav items={contents} />
            <article class="case__main prose-case">
              <Content />
            </article>
          </div>
        </>
      ) : (
        <>
          <div class="container">
            <div class="cover">
              <ProjectImage
                src={coverImage}
                alt={`${title}: cover`}
                ratio={coverImage ? undefined : type === 'ux' ? '2 / 1' : '16 / 9'}
                tone={type === 'ux' ? 1 : 0}
                loading="eager"
              />
            </div>

            <header class="hero">
              <h1 class="hero__title">{title}</h1>
              <p class="hero__description subtitle">{description}</p>
            </header>

            <dl class="meta">
              {meta.map((m) => (
                <div class="meta__row">
                  <dt class="meta__label tag">{m.label}</dt>
                  <dd class="meta__value text">{m.value}</dd>
                </div>
              ))}
            </dl>

            {behanceUrl && (
              <Button
                class="behance-btn"
                href={behanceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View full Behance case study
              </Button>
            )}
          </div>

          <div
            class:list={[
              'container prose',
              `prose--${type}`,
              { 'gallery-inset': type === 'visual' },
            ]}
          >
            <Content />
          </div>
        </>
      )}

      {behanceUrl && (
        <section class="container closing" aria-label="Full case study">
          <p class="closing__text subtitle">The full process, from research to final screens.</p>
          <Button href={behanceUrl} target="_blank" rel="noopener noreferrer">
            Full Behance Case Study
          </Button>
        </section>
      )}

      <section class="more container" aria-labelledby="more-label">
        <h2 id="more-label" class="more__label tag">
          More Work
        </h2>
        <ul class="more__grid">
          {more.map((w) => (
            <li class="more__item">
              <a class="card more__card" href={withBase(`/works/${w.id}`)}>
                <div data-cursor>
                  <ProjectImage
                    src={w.data.coverImage}
                    alt={`${w.data.title}: cover`}
                    ratio="4 / 3"
                    tone={(w.data.type === 'ux' ? 1 : 2) as 1 | 2}
                  />
                </div>
                <h3 class="more__title">{w.data.title}</h3>
                <p class="more__type tag">
                  {w.data.type === 'ux' ? 'UX Strategy' : 'Visual Exploration'}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <Lightbox />
    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .work-page {
    flex: 1;
  }

  :global(.back) {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* The golden frame: left-aligned with the title, capped width */
  .cover {
    width: min(1200px, 80vw);
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* Hero: title, then a light, readable intro */
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(2.5rem, 1.5rem + 5vw, 6rem);
  }

  .hero__title {
    max-width: 12ch;
    overflow-wrap: break-word;
  }

  .hero__description {
    max-width: 50ch;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* Meta grid: horizontal rules only, no vertical boxing */
  .meta {
    margin: 0;
    border-bottom: var(--hairline);
  }

  .meta__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    padding-block: 1.25rem;
    border-top: var(--hairline);
  }

  .meta__label {
    justify-self: start;
    align-self: start;
  }

  .meta__value {
    margin: 0;
    max-width: 50ch;
  }

  /* Body: a flex column so every block sets its own width and alignment */
  .prose {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
    padding-block: clamp(4rem, 2rem + 8vw, 9rem);
  }

  .prose :global(h2:not(.tag)) {
    margin-top: clamp(2rem, 1rem + 5vw, 6rem);
    font-size: var(--text-h2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    text-wrap: pretty;
  }

  /* Editorial article: one centered reading column (65ch, large type), images and pull quotes break out to the full container */
  .prose--ux > :global(:not(.project-figure):not(.audit):not(.pullquote)) {
    width: 100%;
    max-width: 65ch;
    margin-inline: auto;
  }

  .prose--ux > :global(p) {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    font-weight: var(--weight-light);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .prose--ux :global(strong) {
    font-weight: var(--weight-bold);
  }

  .prose--ux > :global(.project-figure) {
    margin-block: clamp(1.5rem, 1rem + 3vw, 4rem);
  }

  /* Gallery / lookbook: short, light text pushed right; images sit in a contained, padded column.
     .gallery-inset (below) holds the column to 1200px with generous side room. */
  .prose--visual {
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .prose--visual > :global(:not(.project-figure):not(.image-grid):not(.audit):not(.pullquote)) {
    max-width: 34ch;
  }

  .prose--visual > :global(p) {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: var(--weight-light);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .prose--visual > :global(.project-figure),
  .prose--visual > :global(.image-grid) {
    margin-block: clamp(1rem, 0.5rem + 2vw, 3rem);
  }

  .gallery-inset {
    padding-inline: max(
      calc(var(--page-margin) + 4vw),
      calc((min(100vw, var(--page-max)) - 1200px) / 2)
    );
  }

  @media (min-width: 900px) {
    .prose--visual > :global(:not(.project-figure):not(.image-grid):not(.audit):not(.pullquote)) {
      margin-left: 41.666%;
    }

    .meta__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    .meta__label {
      grid-column: 1 / span 3;
    }

    .meta__value {
      grid-column: 4 / -1;
    }
  }

  /* Behance button under the meta grid: the shared .btn, just spaced from the meta rules */
  :global(.behance-btn) {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  /* ---------- Visual project (gallery) layout ---------- */

  /* Minimal, bold header: title, the disciplines, one hook sentence. Nothing else. */
  .vhead {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0;
  }

  .vhead__title {
    max-width: 14ch;
    font-size: clamp(3rem, 1.5rem + 7vw, 8rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .vhead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .vhead__tag {
    color: var(--text-muted);
  }

  .vhead__hook {
    max-width: 30ch;
    margin-top: clamp(2rem, 1.5rem + 3vw, 4rem);
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.5rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }

  /* Optional short text block above the gallery: at most two brief paragraphs, set to the right on
     desktop (columns 5-12 of the same grid the gallery uses) and full width on phones */
  .vbody > :global(p) {
    max-width: 52ch;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    font-size: var(--text-paragraph);
    font-weight: var(--weight-light);
    line-height: var(--leading-paragraph);
    text-wrap: pretty;
  }

  .vbody > :global(p + p) {
    margin-top: 1.1em;
  }

  @media (min-width: 900px) {
    .vbody > :global(p) {
      margin-left: 33.333%;
    }
  }

  /* ---------- Case-study layout ---------- */

  /* Compact header: title, one intro line, then three facts on a hairline. No hero image. */
  .chead {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding-block: 1.5rem;
    border-block: var(--hairline);
  }

  .facts__label {
    color: var(--text-muted);
  }

  .facts__value {
    margin: 0.3rem 0 0;
  }

  /* Contents list left (sticky), reading column right */
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2rem, 1rem + 3vw, 4rem);
  }

  .case__main {
    min-width: 0;
    max-width: 44rem;
  }

  @media (min-width: 700px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }
  }

  @media (min-width: 1000px) {
    .case {
      grid-template-columns: 15rem minmax(0, 1fr);
      column-gap: clamp(3rem, 2rem + 5vw, 8rem);
    }
  }

  /* Article typography (markdown from the .mdx): headings are the contents list's anchors */
  .case__main :global(h2) {
    scroll-margin-top: 6rem;
    margin-top: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    font-size: var(--text-title);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    text-wrap: balance;
  }

  .case__main :global(h2:first-child) {
    margin-top: 0;
  }

  .case__main :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .case__main :global(h2 + p),
  .case__main :global(h2 + h3) {
    margin-top: 1.5rem;
  }

  .case__main :global(p) {
    max-width: 62ch;
    font-size: var(--text-paragraph);
    font-weight: var(--weight-light);
    line-height: var(--leading-paragraph);
    text-wrap: pretty;
  }

  .case__main :global(p + p) {
    margin-top: 0.9em;
  }

  /* Closing CTA: a hairline, one line, one button. Same Button as the hero, nothing louder. */
  .closing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: clamp(1rem, 0.5rem + 2vw, 3rem);
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem);
    border-top: var(--hairline);
  }

  .closing__text {
    max-width: 40ch;
  }

  @media (min-width: 700px) {
    .closing {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* More work: a de-boxed lookbook row. The middle card drops, as on the homepage. */
  .more {
    padding-block: clamp(3rem, 1.5rem + 5vw, 7rem) clamp(5rem, 3rem + 8vw, 10rem);
  }

  .more__label {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .more__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--grid-gutter);
  }

  .more__card {
    display: block;
  }

  .more__title {
    margin-top: 1rem;
    transition: color 0.5s var(--ease-out);
  }

  .more__card:hover .more__title,
  .more__card:focus-visible .more__title {
    color: var(--accent-text);
  }

  .more__type {
    margin-top: 0.6rem;
  }

  @media (min-width: 900px) {
    .more__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .more__item:nth-child(2) {
      margin-top: clamp(2rem, 1rem + 4vw, 5rem);
    }
  }
</style>
