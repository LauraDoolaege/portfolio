---
// Button system (supersedes the original PROJECT_BRIEF.md Section 3 "solid
// ink pill for primary actions" rule — see CLAUDE.md "Tech stack" for the
// documented revision). Two roles:
// - primary: hairline-bordered ink/charcoal box, fill sweeps in on
//   hover/focus. No bracket glyphs — the box itself is the affordance.
// - secondary: unchanged — a quiet underline text link.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  icon?: 'download' | 'arrow';
  class?: string;
}

const { href, variant = 'primary', icon, class: className } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]}>
  <span class="btn__label">
    <slot />
  </span>
  {icon === 'download' && (
    <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M8 2.5V10M8 10L4.75 6.75M8 10L11.25 6.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M3 13H13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'arrow' && (
    <svg class="btn__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M3 8H13M13 8L9.25 4.25M13 8L9.25 11.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 500;
    transition: color var(--motion-duration) var(--motion-easing);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Primary: hairline ink box, fill sweeps in on hover. */
  .btn--primary {
    position: relative;
    z-index: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    border: var(--border-hairline) solid var(--color-ink);
    border-radius: 0;
    padding: 0.75em 1.1em;
  }

  .btn--primary > * {
    position: relative;
    z-index: 1;
  }

  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-duration-slow) var(--motion-easing);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    color: var(--color-bg-primary);
  }

  .btn--primary:hover::before,
  .btn--primary:focus-visible::before {
    transform: scaleX(1);
  }

  .btn--primary:active {
    transform: scale(0.98);
  }

  .btn__icon {
    width: 0.9em;
    height: 0.9em;
  }

  /* Secondary: quiet underline text link — unchanged. */
  .btn--secondary {
    padding-block: 0.2em;
    font-family: var(--font-body);
    font-size: var(--text-nav);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border-bottom: var(--border-hairline) solid currentColor;
    color: var(--color-ink);
  }

  .btn--secondary:hover {
    color: var(--color-accent);
  }
</style>
