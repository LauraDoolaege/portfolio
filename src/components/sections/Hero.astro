---
// Homepage hero (PROJECT_BRIEF.md Section 5 "Homepage — LOCKED", item 1).
// Content is final per the brief (Section 6), not placeholder.
//
// The two-line name (diagonally offset, image placeholder behind it) is
// the brief's locked "object replacing/interrupting a letterform" device
// (Section 3 "Other locked tokens") — this is the page's one sanctioned
// "surprise" (Section 3, principle 2), so nothing else on this page
// should introduce another one.
//
// Open decisions this component had to fill in (not locked anywhere —
// see CLAUDE.md "Open decisions"):
// - Mobile type scale: the brief leaves this undefined (Section 8). The
//   hero name uses a fluid clamp() rather than the fixed 96px desktop
//   token, since 96px literally overflows a phone viewport. Revisit
//   once a real mobile type scale is locked.
// - "Get to know me" target: linked to /about (no target was specified).
// - Vertical rhythm below the name (role/intro/CTA/tags) uses a small
//   local scale (1rem / 1.5rem / 2rem / 3rem) rather than one-off values,
//   so the spacing reads as deliberate rather than picked by eye.
import { withBase } from '../../utils/url';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__name-block">
      <span class="hero__name-image">
        <!-- TODO: replace with a real photo (see PROJECT_BRIEF.md Section 6 — no photography exists yet) -->
      </span>
      <h1 class="hero__name">
        <span class="sr-only">Laura Doolaege</span>
        <span class="hero__name-visual" aria-hidden="true">
          <span class="hero__name-first">Laura</span>
          <span class="hero__name-last">Doolaege</span>
        </span>
      </h1>
    </div>

    <p class="hero__role">Experience designer to-be</p>

    <p class="hero__intro">
      I'm Laura, a digital development &amp; design student with a background in marketing
      communication, currently specialising in user experience design.
    </p>

    <Button href={withBase('/about')} variant="primary" icon="arrow" class="hero__cta">
      Get to know me
    </Button>

    <ul class="hero__tags">
      <li>
        <Tag>UX / Experience Design</Tag>
      </li>
      <li>
        <Tag>Digital Design</Tag>
      </li>
      <li>
        <Tag>Motion Design</Tag>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: 3rem var(--space-section);
  }

  .hero__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  /* Shared font-size context: the image and both name lines size off
     this, so the whole composition scales together as one fluid unit
     instead of needing separate mobile-only overrides. */
  .hero__name-block {
    position: relative;
    font-size: clamp(2.75rem, 6vw + 1.5rem, var(--text-h1));
  }

  .hero__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: inherit;
    line-height: var(--text-h1-leading);
    text-transform: uppercase;
    /* Tighter than body-scale tracking — extreme scale contrast and tight negative tracking are the "hard mechanical" macro-type move, applied here without going as extreme as a literal brutalist reference would (this is still an editorial brand). */
    letter-spacing: -0.02em;
  }

  .hero__name-visual {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .hero__name-first {
    font-size: 0.42em;
  }

  .hero__name-last {
    font-size: 1em;
    /* Explicit offsets, not align-self — a shrink-to-fit flex column is exactly as wide as its widest line, so align-self: flex-end has no room to actually shift anything. */
    margin-top: 0.18em;
    margin-left: 1em;
  }

  .hero__name-image {
    position: absolute;
    top: 0.5em;
    left: 0.1em;
    width: 2.1em;
    height: 1.05em;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    border-radius: var(--radius-image);
    z-index: 0;
  }

  .hero__role {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
  }

  .hero__intro {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  .hero__cta {
    margin-top: 2rem;
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
  }

  /* Everything below scales together via the shared em context on
     .hero__name-block, so no separate mobile override is needed for
     the name composition itself — verified at 1440px down to 320px. */
</style>
