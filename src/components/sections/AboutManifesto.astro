---
// About hero: no boxes, just fluid typography. One big, heavy greeting.
---

<section class="manifesto-hero" aria-labelledby="about-title">
  <div class="container">
    <h1 id="about-title" class="manifesto-hero__title">
      <span class="mask">
        <span class="line line--heavy">Hi, I’m Laura.</span>
      </span>
    </h1>
    <p class="manifesto-hero__sub">
      UX design student. Looking for an internship from February 2027.
    </p>
  </div>
</section>

<style>
  /* The sections below bring their own top padding, so the hero only needs a short tail */
  .manifesto-hero {
    padding-block: clamp(3rem, 2rem + 6vw, 9rem) clamp(1rem, 0.5rem + 2vw, 3rem);
  }

  .manifesto-hero__title {
    max-width: 16em;
    font-size: clamp(2.75rem, 1rem + 7vw, 8.5rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .manifesto-hero__sub {
    max-width: 34ch;
    margin-top: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.875rem);
    font-weight: var(--weight-light);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .mask {
    display: block;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .mask + .mask {
    margin-top: 0.15em;
  }

  .line {
    display: block;
  }

  .line--heavy {
    font-weight: var(--weight-heavy);
  }
</style>

<script>
  import { prefersReducedMotion } from '../../utils/motion';
  import { fadeUp, hideForFadeUp } from '../../utils/reveal';

  const items = Array.from(
    document.querySelectorAll<HTMLElement>('.manifesto-hero .line, .manifesto-hero__sub'),
  );

  // The same rise and fade as everything else, on load because this sits at the top of the page
  if (items.length && !prefersReducedMotion()) {
    hideForFadeUp(items);
    fadeUp(items, 0.1);
  }
</script>
