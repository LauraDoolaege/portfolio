---
// About page opening (PROJECT_BRIEF.md Section 4/5 "About page structure -
// LOCKED", item 1: "Intro restating specialization and current focus, CV
// download"). Copy is final, supplied directly by the user.
//
// This page's one oversized type anchor (Section 3 principle 1: "let one
// oversized type statement anchor every page") is the "About" headline -
// a plain solid-ink word, deliberately NOT reusing Hero's edge-to-edge cqw
// sizing or its object-in-letterform/mix-blend-mode device. That device is
// scoped to the homepage hero as a signature move; repeating it here would
// dilute it into a template trick instead of a one-time moment.
//
// The footnote card is this page's one terracotta "wink" (Section 3
// palette table - locked per-composition, not per-site: the homepage
// already spent its own wink on the "Currently working on" asterisk, but
// this is a different composition and gets its own). It reuses the user's
// own aside almost verbatim - a small rotated note sitting beside the
// intro paragraph, styled like something actually pinned there.
//
// Brutalist-structure pass (explicit request, About-only scope - see
// AGENTS.md "About page" section): the "( 01 )" plate mark, sharp card
// corners, and harder headline reveal below are this page's own addition,
// borrowing the industrial-brutalist skill's grid discipline and type
// contrast without touching the locked palette/type families or any
// shared component - nothing here changes what Header, Footer, or the
// homepage look like.
//
// Redesign pass (explicit request - "upgrade the about page... really
// give it that extra awwwards feel... add more image placeholders"):
// this section was pure type before, no imagery at all. A single portrait
// placeholder now sits beside the intro text, tilted a couple of degrees
// like a print pinned to a board - the same "placed by hand" language the
// footnote card already established, not a new device. Still not Hero's
// object-in-letterform move - that stays homepage-only (see above).
import { withBase } from '../../utils/url';
import Button from '../ui/Button.astro';

// TODO: replace href="#" with the real CV PDF path once supplied
// (PROJECT_BRIEF.md Section 6), same placeholder pattern as Header's CV button.
const cvHref = '#';
---

<section class="about-intro">
  <div class="about-intro__inner">
    <a href={withBase('/')} class="about-intro__back">
      <svg class="about-intro__back-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M13 8H3M3 8L6.75 4.25M3 8L6.75 11.75"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      Back to homepage
    </a>

    <span class="about-intro__plate" aria-hidden="true">
      ( 01 )
    </span>

    <h1 class="about-intro__headline">About</h1>

    <div class="about-intro__row">
      <p class="about-intro__text">
        I'm Laura, a digital development &amp; design student with a background in marketing
        communication. I'm currently specialising in UX and experience design, while continuing to
        explore web and motion design.
      </p>

      <div class="about-intro__aside">
        <span class="about-intro__portrait" aria-hidden="true">
          <!-- TODO: replace with a real portrait once photography exists (PROJECT_BRIEF.md Section 6) -->
        </span>

        <aside class="about-intro__footnote">
          <span class="about-intro__footnote-mark" aria-hidden="true">
            *
          </span>
          You knew that already by now. Let me use this opportunity to tell you a little more about
          me.
        </aside>
      </div>
    </div>

    <Button href={withBase(cvHref)} variant="primary" icon="download" class="about-intro__cta">
      Download CV
    </Button>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector('.about-intro');
  if (section && !prefersReducedMotion()) {
    const plate = section.querySelector<HTMLElement>('.about-intro__plate');
    const headline = section.querySelector<HTMLElement>('.about-intro__headline');
    const rest = section.querySelectorAll<HTMLElement>('.about-intro__row, .about-intro__cta');

    if (plate && headline && rest.length) {
      // A hard clip-path wipe instead of a soft fade/rise - reads like the
      // word being printed by a scanning bar rather than drifting in, which
      // fits this page's more structural, mechanical-precision character
      // better than a translateY fade would. Hero's own per-letter entrance
      // stays a separate, homepage-only recipe (see the file header comment).
      gsap.set(plate, { autoAlpha: 0 });
      gsap.set(headline, { clipPath: 'inset(0 100% 0 0)' });
      gsap.set(rest, { autoAlpha: 0, y: 12 });

      gsap
        .timeline()
        .to(plate, { autoAlpha: 1, duration: 0.3, ease: 'none' })
        .to(headline, { clipPath: 'inset(0 0% 0 0)', duration: 0.8, ease: 'power4.out' }, 0.1)
        .to(rest, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.08 }, 0.55);
    }
  }
</script>

<style>
  .about-intro {
    padding-top: var(--space-64);
    padding-bottom: var(--space-section);
  }

  .about-intro__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  /* A delicate back-link, per direct request - small mono label style
     (matching the plate mark/tags rather than a bold CTA), text-secondary
     at rest so it reads as a quiet wayfinding aid above the page's actual
     content, not a competing headline. */
  .about-intro__back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.5em;
    margin-bottom: var(--space-24);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    transition: color var(--motion-duration) var(--motion-easing);
  }

  .about-intro__back:hover,
  .about-intro__back:focus-visible {
    color: var(--color-accent);
  }

  .about-intro__back:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .about-intro__back-arrow {
    width: 0.9em;
    height: 0.9em;
    transition: transform var(--motion-duration) var(--motion-easing);
  }

  .about-intro__back:hover .about-intro__back-arrow,
  .about-intro__back:focus-visible .about-intro__back-arrow {
    transform: translateX(-0.15em);
  }

  /* This page's plate mark, matching SectionMarker's own plain index
     styling exactly (no hairline box - removed again per direct
     follow-up request, "remove the squares around the (01) etc", see
     AboutStory's own comment on the same change) but authored locally -
     Intro doesn't use SectionMarker itself (it isn't a labeled section,
     it's the page opener, same as Hero on the homepage), so this keeps
     the numbering system honest without forcing an index+label pair onto
     something that isn't one. */
  .about-intro__plate {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  /* Weight/case/tracking/line-height now match Hero's .hero__title-visual
     exactly (line-height: 0.8, letter-spacing: -0.03em) per direct request
     to align the two pages' title styling - font-size keeps its own
     clamp() rather than Hero's cqw mechanism, since that edge-to-edge
     device is still deliberately homepage-only (see the file header
     comment); this page's headline settles for a smaller fixed anchor,
     not a full-bleed one. */
  .about-intro__headline {
    margin-top: var(--space-16);
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.8;
    font-size: clamp(3.5rem, 7vw + 2rem, 9rem);
    color: var(--color-ink);
  }

  .about-intro__row {
    margin-top: var(--space-48);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-24);
    align-items: start;
  }

  /* This page's closest equivalent to Hero's subtitle paragraph
     (.hero__intro, directly under its own title) - matched to the same
     size/line-height/color per direct request, in place of this page's
     previous bespoke values (a slightly larger clamp, ink instead of
     text-secondary). */
  .about-intro__text {
    grid-column: 1 / 8;
    max-width: 65ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Holds the new portrait placeholder and the existing footnote card as
     one small collage, the footnote overlapping the image's lower-right
     corner - a print-and-a-pinned-note arrangement, not two unrelated
     elements sharing a column. */
  .about-intro__aside {
    position: relative;
    grid-column: 9 / 13;
    align-self: start;
  }

  /* A second image placeholder on this page (the first is Hero's own
     portrait slot) - same flat-gray, no-real-photo language, tilted the
     opposite way from the footnote so the two don't read as parallel
     duplicates of the same gesture. */
  .about-intro__portrait {
    display: block;
    aspect-ratio: 3 / 4;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    transform: rotate(2deg);
  }

  /* The page's one terracotta wink - a small pinned note, not a banner.
     Kept off the grid's straight edges on purpose (a slight rotation, an
     asymmetric self-position) so it reads as placed by hand rather than
     laid out. Sharp corners (no radius token) rather than the sitewide
     hairline-rounded default - reads more like a cut paper scrap than a
     soft printed card, which suits "pinned by hand" better. Now
     overlapping the portrait's own corner (a negative margin pulling it
     up and left) instead of sitting in its own clear column - the two
     read as one small collage rather than a stacked pair. */
  .about-intro__footnote {
    position: relative;
    z-index: 1;
    width: 80%;
    margin-top: -2.5rem;
    margin-left: auto;
    margin-right: -1rem;
    padding: var(--space-16);
    background: var(--color-bg-primary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    box-shadow: 0 8px 20px -12px rgb(23 21 15 / 0.28);
    transform: rotate(-3.5deg);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .about-intro__footnote-mark {
    display: inline-block;
    margin-right: 0.3em;
    font-family: var(--font-display);
    font-style: normal;
    font-size: 1.25rem;
    line-height: 0.6;
    vertical-align: -0.1em;
    color: var(--color-accent-signal);
  }

  :global(.about-intro__cta) {
    margin-top: var(--space-48);
  }

  @media (max-width: 1023px) {
    .about-intro__text {
      grid-column: 1 / 13;
    }

    .about-intro__aside {
      grid-column: 1 / 13;
      margin-top: var(--space-32);
      max-width: 22rem;
    }
  }

  @media (max-width: 639px) {
    .about-intro__inner {
      padding-inline: 1.5rem;
    }

    .about-intro__headline {
      font-size: clamp(3rem, 18vw, 5rem);
    }

    .about-intro__row {
      margin-top: var(--space-32);
    }

    .about-intro__aside {
      max-width: 14rem;
    }

    .about-intro__footnote {
      transform: rotate(-2deg);
    }
  }
</style>
