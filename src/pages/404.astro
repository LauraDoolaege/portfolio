---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Button from '../components/ui/Button.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="Page not found | Laura Doolaege" description="This page doesn't exist.">
  <div class="page">
    <Header />
    <main id="main" class="container not-found">
      <h1>Page not found</h1>
      <p class="subtitle">This page doesn't exist or has moved.</p>
      <Button href={withBase('/')}>Back to the homepage</Button>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .not-found {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: var(--space-section);
  }
</style>
