---
// Homepage "3 design principles," between Currently Working On and
// Gallery. Body copy is the same three sentences as About's own "How I
// work" section (AboutProcess.astro) - reused verbatim rather than
// rewritten, per this project's own "no fabricated copy" rule. Each
// item's short title is reused too, from the homepage's former "How I
// think" section (HowIThink.astro, now removed per direct request) -
// "Understand before designing" / "Creative, but defendable" / "Make it
// make sense", paired in order with the three process sentences rather
// than re-authored.
//
// First shipped as a deliberately unnumbered, small mono "( 02 ) My
// design principles" kicker (a quiet aside, not a peer to the numbered
// sections). Per a later direct request ("make subtitles... consistent
// across all pages... small number indication and bigger bolder font for
// the title, like it already is on the homepage for selected work and
// gallery"), it now uses the real `SectionMarker` component instead -
// same index+label device every other section uses, standard
// `--space-section` padding instead of its own smaller clamp() - the
// "stay quiet" intent from the first version is retired in favor of
// site-wide consistency, which is what was actually asked for this time.
//
// Numbering: Selected Work "01", this "02", Gallery "03" - Currently
// Working On sits physically between Selected Work and this section but
// carries no number of its own again, demoted back to a small aside per
// a later direct request ("should not be a major section... rather a
// little sneak peek") - see that file's own comment.
import SectionMarker from '../ui/SectionMarker.astro';

const principles = [
  {
    title: 'Understand before designing',
    text: 'Paper, whiteboards, sticky notes, messy diagrams: anything that lets ideas move faster than my concern for how they look.',
  },
  {
    title: 'Creative, but defendable',
    text: "I especially enjoy collaborative ideation: getting different perspectives in the room, throwing ideas around, combining them and challenging each other's assumptions.",
  },
  {
    title: 'Make it make sense',
    text: 'Once the messy thinking starts to make sense, I move into digital tools and prototypes.',
  },
];
---

<section class="principles">
  <div class="principles__inner">
    <SectionMarker index="02" label="My design principles" />

    <ul class="principles__list">
      {principles.map((item, index) => (
        <li class="principles__item">
          <span class="principles__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="principles__title">{item.title}</h3>
          <p class="principles__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const items = document.querySelectorAll<HTMLElement>('.principles__item');
  if (items.length && !prefersReducedMotion()) {
    gsap.set(items, { autoAlpha: 0, y: 20 });
    gsap.to(items, {
      autoAlpha: 1,
      y: 0,
      duration: 0.65,
      ease: 'power2.out',
      stagger: 0.1,
      scrollTrigger: { trigger: '.principles__list', start: 'top 85%' },
    });
  }
</script>

<style>
  .principles {
    padding-block: var(--space-section);
  }

  .principles__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .principles__list {
    margin-top: var(--space-48);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
  }

  .principles__item {
    padding-left: var(--space-24);
    /* A hairline divider between columns, not a border/background per
                                               item. Only items after the first get one, so the row doesn't open
                                               with a stray rule before any content. */
    border-left: var(--border-hairline) solid var(--color-text-secondary);
  }

  .principles__item:first-child {
    padding-left: 0;
    border-left: none;
  }

  .principles__number {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  /* Bigger, bolder, display-font titles - matching the weight Selected
     Work/Gallery's own SectionMarker labels carry, per direct request,
     rather than the small mono item-title the first version used. */
  .principles__title {
    margin-top: var(--space-8);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-ink);
  }

  .principles__text {
    margin-top: var(--space-16);
    max-width: 32ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .principles__list {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }

    /* Horizontal dividers instead of vertical ones once the columns
                                               stack - the same device rotated 90 degrees rather than a
                                               different one. */
    .principles__item {
      padding-left: 0;
      padding-top: var(--space-24);
      border-left: none;
      border-top: var(--border-hairline) solid var(--color-text-secondary);
    }

    .principles__item:first-child {
      padding-top: 0;
      border-top: none;
    }
  }

  @media (max-width: 640px) {
    .principles__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
