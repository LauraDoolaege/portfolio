---
// Site-wide footer. Locked as the default use of dark-field (CLAUDE.md
// Design system, Section 3 palette table) — paired with the homepage's
// ContactCTA immediately above it so the two form one continuous dark
// closing zone rather than two separate dark sections.
//
// Restructured to a minimal two-item closing row - per direct request to
// look at a reference image's footer structure (a plain availability line
// on the left, copyright on the right, nothing else) and apply that
// structure "in my style." What used to live here is redistributed, not
// dropped: the name+nav row and the email/LinkedIn contact row are gone
// outright (Header.astro already carries full site nav on every page, and
// ContactCTA.astro directly above this now carries email/LinkedIn/CV as
// its own real, much clearer CTA - keeping a second copy of either here
// would just be the same links shown twice in a row). "Back to top" is
// gone too, same reasoning as the nav row - not in the reference, and a
// static two-line footer doesn't need its own scroll-affordance.
//
// The availability line reuses the exact copy/icon/markup already
// established in Header.astro and Hero.astro (`.site-header__status` /
// `.hero__status`) rather than the reference's own wording ("Available
// for internship from Feb 2027") or its green-diamond bullet - same fact,
// stated once, consistently, in this project's own established visual
// language (a location-pin icon, not a new accent color the locked
// palette doesn't have).
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__status">
      <svg class="site-footer__status-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M8 14.2C8 14.2 12.5 9.8 12.5 6.3C12.5 3.8 10.5 1.8 8 1.8C5.5 1.8 3.5 3.8 3.5 6.3C3.5 9.8 8 14.2 8 14.2Z"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
        <circle cx="8" cy="6.3" r="1.6" stroke="currentColor" stroke-width="1.2" />
      </svg>
      Belgium <span aria-hidden="true">|</span> Available Feb 2027
    </p>

    <p class="site-footer__credit">© {year} Laura Doolaege</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-field);
    color: var(--color-bg-primary);
    border-top: var(--border-hairline) solid var(--color-text-secondary);
  }

  .site-footer__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding: 2rem var(--intro-margin);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    /* var(--color-text-secondary) is 3.03:1 on dark-field, under the 4.5:1 minimum for 12px text — the on-dark tint (global.css) fixes it. Same reasoning already applied to Header/Hero's own copy of this line. */
    color: var(--color-text-secondary-on-dark);
  }

  .site-footer__status {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }

  .site-footer__status-icon {
    width: 0.9em;
    height: 0.9em;
    flex-shrink: 0;
  }

  .site-footer__status span {
    margin-inline: 0.15em;
  }

  .site-footer__credit {
    margin: 0;
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      padding-inline: 1.5rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
