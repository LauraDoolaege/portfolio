---
// Site-wide header/navigation. Nav items per PROJECT_BRIEF.md Section 4
// (LOCKED): Laura [Name] | Work | About | CV | Contact.
//
// Open decision this component had to fill in (see CLAUDE.md "Open
// decisions" — not locked anywhere yet):
// - Mobile nav pattern: no hamburger/overlay — the nav stays visible as
//   plain text at every width. When the viewport is too narrow to fit
//   the wordmark and nav on one line, the nav wraps onto its own line
//   below (pure CSS flex-wrap, no JS, no hidden state).
// - Sticky vs. static: static (scrolls with the page).
import { withBase } from '../../utils/url';
import Button from '../ui/Button.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={withBase('/')} class="site-header__name">
      Laura <span class="site-header__name-placeholder">[Name]</span>
    </a>

    <div class="site-header__right">
      <nav aria-label="Primary" class="site-header__nav">
        <ul class="site-header__links">
          <li>
            <a href={withBase('/work')} class="site-header__link">
              Work
            </a>
          </li>
          <li>
            <a href={withBase('/about')} class="site-header__link">
              About
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="site-header__link">
              Contact
            </a>
          </li>
        </ul>
      </nav>

      <!-- TODO: replace href="#" with the real CV PDF path once supplied (PROJECT_BRIEF.md Section 6) -->
      <Button href="#" variant="primary" icon="download" class="site-header__cv">
        CV
      </Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    padding-block: 2rem;
  }

  .site-header__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    row-gap: 0.75rem;
    column-gap: 2rem;
  }

  .site-header__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.55rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
    transition: color var(--motion-duration) var(--motion-easing);
  }

  .site-header__name:hover {
    color: var(--color-accent);
  }

  .site-header__name:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .site-header__name-placeholder {
    color: var(--color-text-secondary);
  }

  /* Groups the nav links and the CV button together on the right, with
     the CV button as the distinct, rightmost element — a CTA set apart
     from plain navigation, not just another item in its rhythm. */
  .site-header__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  /* Editorial "/" rhythm between nav items, in place of pure whitespace
     — decorative punctuation, not content, so it's CSS-generated rather
     than markup. */
  .site-header__links li:not(:first-child)::before {
    content: '/';
    margin-inline-end: 0.6rem;
    color: var(--color-text-secondary);
  }

  .site-header__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-nav);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    padding-block: 0.2em;
    border-bottom: var(--border-hairline) solid transparent;
    transition:
      color var(--motion-duration) var(--motion-easing),
      border-color var(--motion-duration) var(--motion-easing);
  }

  .site-header__link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .site-header__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Narrow-viewport adjustment only — tightens spacing so the nav still
     reads as one fine, quiet line (or wraps to its own line under the
     wordmark) rather than needing a hamburger/overlay. Not a locked
     breakpoint value; see the note at the top of this file. */
  @media (max-width: 640px) {
    .site-header__inner {
      padding-inline: 1.5rem;
    }

    .site-header__right {
      gap: 1rem;
    }

    .site-header__links {
      gap: 0.5rem;
    }

    .site-header__links li:not(:first-child)::before {
      margin-inline-end: 0.5rem;
    }
  }

  /* Below this, the nav can wrap onto a second line of its own (see
     component note above) — a "/" stranded at the start of that
     wrapped line reads as a mistake, so drop the separators here and
     fall back to plain whitespace rhythm instead. */
  @media (max-width: 400px) {
    .site-header__links {
      gap: 0.85rem;
    }

    .site-header__links li:not(:first-child)::before {
      content: none;
    }
  }
</style>
