---
// Section 04: who am I. The statement runs in columns 1-8, one sentence per line, with "marketer turned experience designer" in bold;
// the full, uncropped photo sits small in columns 9-12 and the way into the About page sits under it.
// Hero's "Get to know me" link jumps here (#about).
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { withBase } from '../../utils/url';
import photo from '../../assets/images/photo_aboutTeaser.png';
---

<section class="sec" id="about" aria-labelledby="about-title">
  <div class="container">
    <header class="sec__head">
      <h2 id="about-title" class="sec-title" data-reveal>
        Who am I
      </h2>
    </header>

    <div class="about__grid">
      <p class="about__statement" data-reveal>
        <span class="about__line about__line--lead">
          <span class="about__row">
            <mark class="hl">A marketer turned</mark>
          </span>
          <span class="about__row">
            <mark class="hl">experience designer</mark>.
          </span>
        </span>
        <span class="about__line">But so much more than that...</span>
      </p>

      <!-- The portrait is a second way into the About page (same destination as the link under it, so it stays out of the tab order) -->
      <a
        class="about__portrait"
        href={withBase('/about')}
        data-plain
        data-cursor-label="About"
        tabindex="-1"
        aria-hidden="true"
      >
        <figure class="about__figure media-frame" data-no-pan data-reveal="grain">
          <Image
            class="media-frame__img about__photo"
            src={photo}
            alt="Portrait of Laura Doolaege looking at the camera"
            widths={[240, 480, 720]}
            sizes="15rem"
          />
        </figure>
      </a>

      <div class="about__link" data-reveal>
        <Button variant="link" href={withBase('/about')}>
          Get to know me better
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem var(--grid-gutter);
  }

  .about__statement {
    display: grid;
    gap: 0.35em;
    font-size: clamp(1.9rem, 1rem + 2.6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .about__line {
    display: block;
    font-weight: var(--weight-light);
  }

  /* The first sentence is set as two fixed rows so its box hugs the words */
  .about__line--lead {
    position: relative;
    width: max-content;
    max-width: 100%;
    font-weight: var(--weight-bold);
  }

  .about__row {
    display: block;
    white-space: nowrap;
  }

  .about__portrait {
    display: block;
    width: min(100%, 15rem);
  }

  /* The same hover as the project covers (mouse, wide screens): a touch smaller at rest, full size on hover. No blur,
     no grain. Touch and phones get the full-size photo. */
  .about__portrait .about__figure {
    transition: transform 0.9s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 700px) {
    .about__portrait .about__figure {
      transform: scale(0.97);
    }

    .about__portrait:hover .about__figure,
    .about__portrait:focus-visible .about__figure {
      transform: scale(1);
    }
  }

  /* The whole portrait, uncropped, kept small */
  .about__figure {
    width: min(100%, 15rem);
  }

  /* Black and white, like the hero portrait */
  .about__figure :global(.about__photo) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.05);
  }

  /* Armed by the script (so no-JS and reduced-motion visitors see the finished marks); a zero-length dash still
     paints a round cap, so each path stays hidden until it starts drawing */

  .about__link {
    padding-top: 1.25rem;
    border-top: var(--hairline);
    width: min(100%, 15rem);
  }

  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      align-items: start;
    }

    .about__statement {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
    }

    .about__portrait {
      grid-column: 9 / 13;
      grid-row: 1;
    }

    .about__link {
      grid-column: 9 / 13;
      grid-row: 2;
    }
  }

  /* Phones: the marks are drawn small, so the pen is lighter */
</style>
