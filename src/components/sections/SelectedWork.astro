---
// Homepage "Selected work" (PROJECT_BRIEF.md Section 4, item 2). Content is
// final per the brief: two groups, three projects each — Design/individual
// work, Experience design/group projects. Real project titles/images don't
// exist yet (Section 6), so cards are numbered placeholders, not invented
// project names.
//
// DESIGN_VARIANCE: 9 (see CLAUDE.md "Experimental design dials") — cards
// no longer sit in three identical boxes per row (an equal-width triplet
// reads as a template, per direct feedback that this section "needs
// work"/more hierarchy). Each group is now a 7fr/5fr bento: one featured
// card carries the row, the other two stack beside it. Both groups use
// the same device now (design row and experience row alike) rather than
// only one of the two breaking from uniformity, as the previous version
// did — a bolder, more consistent move, and it also retires the old
// `--design`/`--experience` grid modifiers and the experience-only
// nth-child stagger hack that used to be this section's one asymmetric
// beat.
//
// Mobile fallback (PROJECT_BRIEF.md Section 8 lists this as an open
// decision — flagging, not silently resolving): below the bento's own
// min-width: 900px switch, both groups collapse to a single equal-width
// column, same "macro asymmetry drops to a plain stack" pattern already
// used for AboutDrives' scattered cards and Hero's own grid. The featured
// card stays visually distinct even there via ProjectCard's own
// `featured` prop (a bigger title, at every width) rather than
// disappearing entirely into the stack.
import SectionMarker from '../ui/SectionMarker.astro';
import ProjectCard from '../ui/ProjectCard.astro';

const design = [
  { number: '01', title: 'Project 01', roleTag: 'design' },
  { number: '02', title: 'Project 02', roleTag: 'design' },
  { number: '03', title: 'Project 03', roleTag: 'design' },
];

const experience = [
  { number: '04', title: 'Project 04', roleTag: 'experience design' },
  { number: '05', title: 'Project 05', roleTag: 'experience design' },
  { number: '06', title: 'Project 06', roleTag: 'experience design' },
];
---

<section class="selected-work" id="work">
  <div class="selected-work__inner">
    <SectionMarker index="02" label="Selected work" />

    <p class="selected-work__intro">
      A mix of solo design work and collaborative experience-design projects.
    </p>

    <div class="selected-work__group">
      <h3 class="selected-work__group-label">Design: individual work</h3>
      <ul class="selected-work__grid">
        {design.map((project, index) => (
          <li>
            <ProjectCard {...project} featured={index === 0} />
          </li>
        ))}
      </ul>
    </div>

    <div class="selected-work__group">
      <h3 class="selected-work__group-label">Experience design: group projects</h3>
      <ul class="selected-work__grid">
        {experience.map((project, index) => (
          <li>
            <ProjectCard {...project} featured={index === 0} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .selected-work {
    padding-block: var(--space-section);
  }

  .selected-work__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .selected-work__intro {
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .selected-work__group {
    margin-top: 4.5rem;
  }

  /* Same fine-print weight as the header/hero location tag
     (.site-header__status / .hero__status) - text-label (12px) and
     text-secondary, not text-nav (14px) and full ink - per direct
     request to match "the same fine font as the belgium tag". */
  .selected-work__group-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  /* Mobile/tablet default: a plain equal-width stack, first item first -
     see the file header comment on why this is the deliberate fallback
     rather than trying to preserve the bento shape at a width that can't
     fit a 7fr/5fr split comfortably. */
  .selected-work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-32);
    margin-top: 2rem;
  }

  /* Bento: one featured card (spans both rows in the wide column) beside
     two stacked ones. `grid-auto-rows` (not an explicit `1fr 1fr`, which
     needs a definite container height to mean anything) lets the two
     stacked cards size the rows from their own content, and the featured
     card's own min-width: 900px rule (ProjectCard.astro) stretches to
     match whatever height that produces, instead of imposing a height of
     its own that the stacked column would then have to match. */
  @media (min-width: 900px) {
    .selected-work__grid {
      grid-template-columns: 7fr 5fr;
      grid-auto-rows: auto;
    }

    .selected-work__grid li:first-child {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .selected-work__grid li:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }

    .selected-work__grid li:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (max-width: 640px) {
    .selected-work__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
