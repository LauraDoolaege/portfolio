---
// A comparison as ruled rows, not a boxed table: the first column is the row's name (bold), the rest sit
// beside it on desktop. On phones every cell stacks under its own column name. Used for "first vs. final
// iteration" and "what we dropped, and why".
interface Props {
  heads: string[];
  rows: string[][];
}

const { heads, rows } = Astro.props;
---

<table class="ruled">
  <thead>
    <tr>
      {heads.map((h) => (
        <th scope="col" class="tag">
          {h}
        </th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map((cells) => (
      <tr>
        {cells.map((c, i) => (
          <td data-label={heads[i]}>{c}</td>
        ))}
      </tr>
    ))}
  </tbody>
</table>

<style>
  .ruled {
    width: 100%;
    margin-block: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-collapse: collapse;
    text-align: left;
  }

  .ruled thead {
    display: none;
  }

  .ruled tr {
    display: block;
    padding-block: 1.1rem;
    border-top: var(--hairline);
  }

  .ruled tr:last-child {
    border-bottom: var(--hairline);
  }

  .ruled td {
    display: block;
    font-size: var(--text-paragraph);
    font-weight: var(--weight-light);
    line-height: var(--leading-paragraph);
    text-wrap: pretty;
  }

  .ruled td + td {
    margin-top: 0.7rem;
  }

  .ruled td:first-child {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
  }

  /* On phones each cell names its column, since the header row is gone */
  .ruled td:not(:first-child)::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (min-width: 700px) {
    .ruled thead {
      display: table-header-group;
    }

    .ruled th {
      display: table-cell;
      text-align: left;
      padding: 0 1.25rem 0.75rem 0;
      color: var(--text-muted);
    }

    .ruled tr {
      display: table-row;
      padding: 0;
      border: 0;
    }

    .ruled tbody tr {
      border-top: 0;
    }

    .ruled td {
      display: table-cell;
      padding: 1.1rem 1.25rem 1.1rem 0;
      border-top: var(--hairline);
      vertical-align: top;
      font-size: 1rem;
    }

    .ruled tbody tr:last-child td {
      border-bottom: var(--hairline);
    }

    .ruled td + td {
      margin-top: 0;
    }

    .ruled td:first-child {
      width: 28%;
      font-size: 1rem;
      font-weight: var(--weight-bold);
      letter-spacing: 0;
      line-height: var(--leading-paragraph);
    }

    .ruled td:not(:first-child)::before {
      display: none;
    }
  }
</style>
