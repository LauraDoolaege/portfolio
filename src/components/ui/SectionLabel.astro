---
// The one section label used across the site: just the words ("Work", "The big idea"). Styling lives in global.css (.section-label) so every label is identical; extra
// attributes (e.g. data-reveal) pass through.
interface Props {
  text?: string;
  [attr: string]: unknown;
}

const { text, ...rest } = Astro.props;
---

<p class="section-label tag" {...rest}>
  {text}
</p>
