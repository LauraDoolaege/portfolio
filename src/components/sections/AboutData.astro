---
// The data: skills, tools, education, experience as an architectural grid.
// Category labels on the left; entries sit in cells divided by 1px lines in both directions.
const skills = [
  {
    group: 'UX',
    items:
      'User interviews, insight gathering, wireframing, paper and digital prototyping, user testing, UI design, information architecture',
  },
  { group: 'Research', items: 'Data analysis (SPSS), creative data visualisation' },
  { group: 'Visual', items: 'Brand identity, campaign design, motion, 3D' },
  { group: 'Marketing', items: 'Content strategy, copywriting, persuasion & nudging' },
  { group: 'Communication', items: 'Workshop facilitation, pitching and presenting' },
];

const tools = ['Figma', 'Photoshop', 'Illustrator', 'After Effects', 'Blender', 'SPSS', 'VS Code'];

const education = [
  {
    title: 'Digital Design & Development (Devine)',
    where: 'Howest Kortrijk',
    detail: '2024 to now, major in UX design',
  },
  {
    title: 'Bachelor in Marketing Communication',
    where: 'Cum laude',
    detail:
      "Thesis: How do you get colleagues to actually contribute to the internal newsletter? Using Cialdini's principles of persuasion and nudging.",
  },
];

const experience = {
  role: 'Marketing & Communication Intern',
  org: 'CAW Oost-Vlaanderen',
  bullets: [
    'Planned content and created social media posts for key dates',
    'Wrote the letters sent to policy makers across Belgium',
    "Led a workshop on my own to restructure the new website's content",
  ],
};
---

<section class="data" aria-label="Skills, tools, education and experience">
  <div class="container">
    <div class="data__row grid" data-reveal>
      <h2 class="data__label">Skills</h2>
      <dl class="data__cells data__cells--skills">
        {skills.map((s) => (
          <div class="data__cell">
            <dt>{s.group}</dt>
            <dd>{s.items}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="data__row grid" data-reveal>
      <h2 class="data__label">Tools</h2>
      <ul class="data__cells data__cells--tools">
        {tools.map((t) => (
          <li class="data__cell data__tool">{t}</li>
        ))}
      </ul>
    </div>

    <div class="data__row grid" data-reveal>
      <h2 class="data__label">Education</h2>
      <ul class="data__cells data__cells--two">
        {education.map((e) => (
          <li class="data__cell">
            <p class="data__title">{e.title}</p>
            <p class="data__meta">{e.where}</p>
            <p class="data__detail">{e.detail}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="data__row grid" data-reveal>
      <h2 class="data__label">Experience</h2>
      <div class="data__cells data__cells--one">
        <div class="data__cell">
          <p class="data__title">{experience.role}</p>
          <p class="data__meta">{experience.org}</p>
          <ul class="data__bullets">
            {experience.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .data {
    padding-bottom: var(--space-section);
  }

  .data__row {
    row-gap: 1rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
    border-top: var(--hairline);
  }

  .data__row:last-child {
    border-bottom: var(--hairline);
  }

  .data__label,
  .data__cells {
    grid-column: 1 / -1;
  }

  .data__label {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Cells: 1px lines between them, drawn as a grid gap over a line-colored background so both directions line up */
  .data__cells {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin: 0;
    background: var(--border-color);
    border: var(--hairline);
  }

  .data__cell {
    margin: 0;
    padding: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    background: var(--bg-primary);
  }

  dt,
  .data__title {
    font-weight: var(--weight-bold);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    letter-spacing: var(--tracking-display);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  dd,
  .data__detail,
  .data__bullets {
    margin: 0;
    font-weight: var(--weight-light);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .data__meta {
    margin-bottom: 0.75rem;
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .data__bullets {
    display: grid;
    gap: 0.5rem;
    max-width: 52ch;
  }

  .data__bullets li::before {
    content: '— ';
    color: var(--text-muted);
  }

  .data__tool {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
  }

  .data__cells--tools {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .data__cells--skills,
    .data__cells--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .data__cells--tools {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .data__label {
      grid-column: 1 / span 4;
    }

    .data__cells {
      grid-column: 5 / -1;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const rows = gsap.utils.toArray<HTMLElement>('.data [data-reveal]');

  if (rows.length && !prefersReducedMotion()) {
    gsap.set(rows, { y: 28, opacity: 0 });
    ScrollTrigger.batch(rows, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', stagger: 0.12 }),
    });
  }
</script>
