---
// Homepage hero (PROJECT_BRIEF.md Section 5 "Homepage — LOCKED", item 1).
// Content is final per the brief (Section 6), not placeholder.
//
// The name uses the brief's locked "object replacing/interrupting a
// letterform" device (Section 3 "Other locked tokens") — this is the
// page's one sanctioned "surprise" (Section 3, principle 2), so nothing
// else on this page should introduce another one.
//
// Open decisions this component had to fill in (not locked anywhere —
// see CLAUDE.md "Open decisions"):
// - Mobile type scale: the brief leaves this undefined (Section 8). The
//   hero name uses a fluid clamp() rather than the fixed 96px desktop
//   token, since 96px literally overflows a phone viewport. Revisit
//   once a real mobile type scale is locked.
// - "Get to know me" target: linked to /about (no target was specified).
import { withBase } from '../../utils/url';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';
---

<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__name">
      <span class="sr-only">Laura</span>
      <span class="hero__name-visual" aria-hidden="true">
        <span>LA</span>
        <span class="hero__name-image">
          <!-- TODO: replace with a real photo (see PROJECT_BRIEF.md Section 6 — no photography exists yet) -->
        </span>
        <span>RA</span>
      </span>
    </h1>

    <p class="hero__role">Experience designer to-be</p>

    <p class="hero__intro">
      I'm Laura, a digital development &amp; design student with a background in marketing
      communication, currently specialising in user experience design.
    </p>

    <Button href={withBase('/about')} variant="primary" icon="arrow" class="hero__cta">
      Get to know me
    </Button>

    <ul class="hero__tags">
      <li>
        <Tag>UX / Experience Design</Tag>
      </li>
      <li>
        <Tag>Digital Design</Tag>
      </li>
      <li>
        <Tag>Motion Design</Tag>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: 2rem var(--space-section);
  }

  .hero__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .hero__name {
    font-family: var(--font-display);
    font-weight: 700;
    /* Fluid, see the open-decision note at the top of this file — 96px (--text-h1) is the desktop ceiling, scales down on narrow viewports instead of overflowing. */
    font-size: clamp(2.75rem, 6vw + 1.5rem, var(--text-h1));
    line-height: var(--text-h1-leading);
    text-transform: uppercase;
  }

  .hero__name-visual {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
  }

  .hero__name-image {
    width: 0.72em;
    height: 0.72em;
    margin-inline: 0.12em;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    border-radius: var(--radius-image);
    flex-shrink: 0;
  }

  .hero__role {
    margin-top: 0.75em;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
  }

  .hero__intro {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  .hero__cta {
    margin-top: 2rem;
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }
</style>
