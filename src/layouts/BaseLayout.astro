---
import '../styles/global.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
}

// @font-face lives here, not in a CSS file: withBase() keeps the public/fonts URLs correct in dev and build.
const fontFaces = ['', 'Italic']
  .map(
    (v) =>
      `@font-face{font-family:'Switzer';src:url('${withBase(`/fonts/Switzer-Variable${v}.woff2`)}') format('woff2');font-weight:100 900;font-style:${v ? 'italic' : 'normal'};font-display:swap}`,
  )
  .join('');

const { title, description = "Laura's portfolio: digital development & design." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f3f2ee" />
    <title>{title}</title>
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/tactile';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--page-margin);
    top: 0;
    z-index: 100;
    padding: 0.6em 1em;
    background: var(--text-main);
    color: var(--bg-primary);
    font-size: var(--text-small);
    transform: translateY(-120%);
    transition: transform 0.3s var(--ease-out);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
