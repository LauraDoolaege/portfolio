---
// Navigation bar: wordmark left, links right.
import { withBase } from '../../utils/url';

const links = [
  { href: `${withBase('/')}#work`, label: 'Work' },
  { href: withBase('/about'), label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase('/')} class="site-header__name">
      Laura Doolaege
    </a>
    <nav aria-label="Primary">
      <ul class="site-header__links">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link"
              data-magnetic
              aria-current={l.href === currentPath ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--grid-gutter);
    padding-block: 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-regular);
  }

  .site-header__name {
    white-space: nowrap;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    color: var(--text-muted);
  }

  /* Slashes sit between items only: never before the first one */
  .site-header__links li + li::before {
    content: '/';
    margin-inline: clamp(0.6rem, 0.3rem + 1vw, 1.1rem);
    color: var(--text-muted);
  }

  .site-header__links a {
    position: relative;
    padding-bottom: 0.35em;
    transition:
      color var(--duration) var(--ease-out),
      opacity var(--duration) var(--ease-out);
  }

  /* Hover: the hovered link stays full strength, its siblings dim */
  .site-header__links:hover a {
    opacity: 0.5;
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    opacity: 1;
    color: var(--text-main);
  }

  /* Current page: full ink, with the drawing line held open in terracotta */
  .site-header__links a[aria-current='page'] {
    color: var(--text-main);
  }

  .site-header__links a[aria-current='page']::after {
    height: 2px;
    background: var(--accent);
    transform: scaleX(1);
  }
</style>
