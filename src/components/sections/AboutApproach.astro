---
// The approach: one light statement under a standard section header, the same voice as the homepage's questions.
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="sec" aria-labelledby="approach-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel text="The approach" data-reveal />
      <h2 id="approach-title" class="sec-title" data-reveal>
        How I work
      </h2>
    </header>

    <blockquote class="approach__quote lede" data-reveal>
      <p>
        “A good project starts with alignment. I play the grounded researcher, always asking: does
        this still solve the user’s core problem?”
      </p>
    </blockquote>
  </div>
</section>

<style>
  .approach__quote {
    max-width: 30ch;
    margin: 0;
  }
</style>
