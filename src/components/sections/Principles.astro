---
// Homepage "3 design principles," sitting between Hero and Selected Work
// - per direct request, in "a really subtle fashion." Copy is the same
// three sentences as About's own "How I work" section (AboutProcess.astro)
// - reused verbatim rather than rewritten, per this project's own "no
// fabricated copy" rule - only the title changes (this isn't "How I work"
// twice on the site, it's the same process described once each on two
// pages) and the layout/position are new.
//
// Deliberately outside the numbered SectionMarker rhythm (Selected Work
// is "02," Gallery "03," and so on) rather than becoming a new "02" that
// bumps every section after it - it's a quiet aside before the numbered
// sections start, not a peer to them. For the same "subtle" reason, it
// skips the display-font headline entirely: Barlow Condensed is this
// page's one-headline-anchor type (PROJECT_BRIEF.md Section 3), already
// spent on Hero's "PORTFOLIO," and giving this section its own big
// headline would split that attention rather than stay quiet. The kicker
// and the three lines are both mono/body type only, sized and colored to
// read as fine print, not a second section title.
const principles = [
  {
    text: 'Paper, whiteboards, sticky notes, messy diagrams: anything that lets ideas move faster than my concern for how they look.',
  },
  {
    text: "I especially enjoy collaborative ideation: getting different perspectives in the room, throwing ideas around, combining them and challenging each other's assumptions.",
  },
  {
    text: 'Once the messy thinking starts to make sense, I move into digital tools and prototypes.',
  },
];
---

<section class="principles">
  <div class="principles__inner">
    <p class="principles__kicker">Approach</p>

    <ul class="principles__list">
      {principles.map((item, index) => (
        <li class="principles__item">
          <span class="principles__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <p class="principles__text">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.principles');
  if (section && !prefersReducedMotion()) {
    // One plain, quiet fade/rise for the whole block - no stagger, no
    // per-element choreography. This section's entire point is to not
    // draw attention to itself, so it gets the single stillest reveal on
    // the homepage rather than a scaled-down version of a louder one.
    gsap.set(section, { autoAlpha: 0, y: 16 });
    gsap.to(section, {
      autoAlpha: 1,
      y: 0,
      duration: 0.7,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 92%' },
    });
  }
</script>

<style>
  /* Roughly a third of the sitewide --space-section (140px) - a quiet
     aside reads as one if it takes up noticeably less room than the
     numbered sections around it, not just a different color/type. */
  .principles {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .principles__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .principles__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .principles__list {
    margin-top: var(--space-24);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
  }

  .principles__item {
    padding-left: var(--space-24);
    /* A hairline divider between columns, not a border/background per
             item - the same "fine print" register as the kicker above, not a
             card. Only items after the first get one, so the row doesn't open
             with a stray rule before any content. */
    border-left: var(--border-hairline) solid var(--color-text-secondary);
  }

  .principles__item:first-child {
    padding-left: 0;
    border-left: none;
  }

  .principles__number {
    display: block;
    margin-bottom: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .principles__text {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .principles__list {
      grid-template-columns: 1fr;
      gap: var(--space-16);
    }

    /* Horizontal dividers instead of vertical ones once the columns
             stack - the same device rotated 90 degrees rather than a
             different one. */
    .principles__item {
      padding-left: 0;
      padding-top: var(--space-16);
      border-left: none;
      border-top: var(--border-hairline) solid var(--color-text-secondary);
    }

    .principles__item:first-child {
      padding-top: 0;
      border-top: none;
    }
  }

  @media (max-width: 640px) {
    .principles__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
