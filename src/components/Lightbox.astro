---
// Detail gallery for a project page. Collects every [data-lightbox] element (see CaseImage.astro)
// in DOM order and opens the clicked one enlarged, with a thumbnail strip of all the others below.
// The markup is empty on purpose: src/scripts/lightbox.ts fills it. Without JS the images simply
// stay as ordinary figures.
---

<dialog class="lb" aria-label="Project images" data-lightbox-root>
  <header class="lb__bar">
    <p class="lb__count tag" aria-live="polite"></p>
    <button type="button" class="lb__close tag" data-lb-close>
      Close
    </button>
  </header>
  <div class="lb__main">
    <button type="button" class="lb__nav tag" data-lb-prev aria-label="Previous image">
      Prev
    </button>
    <figure class="lb__figure">
      <div class="lb__stage"></div>
      <figcaption class="lb__caption text"></figcaption>
    </figure>
    <button type="button" class="lb__nav tag" data-lb-next aria-label="Next image">
      Next
    </button>
  </div>
  <ul class="lb__thumbs" role="list"></ul>
</dialog>

<script>
  import '../scripts/lightbox';
</script>

<style is:global>
  .lb {
    --lb-thumbs: 5.5rem;
    --lb-bar: 3.5rem;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg-primary);
    color: var(--text-main);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .lb[open] {
    display: grid;
    grid-template-rows: var(--lb-bar) minmax(0, 1fr) auto;
  }

  .lb.is-open {
    opacity: 1;
  }

  .lb::backdrop {
    background: var(--bg-primary);
  }

  /* The custom cursor lives below the top layer, so inside the gallery the native one comes back */
  .has-custom-cursor .lb,
  .has-custom-cursor .lb * {
    cursor: auto !important;
  }

  .has-custom-cursor .lb button {
    cursor: pointer !important;
  }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--page-margin);
  }

  .lb__count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .lb__close,
  .lb__nav {
    position: relative;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    transition: color 0.4s var(--ease-out);
  }

  .lb__close::after,
  .lb__nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }

  .lb__close:hover,
  .lb__close:focus-visible,
  .lb__nav:hover,
  .lb__nav:focus-visible {
    color: var(--text-main);
  }

  .lb__close:hover::after,
  .lb__close:focus-visible::after,
  .lb__nav:hover::after,
  .lb__nav:focus-visible::after {
    transform: scaleX(1);
  }

  .lb__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.75rem, 0.5rem + 2vw, 2.5rem);
    min-height: 0;
    padding-inline: var(--page-margin);
  }

  .lb__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    min-height: 0;
    margin: 0;
  }

  /* The enlarged print: as large as the stage allows at its own ratio, never cropped */
  .lb__stage {
    --stage-h: calc(100dvh - var(--lb-bar) - var(--lb-thumbs) - 7rem);
    width: min(100%, calc(var(--stage-h) * var(--r, 1.6)));
    aspect-ratio: var(--r, 1.6);
    overflow: hidden;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-out);
  }

  .lb.is-open .lb__stage {
    clip-path: inset(0);
  }

  .lb__stage > * {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: none !important;
  }

  .lb__caption {
    max-width: 62ch;
    min-height: 1.5em;
    color: var(--text-muted);
    text-align: center;
  }

  .lb__thumbs {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem var(--page-margin) 1.25rem;
    overflow-x: auto;
    border-top: var(--hairline);
    list-style: none;
  }

  .lb__thumb {
    position: relative;
    flex: none;
    width: 6.5rem;
    aspect-ratio: 16 / 10;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: var(--frame-bg);
    opacity: 0.5;
    transition: opacity 0.4s var(--ease-out);
  }

  .lb__thumb > * {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: none !important;
  }

  .lb__thumb:hover,
  .lb__thumb:focus-visible {
    opacity: 0.85;
  }

  /* Current image: full strength, with a terracotta rule under it */
  .lb__thumb[aria-current='true'] {
    opacity: 1;
  }

  .lb__thumb[aria-current='true']::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: var(--accent);
  }

  @media (max-width: 699px) {
    .lb {
      --lb-thumbs: 5rem;
    }

    .lb__main {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .lb__main .lb__figure {
      grid-row: 1;
      grid-column: 1;
    }

    .lb__nav {
      display: none;
    }

    .lb__thumbs {
      justify-content: flex-start;
    }

    .lb__thumb {
      width: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb,
    .lb__stage {
      transition: none;
    }

    .lb__stage {
      clip-path: none;
    }
  }
</style>
