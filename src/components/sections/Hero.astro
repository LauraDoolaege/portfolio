---
// Hero: status pill, massive H1, hook, tags. Each text line sits in an
// overflow-hidden mask; the script slides the inner element up into view.
---

<section class="hero" aria-label="Introduction">
  <div class="container hero__inner">
    <div class="hero__top mask">
      <p class="hero__pill reveal">
        <span class="hero__dot" aria-hidden="true"></span>
        Seeking UX &amp; Experience Design Internship (Feb – May 2027)
      </p>
    </div>

    <div class="hero__main">
      <h1 class="hero__title">
        <span class="mask"><span class="reveal reveal--title">Experience</span></span>
        <span class="mask"><span class="reveal reveal--title">Designer</span></span>
      </h1>

      <div class="grid hero__lower">
        <div class="hero__hook">
          <p class="mask">
            <span class="reveal reveal--hook"
              >I detangle briefs into creative concepts that are feasible and grounded in
              marketing.</span
            >
          </p>
          <p class="mask">
            <span class="reveal reveal--hook">Online and offline.</span>
          </p>
        </div>

        <ul class="hero__tags reveal--tags" aria-label="Focus">
          <li>UX Design</li>
          <li>
            <a
              href="https://www.howest.be/en/programmes/bachelor/digital-design-and-development"
              target="_blank"
              rel="noopener"
            >
              Devine 3rd Year <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    flex: 1;
    display: flex;
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 4rem);
    min-height: calc(100dvh - 4rem);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-section);
  }

  /* Clip container for the reveal. Bottom padding + matching negative margin keeps descenders from being cut at line-height < 1. */
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .reveal {
    display: block;
  }

  .hero__top {
    /* Room for the pill's border so the mask doesn't clip it */
    padding: 1px;
    margin: -1px;
    width: fit-content;
    max-width: 100%;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 1em;
    border: var(--hairline);
    border-radius: 999px;
    font-size: var(--text-small);
    font-weight: var(--weight-regular);
    color: var(--text-muted);
    line-height: 1.3;
  }

  .hero__dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero__title {
    /* "Experience" is the widest line: sized to span most of the container on desktop */
    font-size: clamp(3.25rem, 1rem + 13.5vw, 15rem);
    margin-bottom: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .hero__lower {
    align-items: start;
    row-gap: var(--grid-gutter);
    border-top: var(--hairline);
    padding-top: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .hero__hook {
    grid-column: 1 / -1;
    max-width: 34ch;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--weight-light);
    line-height: var(--leading-body);
  }

  .hero__tags {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-small);
  }

  .hero__tags li,
  .hero__tags a {
    display: inline-block;
    padding: 0.4em 0.9em;
    border: var(--hairline);
    border-radius: 999px;
    color: var(--text-muted);
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .hero__tags li:has(a) {
    padding: 0;
    border: 0;
  }

  .hero__tags a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (min-width: 800px) {
    .hero__hook {
      grid-column: 1 / span 6;
    }

    .hero__tags {
      grid-column: 9 / -1;
      justify-content: flex-end;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const pill = document.querySelector<HTMLElement>('.hero__pill');
  const title = gsap.utils.toArray<HTMLElement>('.reveal--title');
  const hook = gsap.utils.toArray<HTMLElement>('.reveal--hook');
  const tags = document.querySelector<HTMLElement>('.reveal--tags');

  if (!prefersReducedMotion() && pill && tags) {
    // Start states are set in JS, not CSS, so no-JS visitors still see everything.
    // The tags aren't masked, so they get a short travel instead of a full-height slide.
    gsap.set([pill, ...title, ...hook], { yPercent: 100, opacity: 0 });
    gsap.set(tags, { y: 24, opacity: 0 });

    // Sequence: status pill, then H1 lines, then hook, then tags.
    const defaults = { duration: 1.2, ease: 'expo.out', opacity: 1 };
    gsap
      .timeline()
      .to(pill, { ...defaults, yPercent: 0 })
      .to(title, { ...defaults, yPercent: 0, stagger: 0.12 }, '-=0.95')
      .to(hook, { ...defaults, yPercent: 0, stagger: 0.1 }, '-=0.9')
      .to(tags, { ...defaults, y: 0 }, '-=1');
  }
</script>
