---
// Homepage "Currently working on" (PROJECT_BRIEF.md Section 4, item 4) —
// exactly 2 items per the brief: Blender/3D-header learning, and a
// hedgehog-led decentering-human-design UX project. The brief only gives
// short descriptors, not the Website Structure doc's exact sentences, so
// the one-line descriptions below are a direct expansion of those
// descriptors, not invented content — swap in the real copy if it differs.
//
// This section holds the page's one terracotta "wink" (PROJECT_BRIEF.md
// Section 3 palette table, accent-signal — locked, NOT touched by the
// design-variance override in CLAUDE.md): a single rotated asterisk after
// the heading, the exact example the brief itself gives for this color.
// It appears nowhere else on the homepage — don't add a second one.
//
// Demoted back down to a small, unnumbered aside - per direct request,
// "the currently working on should not be a major section as it is now,
// rather a little sneak peek to what I'm up to." A previous pass had
// promoted it to a full numbered section (its own SectionMarker, a
// two-item image grid, --space-section padding) for site-wide subtitle
// consistency; that reasoning only held while it was meant to carry the
// same weight as Selected Work/Principles/Gallery. Once it's explicitly
// meant to read as lighter than those, it drops out of the numbered
// sequence again (Selected Work "01", Principles "02", Gallery "03" -
// Gallery.astro and Principles.astro both had their own index adjusted
// back down to close the gap) the same way Principles itself was once
// the deliberately-unnumbered one. No images, no big display title - a
// single compact line: the wink line, then the two items as a plain
// inline list.
const items = [
  {
    title: 'Blender',
    description: 'Learning 3D: building a header piece.',
  },
  {
    title: 'Decentering the human',
    description: 'A hedgehog-led UX project on designing beyond human-centered defaults.',
  },
];
---

<section class="currently">
  <div class="currently__inner">
    <p class="currently__label">
      Currently working on
      <span class="currently__wink" aria-hidden="true">
        *
      </span>
    </p>

    <ul class="currently__list">
      {items.map((item) => (
        <li class="currently__item">
          <span class="currently__title">{item.title}</span>
          <span class="currently__description">{item.description}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.currently');
  if (section && !prefersReducedMotion()) {
    // One quiet, shared fade/rise - a sneak peek shouldn't announce
    // itself with its own choreographed entrance.
    gsap.set(section, { autoAlpha: 0, y: 16 });
    gsap.to(section, {
      autoAlpha: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 92%' },
    });
  }
</script>

<style>
  /* A fraction of the sitewide --space-section - a small aside reads as
     one if it visibly takes up less room than the numbered sections
     around it, same principle Principles.astro's own first version
     (before it was promoted) already established. */
  .currently {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .currently__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
  }

  .currently__label {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .currently__wink {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent-signal);
    transform: rotate(-8deg);
  }

  .currently__list {
    margin-top: var(--space-16);
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-32);
    row-gap: var(--space-8);
  }

  .currently__item {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5em;
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-secondary);
  }

  .currently__title {
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .currently__inner {
      padding-inline: 1.5rem;
    }

    .currently__list {
      flex-direction: column;
    }
  }
</style>
