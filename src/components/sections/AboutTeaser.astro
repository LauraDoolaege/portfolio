---
// Section 04: who am I. The statement runs in columns 1-8, one sentence per line, with "marketer turned experience designer" scribbled
// out by hand, one big scribble over both rows; the photo sits in columns 9-12 with a mustache drawn on it, and the way into the About page sits under it.
// Both marks are the page's only orange in the body and draw in once as they scroll into view.
// Hero's "Get to know me" link jumps here (#about).
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { withBase } from '../../utils/url';
import photo from '../../assets/images/photo_aboutTeaser.jpeg';
---

<section class="sec" id="about" aria-labelledby="about-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel num="04" text="About" data-reveal />
      <h2 id="about-title" class="sec-title" data-reveal>
        Who am I
      </h2>
    </header>

    <div class="about__grid">
      <p class="about__statement" data-reveal>
        <span class="about__line about__line--lead">
          <span class="about__row">A marketer turned</span>
          <span class="about__row">experience designer.</span>
          <svg class="about__scribble" viewBox="0 0 400 130" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-about-mark><path pathLength="1" d="M 4 112 C 30 70, 50 20, 70 8 C 82 4, 86 30, 84 60 C 84 100, 82 120, 100 122 C 118 124, 122 60, 126 20 C 128 6, 144 4, 146 40 C 148 90, 148 118, 166 120 C 184 120, 184 40, 190 14"></path><path pathLength="1" d="M 190 14 C 196 2, 212 6, 212 50 C 212 100, 214 122, 232 120 C 250 118, 250 50, 256 16 C 260 4, 276 6, 276 50 C 276 100, 280 122, 298 118 C 316 114, 316 44, 322 16 C 328 4, 344 8, 344 54 C 344 100, 350 122, 368 116"></path><path pathLength="1" d="M 368 116 C 390 104, 402 60, 394 22 C 388 4, 372 10, 356 36 C 300 120, 150 84, 84 96 C 40 104, 14 90, 12 70 C 80 50, 240 22, 392 66"></path></svg>
        </span>
        <span class="about__line">But so much more than that...</span>
      </p>

      <figure class="about__figure media-frame" data-reveal>
        <Image
          class="media-frame__img about__photo"
          src={photo}
          alt="Laura Doolaege on a motorbike, looking at the camera"
          widths={[700, 1000, 1400]}
          sizes="(min-width: 1000px) 50vw, 100vw"
        />
        <!-- Positioned in % of the square frame, under the nose in the cropped photo -->
        <svg class="about__mustache" style="--off: 2s" viewBox="0 0 120 44" aria-hidden="true" focusable="false" data-about-mark>
          <path pathLength="1" d="M 60 14 C 50 28, 30 34, 14 24 C 4 20, 6 8, 14 10"></path><path pathLength="1" d="M 60 14 C 70 28, 90 34, 106 24 C 116 20, 114 8, 106 10"></path>
        </svg>
      </figure>

      <div class="about__link" data-reveal>
        <Button variant="link" href={withBase('/about')}>
          Get to know me better
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem var(--grid-gutter);
  }

  .about__statement {
    display: grid;
    gap: 0.35em;
    font-size: clamp(1.9rem, 1rem + 2.6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .about__line {
    display: block;
    font-weight: var(--weight-light);
  }

  /* The first sentence is set as two fixed rows so its box hugs the words; the scribble then covers exactly
     that box, both lines at once */
  .about__line--lead {
    position: relative;
    width: max-content;
    max-width: 100%;
    font-weight: var(--weight-bold);
  }

  .about__row {
    display: block;
    white-space: nowrap;
  }

  /* One big scribble-out over both rows. It overshoots the words a little on purpose. */
  .about__scribble {
    position: absolute;
    left: -3%;
    top: -0.08em;
    width: 106%;
    height: calc(100% + 0.16em);
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .about__figure {
    position: relative;
    width: min(100%, 24rem);
    aspect-ratio: 1 / 1;
  }

  /* Black and white, like the hero portrait, so the orange line is the only colour on it */
  .about__photo {
    filter: grayscale(1) contrast(1.05);
  }

  /* Cropped in on the face: the frame shows the middle of a 175% image (the face sits at ~48% / 30% of the original) */
  .about__figure :global(.about__photo) {
    position: absolute;
    left: -38%;
    top: -6%;
    width: 175%;
    height: 175%;
    max-width: none;
  }

  .about__mustache {
    position: absolute;
    z-index: 3;
    left: 35%;
    top: 46.4%;
    width: 18%;
    height: auto;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .about__scribble path,
  .about__mustache path {
    fill: none;
    stroke: var(--accent);
    /* The signature's weight: 6px, 8px on desktop, constant on screen whatever the box size */
    stroke-width: 6px;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Armed by the script (so no-JS and reduced-motion visitors see the finished marks); a zero-length dash still
     paints a round cap, so each path stays hidden until it starts drawing */
  @media (min-width: 1000px) {
    .about__scribble path,
    .about__mustache path {
      stroke-width: 8px;
    }
  }

  [data-about-mark].is-armed path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  /* Sketched, not wiped on: every pass is its own pen stroke that starts quick and slows as it lands, with a short
     lift of the pen between strokes (--off staggers the marks against each other). Opacity flips on with each
     stroke's own delay, so no stray round-cap dot shows while a stroke waits its turn. */
  [data-about-mark].is-drawn path {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset 0.5s cubic-bezier(0.35, 0.1, 0.25, 1) var(--delay, 0s),
      opacity 0s linear var(--delay, 0s);
  }

  [data-about-mark] path:nth-child(1) {
    --delay: var(--off, 0s);
  }

  [data-about-mark] path:nth-child(2) {
    --delay: calc(var(--off, 0s) + 1s);
  }

  [data-about-mark] path:nth-child(3) {
    --delay: calc(var(--off, 0s) + 1.9s);
  }

  .about__scribble path {
    transition-duration: 1s, 0s;
  }

  .about__link {
    padding-top: 1.25rem;
    border-top: var(--hairline);
    width: min(100%, 24rem);
  }

  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      align-items: start;
    }

    .about__statement {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
    }

    .about__figure {
      grid-column: 9 / 13;
      grid-row: 1;
      width: 100%;
    }

    .about__link {
      grid-column: 9 / 13;
      grid-row: 2;
      width: 100%;
    }
  }
</style>

<script>
  const marks = document.querySelectorAll<SVGElement>('[data-about-mark]');
  if (marks.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-drawn');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    marks.forEach((m) => {
      m.classList.add('is-armed');
      io.observe(m);
    });
  }
</script>
