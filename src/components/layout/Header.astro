---
// Navigation bar: wordmark left, links right.
import { withBase } from '../../utils/url';

const links = [
  { href: `${withBase('/')}#work`, label: 'Work' },
  { href: withBase('/about'), label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase('/')} class="site-header__name">
      Laura Doolaege
    </a>
    <nav aria-label="Primary">
      <ul class="site-header__links">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link"
              data-magnetic
              aria-current={l.href === currentPath ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li class="site-header__theme">
          <button class="theme-toggle" type="button" aria-label="Switch to dark mode">
            <span class="theme-toggle__icon" aria-hidden="true"></span>
            <span class="theme-toggle__label">Dark</span>
          </button>
        </li>
      </ul>
    </nav>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>

  <!-- Phones: the links move into a full-screen menu in the inverted palette -->
  <div class="menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <ul class="menu__links">
      {links.map((l) => (
        <li>
          <a href={l.href} class="menu__link">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <button class="theme-toggle menu__theme" type="button" aria-label="Switch to dark mode">
      <span class="theme-toggle__icon" aria-hidden="true"></span>
      <span class="theme-toggle__label">Dark</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 60;
    border-bottom: var(--hairline);
  }

  /* Above the open menu */
  .site-header__inner {
    position: relative;
    z-index: 2;
  }

  /* Hamburger: two bars that cross into an X. Hidden above the phone breakpoint. */
  .menu-toggle {
    display: none;
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.5s var(--ease-out),
      top 0.5s var(--ease-out);
  }

  .menu-toggle__bar:first-child {
    top: calc(50% - 4px);
  }

  .menu-toggle__bar:last-child {
    top: calc(50% + 3px);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:first-child {
    top: 50%;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:last-child {
    top: 50%;
    transform: rotate(-45deg);
  }

  /* The menu: full screen, the page's ink as its ground and the page's ground as its type (so it is beige in
     dark mode and charcoal in light). Revealed with the same grainy sweep as the theme switch (see the script). */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 5rem var(--page-margin) 3rem;
    background: var(--text-main);
    color: var(--bg-primary);
    /* Left-aligned like every page: the links hang from the page margin */
    text-align: left;
  }

  .menu[hidden] {
    display: none;
  }

  /* Same toggle as the bar's, set at the foot of the menu in the menu's own ink */
  .menu .menu__theme {
    position: absolute;
    right: auto;
    bottom: 2rem;
    left: var(--page-margin);
    z-index: auto;
    min-height: 2.75rem;
    padding: 0.9rem 0;
    color: var(--bg-primary);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .menu__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 4vh, 2rem);
  }

  .menu__link {
    display: block;
    padding: 0.2em 0;
    font-size: clamp(2.75rem, 1.5rem + 11vw, 4.5rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .menu__link:focus-visible {
    outline: 1.5px solid currentColor;
    outline-offset: 0.1em;
  }

  /* Open: the header's own marks flip to the menu's palette so they stay readable on it */
  :global(html.menu-open) {
    overflow: hidden;
  }

  :global(html.menu-open) .site-header {
    border-color: color-mix(in srgb, var(--bg-primary) 22%, transparent);
    color: var(--bg-primary);
  }

  :global(html.menu-open) .site-header__links .theme-toggle {
    color: var(--bg-primary);
  }

  @media (max-width: 719px) {
    .menu-toggle {
      display: block;
    }

    /* The links and the theme toggle both live in the menu now */
    .site-header__inner .site-header__links {
      display: none;
    }
  }

  @media (min-width: 720px) {
    .menu {
      display: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--grid-gutter);
    padding-block: 1.25rem;
    font-size: var(--text-small);
    font-weight: var(--weight-regular);
  }

  .site-header__name {
    white-space: nowrap;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    color: var(--text-muted);
  }

  /* Slashes sit between items only: never before the first one */
  .site-header__links li + li::before {
    content: '/';
    margin-inline: clamp(0.6rem, 0.3rem + 1vw, 1.1rem);
    color: var(--text-muted);
  }

  .site-header__links a {
    position: relative;
    padding-block: 0.35em;
    transition:
      color var(--duration) var(--ease-out),
      opacity var(--duration) var(--ease-out);
  }

  /* The theme toggle is the last item in the row: no slash before it, and it stops being fixed. Its base look
     stays in global.css (.theme-toggle); the parent class here is what outranks that fixed positioning. */
  .site-header__links li + li.site-header__theme::before {
    content: none;
  }

  .site-header__theme {
    margin-left: clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .site-header__links .theme-toggle {
    position: relative;
    right: auto;
    bottom: auto;
    z-index: auto;
    padding: 0.35em 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .site-header__links .theme-toggle__label::before {
    content: '( ';
  }

  .site-header__links .theme-toggle__label::after {
    content: ' )';
  }

  /* Hover: the hovered link stays full strength, its siblings dim */
  .site-header__links:hover a {
    opacity: 0.5;
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    opacity: 1;
    color: var(--text-main);
  }

  /* Current page: full ink, with the same thin line the hover draws, held open */
  .site-header__links a[aria-current='page'] {
    color: var(--text-main);
  }

  .site-header__links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Touch and phone widths: the marks stay small, their hit areas grow to ~44px without moving anything */
  @media (hover: none), (max-width: 719px) {
    .site-header__name,
    .site-header__links a,
    .site-header__links .theme-toggle {
      position: relative;
    }

    .site-header__name::before,
    .site-header__links a::before,
    .site-header__links .theme-toggle::before {
      content: '';
      position: absolute;
      inset: -0.75rem -0.5rem;
    }
  }

  /* Narrow phones: no room for the word, so the toggle is its half-moon icon alone (still named by aria-label) */
  @media (max-width: 479px) {
    .site-header__links .theme-toggle__label {
      display: none;
    }

    .site-header__theme {
      margin-left: 0.9rem;
    }
  }
</style>

<script>
  import { sweepWith } from '../../scripts/theme';

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const wide = window.matchMedia('(min-width: 720px)');
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function set(open: boolean) {
    if (!button || !menu) return;
    menu.hidden = !open;
    root.classList.toggle('menu-open', open);
    // The page behind an open menu is out of reach (Tab, screen reader and pointer alike)
    document.querySelectorAll('main, footer').forEach((el) => el.toggleAttribute('inert', open));
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  function toggle(open: boolean, animate = true) {
    if (!button || !menu || root.classList.contains('menu-open') === open) return;
    if (animate && !reduce() && 'startViewTransition' in document) {
      sweepWith(() => set(open));
    } else {
      set(open);
      // No View Transitions: a plain fade in
      if (open && animate && !reduce())
        menu.animate({ opacity: [0, 1] }, { duration: 400, easing: 'ease-out' });
    }
    if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (animate) button.focus({ preventScroll: true });
  }

  button?.addEventListener('click', () => toggle(!root.classList.contains('menu-open')));
  // Picking a link closes the menu at once, then the browser follows the link
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) toggle(false, false);
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggle(false);
    // Focus stays inside the open menu: the toggle, the links and the theme button, in a loop
    if (e.key === 'Tab' && root.classList.contains('menu-open') && button && menu) {
      const ring = [button, ...Array.from(menu.querySelectorAll<HTMLElement>('a, button'))];
      const first = ring[0];
      const last = ring[ring.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
  wide.addEventListener('change', () => {
    if (wide.matches) toggle(false, false);
  });
</script>
