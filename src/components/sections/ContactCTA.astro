---
// Homepage contact CTA (PROJECT_BRIEF.md Section 4, item 6). Copy is exact,
// final text from the brief. Uses dark-field — locked as "footer / at most
// one controlled CTA band" (CLAUDE.md Design system, Section 3 palette
// table) — as the one sanctioned dark moment leading straight into the
// (also dark-field) Footer, so the two read as one deliberate closing
// zone rather than two unrelated dark patches.
//
// The CTA button is a local, dark-context copy of Button.astro's primary
// style rather than a reuse of that component: Button hardcodes ink/
// porcelain colors, which would go invisible (ink-on-near-black) on this
// background. Duplicating the small hairline/fill-sweep pattern here is
// simpler than threading color overrides through a shared component for
// what is currently a single use. Its hover transitions were softened to
// match Button.astro's own `--motion-easing-soft` fix (see that file).
//
// A porcelain-to-transparent gradient wash briefly sat over this
// section's own top edge (an attempt at "a smooth transition... between
// the design principles, gallery and contact me/footer") - removed again
// per direct follow-up ("remove the awful fade at the bottom of the
// page"). The underlying ask (the sections should read as flowing into
// each other, not cutting) is still open; explicitly deferred rather
// than immediately re-attempted with a different technique.
import { withBase } from '../../utils/url';

// TODO: point at a real destination once the Contact page (PROJECT_BRIEF.md
// Section 5, PROPOSED) is approved and built, or a real email is supplied.
const contactHref = withBase('/contact');
---

<section class="contact-cta">
  <div class="contact-cta__inner">
    <h2 class="contact-cta__headline">Enough about me. Let's hear your side of the story.</h2>
    <a href={contactHref} class="contact-cta__button">
      <span class="contact-cta__button-label">Get in touch</span>
    </a>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const headline = document.querySelector<HTMLElement>('.contact-cta__headline');
  const button = document.querySelector<HTMLElement>('.contact-cta__button');
  if (headline && button && !prefersReducedMotion()) {
    // This section had no motion at all before - a plain, calm fade/rise,
    // headline first then the button a beat later. Reused across both
    // pages (About also renders this component unmodified), so it needed
    // to be simple and content-agnostic, not a bespoke sequence.
    gsap.set([headline, button], { autoAlpha: 0, y: 20 });
    gsap
      .timeline({ scrollTrigger: { trigger: headline, start: 'top 85%' } })
      .to(headline, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power2.out' })
      .to(button, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, 0.15);
  }
</script>

<style>
  .contact-cta {
    padding-block: var(--space-section);
    background: var(--color-dark-field);
    color: var(--color-bg-primary);
  }

  .contact-cta__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
    text-align: center;
  }

  .contact-cta__headline {
    max-width: 20ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.5vw + 1rem, var(--text-h2));
    line-height: var(--text-h2-leading);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .contact-cta__button {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-block;
    margin-top: 2.5rem;
    padding: 0.9em 1.6em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-bg-primary);
    border: var(--border-hairline) solid var(--color-bg-primary);
    /* --motion-easing-soft, matching Button.astro's own primary variant
                         (this is a local dark-context copy of it) - same "tactile glide"
                         fix applied there per direct feedback. */
    transition:
      color var(--motion-duration) var(--motion-easing-soft),
      transform var(--motion-duration) var(--motion-easing-soft);
  }

  .contact-cta__button-label {
    position: relative;
    z-index: 1;
  }

  .contact-cta__button::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-duration-slow) var(--motion-easing-soft);
  }

  .contact-cta__button:hover,
  .contact-cta__button:focus-visible {
    color: var(--color-dark-field);
  }

  .contact-cta__button:hover::before,
  .contact-cta__button:focus-visible::before {
    transform: scaleX(1);
  }

  .contact-cta__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .contact-cta__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
