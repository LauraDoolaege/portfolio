---
// Section 04: who am I. The statement runs in columns 1-8, one sentence per line, with "marketer turned experience designer" scribbled
// out by hand, one long vertical scribble; the photo sits in columns 9-12 with a mustache drawn on it, and the way into the About page sits under it.
// Both marks are the page's only orange in the body and draw in once as they scroll into view.
// Hero's "Get to know me" link jumps here (#about).
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { withBase } from '../../utils/url';
import photo from '../../assets/images/photo_aboutTeaser.jpeg';
---

<section class="sec" id="about" aria-labelledby="about-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel num="04" text="About" data-reveal />
      <h2 id="about-title" class="sec-title" data-reveal>
        Who am I
      </h2>
    </header>

    <div class="about__grid">
      <p class="about__statement" data-reveal>
        <span class="about__line about__line--lead">
          A <span class="about__struck">marketer turned<svg class="about__scribble" viewBox="0 0 410 130" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-about-mark><path pathLength="1" d="M 2 130 C 12 101, 39 91, 64 117 C 69 94, 84 88, 93 81 C 150 49, 189 13, 228 6"></path><path pathLength="1" d="M 228 6 C 237 6, 234 36, 222 62 C 214 81, 208 94, 212 102 C 222 88, 231 62, 243 54 C 255 49, 260 62, 258 84 C 256 110, 254 117, 258 117 C 276 117, 291 88, 297 75 C 303 65, 310 75, 314 91 C 315 110, 312 120, 320 117"></path><path pathLength="1" d="M 320 117 C 342 101, 369 62, 393 41 C 404 32, 408 46, 402 62 C 398 78, 399 94, 398 101 C 393 117, 387 120, 388 110"></path></svg></span> experience designer.
        </span>
        <span class="about__line">But so much more than that...</span>
      </p>

      <figure class="about__figure media-frame" data-reveal>
        <Image
          class="media-frame__img about__photo"
          src={photo}
          alt="Laura Doolaege on a motorbike, looking at the camera"
          widths={[700, 1000, 1400]}
          sizes="(min-width: 1000px) 50vw, 100vw"
        />
        <!-- Positioned in % of the square frame, under the nose in the cropped photo -->
        <svg class="about__mustache" style="--off: 0.5s" viewBox="0 0 120 44" aria-hidden="true" focusable="false" data-about-mark>
          <path pathLength="1" d="M 60 14 C 50 28, 30 34, 14 24 C 4 20, 6 8, 14 10"></path><path pathLength="1" d="M 60 14 C 70 28, 90 34, 106 24 C 116 20, 114 8, 106 10"></path>
        </svg>
      </figure>

      <div class="about__link" data-reveal>
        <Button variant="link" href={withBase('/about')}>
          Get to know me better
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem var(--grid-gutter);
  }

  .about__statement {
    display: grid;
    gap: 0.35em;
    font-size: clamp(1.9rem, 1rem + 2.6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .about__line {
    display: block;
    font-weight: var(--weight-light);
  }

  .about__line--lead {
    font-weight: var(--weight-bold);
    text-wrap: balance;
  }

  .about__struck {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  /* One long scribble: it starts under the first line, climbs through "marketer", zigzags back down through "turned"
     and lands on "designer" below. It overshoots the words on purpose. */
  .about__scribble {
    position: absolute;
    left: -6%;
    top: -0.5em;
    width: 128%;
    height: 2.5em;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .about__figure {
    position: relative;
    width: min(100%, 24rem);
    aspect-ratio: 1 / 1;
  }

  /* Black and white, like the hero portrait, so the orange line is the only colour on it */
  .about__photo {
    filter: grayscale(1) contrast(1.05);
  }

  /* Cropped in on the face: the frame shows the middle of a 175% image (the face sits at ~48% / 30% of the original) */
  .about__figure :global(.about__photo) {
    position: absolute;
    left: -38%;
    top: -6%;
    width: 175%;
    height: 175%;
    max-width: none;
  }

  .about__mustache {
    position: absolute;
    z-index: 3;
    left: 35%;
    top: 46.4%;
    width: 18%;
    height: auto;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .about__scribble path,
  .about__mustache path {
    fill: none;
    stroke: var(--accent);
    /* The signature's weight: 6px, 8px on desktop, constant on screen whatever the box size */
    stroke-width: 6px;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Armed by the script (so no-JS and reduced-motion visitors see the finished marks); a zero-length dash still
     paints a round cap, so each path stays hidden until it starts drawing */
  @media (min-width: 1000px) {
    .about__scribble path,
    .about__mustache path {
      stroke-width: 8px;
    }
  }

  [data-about-mark].is-armed path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  /* Sketched, not wiped on: every pass is its own pen stroke that starts quick and slows as it lands, with a short
     lift of the pen between strokes (--off staggers the marks against each other). Opacity flips on with each
     stroke's own delay, so no stray round-cap dot shows while a stroke waits its turn. */
  [data-about-mark].is-drawn path {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset 0.5s cubic-bezier(0.35, 0.1, 0.25, 1) var(--delay, 0s),
      opacity 0s linear var(--delay, 0s);
  }

  [data-about-mark] path:nth-child(1) {
    --delay: var(--off, 0s);
  }

  [data-about-mark] path:nth-child(2) {
    --delay: calc(var(--off, 0s) + 0.6s);
  }

  [data-about-mark] path:nth-child(3) {
    --delay: calc(var(--off, 0s) + 1.45s);
  }

  .about__scribble path:nth-child(1) {
    transition-duration: 0.7s, 0s;
  }

  .about__scribble path:nth-child(2) {
    transition-duration: 0.8s, 0s;
  }

  .about__scribble path:nth-child(3) {
    transition-duration: 0.55s, 0s;
  }

  .about__link {
    padding-top: 1.25rem;
    border-top: var(--hairline);
    width: min(100%, 24rem);
  }

  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      align-items: start;
    }

    .about__statement {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
    }

    .about__figure {
      grid-column: 9 / 13;
      grid-row: 1;
      width: 100%;
    }

    .about__link {
      grid-column: 9 / 13;
      grid-row: 2;
      width: 100%;
    }
  }
</style>

<script>
  const marks = document.querySelectorAll<SVGElement>('[data-about-mark]');
  if (marks.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-drawn');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    marks.forEach((m) => {
      m.classList.add('is-armed');
      io.observe(m);
    });
  }
</script>
