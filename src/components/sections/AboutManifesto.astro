---
// About hero: no boxes, just fluid typography. One big, heavy greeting.
---

<section class="manifesto-hero" aria-labelledby="about-title">
  <div class="container">
    <h1 id="about-title" class="manifesto-hero__title">
      <span class="mask">
        <span class="line line--heavy">Hi, I’m Laura.</span>
      </span>
    </h1>
    <p class="manifesto-hero__sub">
      UX design student. Looking for an internship from February 2027.
    </p>
  </div>
</section>

<style>
  /* The sections below bring their own top padding, so the hero only needs a short tail */
  .manifesto-hero {
    padding-block: clamp(3rem, 2rem + 6vw, 9rem) clamp(1rem, 0.5rem + 2vw, 3rem);
  }

  .manifesto-hero__title {
    max-width: 16em;
    font-size: clamp(2.75rem, 1rem + 7vw, 8.5rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .manifesto-hero__sub {
    max-width: 34ch;
    margin-top: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.875rem);
    font-weight: var(--weight-light);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .mask + .mask {
    margin-top: 0.15em;
  }

  .line {
    display: block;
  }

  .line--heavy {
    font-weight: var(--weight-heavy);
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const lines = gsap.utils.toArray<HTMLElement>('.manifesto-hero .line');

  if (lines.length && !prefersReducedMotion()) {
    // Start state set in JS so no-JS visitors still see the text.
    gsap.set(lines, { yPercent: 105 });
    gsap.to(lines, { yPercent: 0, duration: 1.2, ease: 'power4.out', stagger: 0.16 });

    const sub = document.querySelector<HTMLElement>('.manifesto-hero__sub');
    if (sub) {
      gsap.set(sub, { y: 16, opacity: 0 });
      gsap.to(sub, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', delay: 0.5 });
    }
  }
</script>
