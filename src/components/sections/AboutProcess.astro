---
// About page "How I work" (PROJECT_BRIEF.md Section 4/5, item 3): the
// analog-first process description. Copy is final, supplied directly by
// the user, kept verbatim except one em dash rewritten as a colon (see
// AboutStory's frontmatter comment - same reason). No new copy here
// either: the same three step groupings/labels from the previous pass
// carry over unchanged (see git history for that pass's own reasoning
// on why "Analog first"/"Collaborate"/"Go digital" are structural
// captions, not new claims in her voice).
//
// Third rebuild of this section's interaction model - direct follow-up,
// "the giant circle does not need to be there, I want that on scroll, a
// new step appears at the top, and while hovering the section you get
// little images that belong to the step." The circular diagram (ring +
// three positioned steps) from the previous pass is gone entirely, not
// just re-skinned - replaced with a pinned scroll sequence: the section
// pins for a scroll distance, and as the reader scrolls through that
// range, the active step crossfades to the next one, always displayed
// in the same slot near the top of the stage. Each step carries its own
// small set of placeholder images, revealed only while the section is
// hovered (a fine pointer, not reduced motion) - "while hovering the
// section you get little images that belong to the step" is a hover-
// gated reveal, not a permanent gallery, so it's genuinely absent
// (opacity: 0, not just visually empty) until that gesture happens.
//
// Three response modes, not one mechanism forced everywhere:
// - Fine pointer, motion allowed, not phone width: the interactive
//   pinned/scrubbed/hover-gated version above.
// - Reduced motion, or no real hover (a touchscreen laptop, tablet,
//   etc. at non-phone widths): no pin, no hover-gating - every step
//   renders in normal document flow, already visible, images already
//   visible beneath their own step. Same "functional equivalent, no
//   gesture required" fallback this project uses everywhere a hover- or
//   motion-driven interaction has no equivalent (ProjectCard's touch
//   overlay, Gallery's tap-hint, etc.) - nothing here depends on a
//   gesture the device or the reader's own preference can't offer.
// - Phone specifically (max-width: 639px), regardless of motion
//   preference or hover support: a native horizontally-scrollable,
//   scroll-snapped strip - one step per "slide" - per direct request
//   ("on phone (and phone only) the half circle layout can change to
//   scrollable horizontally"). This is CSS-only (overflow-x + scroll-
//   snap-type), not GSAP-driven, so it needs no reduced-motion gate of
//   its own; a phone in reduced-motion mode still gets a real, working
//   swipeable strip rather than falling back further to a plain stack.
import SectionMarker from '../ui/SectionMarker.astro';

const steps = [
  {
    number: '01',
    label: 'Analog first',
    text: 'I like starting analog. Paper, whiteboards, sticky notes, messy diagrams: anything that lets ideas move faster than my concern for how they look.',
  },
  {
    number: '02',
    label: 'Collaborate',
    text: 'I especially enjoy collaborative ideation: getting different perspectives in the room, throwing ideas around, combining them and challenging each other’s assumptions.',
  },
  {
    number: '03',
    label: 'Go digital',
    text: 'Once the messy thinking starts to make sense, I move into digital tools and prototypes.',
  },
];
---

<section class="about-process">
  <div class="about-process__inner">
    <SectionMarker index="03" label="How I work" />

    <div class="about-process__stage">
      <div class="about-process__track">
        {steps.map((step, i) => (
          <div class="about-process__step" data-step={i}>
            <p class="about-process__step-heading">
              <span class="about-process__step-number" aria-hidden="true">
                {step.number}
              </span>
              <span class="about-process__step-label">{step.label}</span>
            </p>
            <p class="about-process__step-text">{step.text}</p>

            <div class="about-process__images" aria-hidden="true">
              <!-- TODO: replace with real process/whiteboard/prototype photography once it exists (PROJECT_BRIEF.md Section 6) - one small image per step, standing in for "what this step actually looked like." -->
              <span class="about-process__image-tile" />
              <span class="about-process__image-tile" />
              <span class="about-process__image-tile" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.about-process');
  const stage = document.querySelector<HTMLElement>('.about-process__stage');
  const stepEls = document.querySelectorAll<HTMLElement>('.about-process__step');

  if (section && stage && stepEls.length) {
    const reduceMotion = prefersReducedMotion();
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const isPhone = window.matchMedia('(max-width: 639px)').matches;

    if (!isPhone && !reduceMotion && canHover) {
      section.classList.add('about-process--interactive');
      stepEls[0].classList.add('is-active');

      gsap.set(stepEls, { autoAlpha: 0, y: 16 });
      gsap.set(stepEls[0], { autoAlpha: 1, y: 0 });

      // Only one step is ever the "active" one - its own .about-process__images
      // is the only one CSS lets opacity through on while
      // .about-process--interactive.is-hovering is set (see the
      // stylesheet). Crossfading via autoAlpha/y rather than a hard
      // swap so the new step genuinely "appears," not just pops in.
      let activeIndex = 0;
      const setActive = (index: number) => {
        if (index === activeIndex) return;
        const prev = stepEls[activeIndex];
        const next = stepEls[index];
        prev.classList.remove('is-active');
        next.classList.add('is-active');
        activeIndex = index;
        gsap.to(prev, { autoAlpha: 0, y: -16, duration: 0.4, ease: 'power2.in' });
        gsap.fromTo(
          next,
          { autoAlpha: 0, y: 16 },
          { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power2.out' },
        );
      };

      // Pins the stage for a fixed scroll distance (450px per step) and
      // drives which step is active off the pin's own scrub progress -
      // "on scroll, a new step appears." 450px/step is enough scroll
      // room to feel deliberate without turning a 3-step section into
      // an outsized scroll-jack.
      ScrollTrigger.create({
        trigger: stage,
        start: 'top top',
        end: () => `+=${stepEls.length * 450}`,
        pin: true,
        scrub: 1,
        onUpdate: (self) => {
          const idx = Math.min(stepEls.length - 1, Math.floor(self.progress * stepEls.length));
          setActive(idx);
        },
      });

      section.addEventListener('pointerenter', () => section.classList.add('is-hovering'));
      section.addEventListener('pointerleave', () => section.classList.remove('is-hovering'));
    } else {
      // Reduced motion, no real hover, or (handled entirely in CSS,
      // needs no branch here) phone width - every step and its images
      // are already visible, no pin and no gesture required.
      gsap.set(stepEls, { autoAlpha: 1, y: 0 });
    }
  }
</script>

<style>
  .about-process {
    padding-block: var(--space-section);
    /* Plate boundary - see AboutStory's matching rule for why. */
    border-top: var(--border-hairline) solid var(--color-text-secondary);
  }

  .about-process__inner {
    max-width: var(--intro-max-width);
    margin-inline: auto;
    padding-inline: var(--intro-margin);
  }

  .about-process__stage {
    margin-top: var(--space-64);
  }

  /* Base/fallback layout: every step stacked in normal flow, already
     visible - this is what non-interactive devices (reduced motion, no
     real hover) get permanently, and what phone briefly is before the
     639px override below turns it into a horizontal strip. */
  .about-process__track {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
  }

  .about-process__step {
    width: 100%;
    max-width: 36rem;
  }

  .about-process__step-heading {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    margin: 0 0 var(--space-8);
  }

  .about-process__step-number {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .about-process__step-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .about-process__step-text {
    margin: 0;
    max-width: 42ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  /* Always visible in the fallback layout - "little images that belong
     to the step" without a hover gate once there's no reliable hover to
     gate behind. A small resting tilt on the outer two tiles for the
     same "pinned by hand" read the rest of this page's placeholders
     already use. */
  .about-process__images {
    display: flex;
    gap: var(--space-16);
    margin-top: var(--space-24);
  }

  .about-process__image-tile {
    display: block;
    width: 5rem;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
  }

  .about-process__image-tile:nth-child(1) {
    rotate: -3deg;
  }

  .about-process__image-tile:nth-child(3) {
    rotate: 2deg;
  }

  /* --- Interactive mode (fine pointer, motion allowed, not phone) --- */
  /* Added by the script, never present without JS - the fallback layout
     above already renders correctly with no JS at all. */
  .about-process--interactive .about-process__stage {
    display: flex;
    align-items: center;
    min-height: 70vh;
  }

  .about-process--interactive .about-process__track {
    position: relative;
    width: 100%;
    max-width: 42rem;
  }

  /* Every step stacks in the exact same spot - the crossfade (script)
     is what makes only one read as present at a time, "a new step
     appears" in place of the last rather than pushing the page's own
     layout around. */
  .about-process--interactive .about-process__step {
    position: absolute;
    inset: 0;
    max-width: 42rem;
  }

  /* Hidden by default - only the currently active step's own images
     show, and only while the section is genuinely hovered (JS toggles
     both classes; CSS never shows this from one alone). */
  .about-process--interactive .about-process__images {
    opacity: 0;
    transition: opacity var(--motion-duration-slow) var(--motion-easing-soft);
  }

  .about-process--interactive.is-hovering .about-process__step.is-active .about-process__images {
    opacity: 1;
  }

  @media (max-width: 639px) {
    .about-process__inner {
      padding-inline: 1.5rem;
    }

    .about-process__stage {
      margin-top: var(--space-32);
    }

    /* Phone-only horizontal scroll-snap strip, regardless of motion
         preference or hover support - per direct request. Plain
         overflow-x/scroll-snap, no GSAP: native scrolling needs no
         reduced-motion gate of its own, so a phone in reduced-motion mode
         still gets a real swipeable strip instead of falling back further
         to a plain stack. The interactive-mode rules above never apply
         here - `canHover` is false on essentially every phone, and this
         breakpoint's own layout takes priority regardless. */
    .about-process__track {
      flex-direction: row;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }

    .about-process__step {
      flex: 0 0 100%;
      max-width: none;
      scroll-snap-align: start;
      padding-right: var(--space-24);
    }
  }
</style>
