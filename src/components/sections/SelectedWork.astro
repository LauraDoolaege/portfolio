---
// Section 2: Selected work. Two categories separated by whitespace:
// UX strategy (2 large cards) and visual explorations (tighter 3-column gallery).
// Cards come from the `works` content collection and link to /works/[slug].
const works = (await getCollection('works')).sort((a, b) => a.id.localeCompare(b.id));
const uxProjects = works.filter((w) => w.data.type === 'ux');
// Placeholder aspect ratios for the visual gallery, until real images set their own
const ratios = ['4 / 5', '1 / 1', '3 / 4'];
// Real images set their own aspect ratio; placeholders fall back to the given one
const natural = (w: (typeof works)[number], fallback: string) =>
  w.data.coverImage ? `${w.data.coverImage.width} / ${w.data.coverImage.height}` : fallback;
const visualProjects = works.filter((w) => w.data.type === 'visual');
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionLabel from '../ui/SectionLabel.astro';
import { withBase } from '../../utils/url';
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="container">
    <header class="work__header">
      <SectionLabel num="02" text="The Work" data-reveal />
      <h2 id="work-title" class="section-title work__title" data-reveal>
        Selected work
      </h2>
    </header>

    <div class="work__group">
      <div class="work__intro-row">
        <h3 class="work__group-title" data-reveal>
          UX Strategy
        </h3>
        <p class="work__intro" data-reveal>
          In these latest group projects, I got to dive deep into human needs through user
          interviews, insight gathering, wireframing, and validating solutions as a team.
        </p>
      </div>

      <ul class="work__grid work__grid--ux">
        {uxProjects.map((p) => (
          <li class="card" data-card="ux">
            <a class="card__link" href={withBase(`/works/${p.id}`)}>
              <div class="card__media" style={`aspect-ratio: ${natural(p, '4 / 3')}`}>
                {p.data.coverImage ? (
                  <Image
                    class="card__img"
                    src={p.data.coverImage}
                    alt={`${p.data.title}: cover`}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 900px) 50vw, 100vw"
                  />
                ) : (
                  <div class="card__img" />
                )}
              </div>
              <h4 class="card__title">{p.data.title}</h4>
              <ul class="card__tags" aria-label="Tools">
                {p.data.tools.slice(0, 2).map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="work__group work__group--divided">
      <div class="work__intro-row">
        <h3 class="work__group-title" data-reveal>
          Visual &amp; Concept Explorations
        </h3>
        <p class="work__intro" data-reveal>
          Same brain, different canvas. Even when there's no app to test, I'm still asking the UX
          questions: who is this for, what should they feel, and does it make sense?
        </p>
      </div>

      <ul class="work__grid work__grid--visual">
        {visualProjects.map((p, i) => (
          <li class="card" data-card="visual">
            <a class="card__link" href={withBase(`/works/${p.id}`)}>
              <div
                class="card__media"
                style={`aspect-ratio: ${natural(p, ratios[i % ratios.length])}`}
              >
                {p.data.coverImage ? (
                  <Image
                    class="card__img"
                    src={p.data.coverImage}
                    alt={`${p.data.title}: cover`}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 900px) 33vw, 50vw"
                  />
                ) : (
                  <div class="card__img" />
                )}
              </div>
              <h4 class="card__title">{p.data.title}</h4>
              <ul class="card__tags" aria-label="Tools">
                {p.data.tools.slice(0, 2).map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: var(--space-section);
  }

  /* Title and label spacing come from the shared .section-label / .section-title classes */
  .work__group:first-of-type {
    padding-top: 0;
  }

  .work__group {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 6rem);
  }

  .work__group:first-of-type {
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 6rem);
  }

  /* Categories are separated by space alone */
  .work__group--divided {
    padding-top: clamp(5rem, 3rem + 8vw, 11rem);
    padding-bottom: 0;
  }

  .work__intro-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: clamp(2rem, 1rem + 3vw, 4.5rem);
  }

  .work__group-title {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: 0;
  }

  .work__intro {
    max-width: 40ch;
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
    font-weight: var(--weight-light);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .work__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--grid-gutter);
    row-gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    align-items: start;
  }

  /* Cards */
  .card__media {
    overflow: hidden;
    background: #e6e4dd;
    margin-bottom: 1rem;
  }

  /* Analog darkroom: full color by default; warm, muted "print" on hover. The pan (x/y) and the resting 1.05 scale are set by GSAP in src/scripts/tactile.ts. */
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: linear-gradient(150deg, #c98f78, #a86a55);
    filter: grayscale(0%) sepia(0%) contrast(1);
    transition: filter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* Placeholder tones, so the color reveal is visible until real photos arrive */
  .card:nth-child(4n + 2) .card__img {
    background: linear-gradient(150deg, #a3ad92, #7f8b6f);
  }

  .card:nth-child(4n + 3) .card__img {
    background: linear-gradient(150deg, #d1b57a, #b08d4c);
  }

  .card:nth-child(4n) .card__img {
    background: linear-gradient(150deg, #9fb0b8, #7a8f99);
  }

  @media (hover: hover) {
    .card:hover .card__img {
      filter: grayscale(80%) sepia(20%) contrast(1.1);
    }
  }

  .card__link {
    display: block;
  }

  .card__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    margin-bottom: 0.75rem;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work__grid--visual .card__title {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
  }

  @media (min-width: 640px) {
    .work__grid--visual {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .work__intro-row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    .work__group-title {
      grid-column: 1 / span 4;
    }

    .work__intro {
      grid-column: 5 / -1;
    }

    .work__grid--ux {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Offset the second card so the pair isn't a flat row */
    .work__grid--ux .card:nth-child(2) {
      margin-top: clamp(3rem, 1rem + 7vw, 8rem);
    }

    .work__grid--visual {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
      row-gap: clamp(2rem, 1rem + 2vw, 3.5rem);
    }

    /* Asymmetry: the middle column drops down so the gallery doesn't read as a flat table */
    .work__grid--visual .card:nth-child(3n + 2) {
      margin-top: clamp(2rem, 1rem + 4vw, 5rem);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.work');

  if (section && !prefersReducedMotion()) {
    const texts = gsap.utils.toArray<HTMLElement>('[data-reveal]', section);
    const cards = gsap.utils.toArray<HTMLElement>('.card', section);

    // Start states are set in JS so no-JS visitors still see everything.
    gsap.set(texts, { y: 30, opacity: 0 });
    gsap.set(cards, { y: 40, opacity: 0 });

    const reveal = { y: 0, opacity: 1, duration: 1, ease: 'power3.out', overwrite: true };

    // Header and intro copy: each slides up as it enters the viewport
    ScrollTrigger.batch(texts, {
      start: 'top 88%',
      once: true,
      onEnter: (batch) => gsap.to(batch, { ...reveal, stagger: 0.12 }),
    });

    // Cards: staggered per row as they enter
    ScrollTrigger.batch(cards, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) => gsap.to(batch, { ...reveal, stagger: 0.15 }),
    });
  }
</script>
