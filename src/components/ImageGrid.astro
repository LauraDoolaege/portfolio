---
// Asymmetrical 2 or 3 image grid. Three images: one large on the left, two smaller stacked on the
// right. Two images: one large, one small dropped to the bottom right. Stacks on mobile.
import ProjectImage from './ProjectImage.astro';

interface Item {
  src?: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: Item[];
}

const { images } = Astro.props;
const count = Math.min(images.length, 3);
const items = images.slice(0, 3);
---

<div class={`image-grid image-grid--${count}`}>
  {items.map((img, i) => (
    <div class={`image-grid__cell image-grid__cell--${i + 1}`}>
      <ProjectImage
        {...img}
        tone={(i % 4) as 0 | 1 | 2 | 3}
        fill={count === 3 && i === 0}
        ratio={i === 0 ? '4 / 5' : count === 3 ? '1 / 1' : '3 / 4'}
      />
    </div>
  ))}
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .image-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .image-grid__cell--1 {
      grid-column: 1 / span 8;
    }

    .image-grid--3 .image-grid__cell--1 {
      grid-row: 1 / span 2;
    }

    .image-grid--3 .image-grid__cell--2,
    .image-grid--3 .image-grid__cell--3 {
      grid-column: 9 / span 4;
    }

    .image-grid--3 .image-grid__cell--3 {
      grid-row: 2;
    }

    .image-grid--2 {
      align-items: end;
    }

    .image-grid--2 .image-grid__cell--2 {
      grid-column: 9 / span 4;
    }
  }
</style>
