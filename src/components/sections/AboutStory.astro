---
// The journey: a small portrait on the left, the story on the right. Same section header as the homepage
// (label + title), same photo treatment as the homepage teaser (whole portrait, black and white).
import { Image } from 'astro:assets';
import SectionLabel from '../ui/SectionLabel.astro';
import photo from '../../assets/images/photo_aboutTeaser.png';

const paragraphs = [
  "Before I mapped a user journey or opened Figma, I earned a Bachelor's in Marketing Communication (cum laude). During my internship at CAW Oost-Vlaanderen I planned content, wrote letters to policy makers across Belgium, and led a workshop on my own to restructure their website's content. Looking back, that workshop was my first UX project. I just didn't know it yet.",
  "Honestly, it started earlier. On the playground I invented storylines where everyone got a part. At home I wrote stories starring my sister's favourite Nintendo characters to get her excited about reading. It worked: she now reads more than I do.",
  "Now I'm in my third year of Digital Design & Development (Devine) at Howest, majoring in UX design. I still love stories, just with more tools. Devine taught me to research and design experiences people actually need, and my marketing background helps me make sure those experiences reach them.",
];
---

<section class="sec" aria-labelledby="story-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel text="The journey" data-reveal />
      <h2 id="story-title" class="sec-title" data-reveal>
        From stories to experiences
      </h2>
    </header>

    <div class="story__grid">
      <figure class="story__figure media-frame" data-no-pan data-reveal>
        <Image
          class="media-frame__img story__photo"
          src={photo}
          alt="Portrait of Laura Doolaege looking at the camera"
          widths={[240, 480, 720]}
          sizes="16rem"
        />
      </figure>

      <div class="story__text">
        {paragraphs.map((p) => (
          <p class="text" data-reveal>
            {p}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem var(--grid-gutter);
  }

  .story__figure {
    width: min(100%, 16rem);
  }

  .story__figure :global(.story__photo) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) contrast(1.05);
  }

  .story__text {
    display: grid;
    gap: 1.1em;
    align-content: start;
  }

  .story__text .text {
    max-width: 52ch;
  }

  @media (min-width: 1000px) {
    .story__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .story__figure {
      grid-column: 1 / span 4;
    }

    .story__text {
      grid-column: 6 / span 6;
    }
  }
</style>
