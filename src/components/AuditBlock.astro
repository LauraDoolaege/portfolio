---
// Typographic block for critiquing older UI work: faint tint, no border, numbered label.
interface Props {
  num?: string;
}

const { num = '01' } = Astro.props;
---

<aside class="audit">
  <p class="audit__label">[ {num} ] Retrospective Audit</p>
  <div class="audit__body">
    <slot />
  </div>
</aside>

<style>
  .audit {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.75rem, 1rem + 4vw, 5rem);
    background: var(--accent-wash);
  }

  .audit__label {
    font-size: var(--text-small);
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: var(--accent-text);
  }

  .audit__body {
    max-width: 42ch;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.875rem);
    font-weight: var(--weight-light);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .audit__body :global(p + p) {
    margin-top: 1em;
  }

  .audit__body :global(strong) {
    font-weight: var(--weight-bold);
  }

  @media (min-width: 900px) {
    .audit {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    .audit__label {
      grid-column: 1 / span 4;
    }

    .audit__body {
      grid-column: 5 / -1;
    }
  }
</style>
