---
// One project in the homepage work grid. With a cover it is an image card; without one it is a plain
// text row (no empty grey box). Both link to the case study.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/url';

interface Props {
  project: CollectionEntry<'works'>;
  /** Image sizes hint for the grid this card sits in */
  sizes: string;
}

const { project: p, sizes } = Astro.props;
const TYPE_LABEL = { ux: 'UX Strategy', visual: 'Visual Exploration' } as const;
const cover = p.data.coverImage;
const href = withBase(`/works/${p.id}`);
---

{cover ? (
  <li class="card" data-reveal>
    <a class="card__link" href={href}>
      <div class="card__media" style={`aspect-ratio: ${cover.width} / ${cover.height}`}>
        <Image
          class="card__img"
          src={cover}
          alt={`${p.data.title}: cover`}
          widths={[400, 700, 1000, 1400]}
          sizes={sizes}
        />
      </div>
      <p class="card__type tag">{TYPE_LABEL[p.data.type]}</p>
      <h4 class="card__title">{p.data.title}</h4>
      <ul class="card__tags" aria-label="Tools">
        {p.data.tools.slice(0, 2).map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    </a>
  </li>
) : (
  <li class="entry" data-reveal>
    <a class="entry__link" href={href}>
      <h4 class="entry__title">{p.data.title}</h4>
      <p class="tag">{p.data.tools.slice(0, 2).join(' · ')}</p>
    </a>
  </li>
)}

<style>
  .card__media {
    margin-bottom: 1rem;
  }

  /* Soft mask, spotlight and grain come from .card__media in global.css; the pan (x/y) and the resting 1.05 scale are set by GSAP in src/scripts/tactile.ts. */
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .card__link {
    display: block;
  }

  .card__type {
    margin-bottom: 0.4rem;
  }

  .card__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    margin-bottom: 0.5rem;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  /* Text-only entry: spans the whole grid as a row, like the rows elsewhere on the page */
  .entry {
    grid-column: 1 / -1;
    border-top: var(--hairline);
  }

  .entry__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .entry__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    transition: color 0.4s var(--ease-out);
  }

  .entry__link:hover .entry__title,
  .entry__link:focus-visible .entry__title {
    color: var(--accent-text);
  }
</style>
