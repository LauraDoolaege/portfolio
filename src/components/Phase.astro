---
// Phase marker for UX case studies: "01 / The Brief". A hairline above gives the page a
// steady rhythm to skim against. The h2 is a .tag, the site's one label style.
interface Props {
  num: string;
  title: string;
}

const { num, title } = Astro.props;
---

<div class="phase">
  <h2 class="section-label tag">
    {num} / {title}
  </h2>
</div>

<style>
  .phase {
    margin-top: clamp(2.5rem, 1rem + 6vw, 7rem);
    padding-top: 1.25rem;
    border-top: var(--hairline);
  }

  .phase .section-label {
    margin-bottom: 0;
  }
</style>
