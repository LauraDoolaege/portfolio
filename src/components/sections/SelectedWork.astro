---
// Homepage "Selected work" (PROJECT_BRIEF.md Section 4, item 2). Content
// structure is final per the brief: two groups, three projects each -
// Design/individual work, Experience design/group projects. Real project
// titles are supplied (per direct message: "project 1 => Nine to Thrive,
// project 2 => Miles and Meals, project 3 => Kickstarter: Izumi" for
// Design, "a space journey through screentime, nexxus and plan A" for
// Experience) - each card's `fullTitle` (see ProjectCard.astro), visible
// at all times, including the accordion's collapsed/rotated spine label -
// an earlier version only revealed the real name on hover, generic
// "Project N" the rest of the time; direct follow-up asked for it to
// show always instead. Images still don't exist (Section 6), so the
// image slot stays a flat placeholder regardless.
//
// DESIGN_VARIANCE: 9 (see CLAUDE.md "Experimental design dials") — this is
// the section's second rebuild in one session. The first (an asymmetric
// 7fr/5fr bento, one featured card per group) was a direct improvement on
// the original equal-width triplet, but per direct follow-up feedback the
// user wasn't fond of it and asked for "something that expands" instead -
// an Awwwards-style expanding accordion strip: narrow panels at rest,
// one panel growing to take most of the row on hover/focus while its
// siblings compress. Both groups (Design, Experience) use the same
// accordion device now, same as the bento before it used one asymmetric
// device for both rather than singling one group out.
//
// This replaces the bento entirely rather than layering on top of it -
// `ProjectCard.astro`'s own `featured` prop (which only existed to size
// one card per bento row) is gone; every card in an accordion row is
// visually equal until hovered, so there's no "lead item" concept left to
// carry. The accordion's collapsed/expanded look is applied here, from
// outside ProjectCard, via `:global()` overrides scoped under
// `.selected-work__accordion` - ProjectCard itself stays exactly the
// generic ticket-card module the brief specifies (image, number, tag,
// year, title, arrow), unaware that this one section reshapes it.
//
// Mobile/tablet fallback (PROJECT_BRIEF.md Section 8 lists this as an open
// decision — flagging, not silently resolving): hover-driven expansion has
// no touch equivalent, so below min-width: 900px this drops to a plain
// equal-width stack of full, upright cards - the same "macro asymmetry
// drops to a plain stack below a width threshold" pattern already used
// for AboutDrives' scattered cards, Hero's own grid, and the bento this
// replaced.
import SectionMarker from '../ui/SectionMarker.astro';
import ProjectCard from '../ui/ProjectCard.astro';

const design = [
  { number: '01', title: 'Project 01', fullTitle: 'Nine to Thrive', roleTag: 'design' },
  { number: '02', title: 'Project 02', fullTitle: 'Miles and Meals', roleTag: 'design' },
  { number: '03', title: 'Project 03', fullTitle: 'Kickstarter: Izumi', roleTag: 'design' },
];

const experience = [
  {
    number: '04',
    title: 'Project 04',
    fullTitle: 'A Space Journey through Screentime',
    roleTag: 'experience design',
  },
  { number: '05', title: 'Project 05', fullTitle: 'Nexxus', roleTag: 'experience design' },
  { number: '06', title: 'Project 06', fullTitle: 'Plan A', roleTag: 'experience design' },
];
---

<section class="selected-work" id="work">
  <div class="selected-work__inner">
    <SectionMarker index="01" label="Selected work" />

    <p class="selected-work__intro">
      A mix of solo design work and collaborative experience-design projects.
    </p>

    <div class="selected-work__group">
      <h3 class="selected-work__group-label">Design: individual work</h3>
      <ul class="selected-work__accordion">
        {design.map((project) => (
          <li>
            <ProjectCard {...project} />
          </li>
        ))}
      </ul>
    </div>

    <div class="selected-work__group">
      <h3 class="selected-work__group-label">Experience design: group projects</h3>
      <ul class="selected-work__accordion">
        {experience.map((project) => (
          <li>
            <ProjectCard {...project} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .selected-work {
    padding-block: var(--space-section);
  }

  .selected-work__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .selected-work__intro {
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .selected-work__group {
    margin-top: 4.5rem;
  }

  /* Same fine-print weight as the header/hero location tag
     (.site-header__status / .hero__status) - text-label (12px) and
     text-secondary, not text-nav (14px) and full ink - per direct
     request to match "the same fine font as the belgium tag". */
  .selected-work__group-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  /* Mobile/tablet default: a plain equal-width stack of upright cards -
     see the file header comment on why hover-driven expansion doesn't
     get a touch fallback of its own. */
  .selected-work__accordion {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-32);
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    /* A fixed-height row is what makes an accordion read as one object
                         instead of three cards of changing aspect-ratio - the height stays
                         constant, only each panel's share of the width changes. 18rem, not
                         the 30rem this first shipped with - per direct feedback the panels
                         read as "quite tall" at that height, more like portrait cards than
                         the short, horizontal, rectangular strip that's actually wanted.
                         flex-grow (not width or flex-basis) is what's animated: every
                         panel starts equal (grow: 1) and the hovered/focused one steps up
                         to grow: 6, so it takes roughly 6/8 of the row while its two
                         siblings compress to about 1/8 each, without any JS or per-panel
                         width math. */
    .selected-work__accordion {
      display: flex;
      align-items: stretch;
      height: 18rem;
      gap: var(--space-16);
    }

    .selected-work__accordion > li {
      flex: 1 1 0%;
      min-width: 0;
      overflow: hidden;
      /* --motion-easing-soft, not a hand-typed cubic-bezier literal - see
                                             that token's own comment (global.css) for why this exact curve
                                             is now shared across several places instead of copy-pasted. */
      transition: flex-grow 0.6s var(--motion-easing-soft);
    }

    .selected-work__accordion > li:hover,
    .selected-work__accordion > li:focus-within {
      flex-grow: 6;
    }

    /* The card fills its panel's full box instead of holding its own
                             aspect-ratio - same "stretch to fill a flex/grid cell" technique
                             the bento's featured card used before this replaced it. */
    .selected-work__accordion :global(.project-card) {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .selected-work__accordion :global(.project-card__frame) {
      flex: 1 1 auto;
      aspect-ratio: auto;
    }

    /* Collapsed (rest) state: a panel this narrow has no room for a
                             horizontal title/tag/year row, so the title runs vertically along
                             the panel instead (the classic accordion-gallery "spine label"),
                             and the tag/year/dashed-stub - which would just wrap illegibly at
                             this width - are hidden rather than shrunk into something
                             unreadable. The number badge and arrow badge stay put; both are
                             already small, self-contained, and legible at any panel width. */
    /* A fixed height (not flex: 0 0 auto driven by content) - real titles
             vary a lot in length ("Plan A" vs "A Space Journey through
             Screentime"), and letting the body size itself to whichever title
             happens to be longest would squeeze the frame above it down to
             almost nothing on that one card, throwing off every card's frame/
             body proportion inconsistently. Fixing the height means every
             collapsed panel keeps the same frame/body split regardless of its
             own title length - the title wraps into more (narrower) columns
             instead of growing the body taller. */
    .selected-work__accordion :global(.project-card__body) {
      flex: 0 0 9rem;
      display: flex;
      align-items: center;
      padding: var(--space-16);
      overflow: hidden;
    }

    .selected-work__accordion :global(.project-card__stub),
    .selected-work__accordion :global(.project-card__meta) {
      display: none;
    }

    /* white-space: normal (not nowrap) matters once titles are real,
             supplied names instead of a short "Project N" placeholder - in
             vertical-rl, wrapping stacks a new column to the left instead of
             breaking the line downward. `height` here maps to the *inline*
             size in vertical-rl (block flows horizontally), so setting an
             explicit one is what actually forces that wrap to happen at all -
             without it the browser lets the column run as tall as the text
             needs, which is what let one long title's body swallow the whole
             card in an earlier version of this. 7rem = the body's own 9rem
             minus its 2 x space-16 padding. */
    .selected-work__accordion :global(.project-card__title) {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: normal;
      height: 7rem;
      font-size: 0.9rem;
      line-height: 1.3;
      letter-spacing: 0;
    }

    /* Expanded state: the panel is wide enough again for the card's
                             normal upright reading layout, so everything reverts - the title
                             un-rotates, the tag/year/stub reappear, the body padding grows
                             back to the card's usual space-24 inset. */
    .selected-work__accordion > li:hover :global(.project-card__body),
    .selected-work__accordion > li:focus-within :global(.project-card__body) {
      flex-basis: auto;
      align-items: flex-start;
      padding: var(--space-24);
      overflow: visible;
    }

    .selected-work__accordion > li:hover :global(.project-card__stub),
    .selected-work__accordion > li:focus-within :global(.project-card__stub) {
      display: block;
    }

    .selected-work__accordion > li:hover :global(.project-card__meta),
    .selected-work__accordion > li:focus-within :global(.project-card__meta) {
      display: flex;
    }

    .selected-work__accordion > li:hover :global(.project-card__title),
    .selected-work__accordion > li:focus-within :global(.project-card__title) {
      writing-mode: horizontal-tb;
      transform: none;
      height: auto;
      font-size: 1.5rem;
      line-height: 1.1;
      letter-spacing: -0.01em;
    }
  }

  @media (max-width: 640px) {
    .selected-work__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
