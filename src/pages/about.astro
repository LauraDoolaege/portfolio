---
// About: a narrative flow. Manifesto, journey, approach quote, toolkit.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import AboutManifesto from '../components/sections/AboutManifesto.astro';
import AboutStory from '../components/sections/AboutStory.astro';
import AboutApproach from '../components/sections/AboutApproach.astro';
import AboutToolkit from '../components/sections/AboutToolkit.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="About | Laura Doolaege"
  description="Laura's portfolio: digital development & design."
>
  <div class="page">
    <Header />
    <main id="main">
      <AboutManifesto />
      <AboutStory />
      <AboutApproach />
      <AboutToolkit />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>
