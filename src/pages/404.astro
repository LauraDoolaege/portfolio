---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="Page not found | Laura Doolaege" description="This page doesn't exist.">
  <div class="page">
    <Header />
    <main id="main" class="container not-found">
      <h1>Page not found</h1>
      <p class="subtitle">This page doesn't exist or has moved.</p>
      <a href={withBase('/')} class="btn">
        Back to the homepage
        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M3 9L9 3M4 3h5v5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </a>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .not-found {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: var(--space-section);
  }
</style>
