---
// Homepage "Currently working on" (PROJECT_BRIEF.md Section 4, item 4) —
// exactly 2 items per the brief: Blender/3D-header learning, and a
// hedgehog-led decentering-human-design UX project. The brief only gives
// short descriptors, not the Website Structure doc's exact sentences, so
// the one-line descriptions below are a direct expansion of those
// descriptors, not invented content — swap in the real copy if it differs.
//
// This section holds the page's one terracotta "wink" (PROJECT_BRIEF.md
// Section 3 palette table, accent-signal — locked, NOT touched by the
// design-variance override in CLAUDE.md): a single rotated asterisk after
// the heading, the exact example the brief itself gives for this color.
// It appears nowhere else on the homepage — don't add a second one.
//
// Sits directly below Selected Work, per direct request, and carries its
// own number again ("02" - Selected Work is "01", Principles "03",
// Gallery "04") - per a later direct request that every section's
// subtitle stay consistent (small index + bold title, the same device
// used everywhere else), this went back to using SectionMarker's index
// rather than staying the one deliberately unnumbered aside.
//
// Redesign pass (explicit feedback that this section "felt too stale or
// too condensed"): each item gained an image placeholder - a flat gray
// div, same placeholder language as ProjectCard's, not invented imagery -
// so two lines of text no longer sit alone in a wide empty row, and a
// settle-in entrance reveal (this section had no motion of its own at
// all before).
import SectionMarker from '../ui/SectionMarker.astro';

const items = [
  {
    title: 'Blender',
    description: 'Learning 3D: building a header piece.',
  },
  {
    title: 'Decentering the human',
    description: 'A hedgehog-led UX project on designing beyond human-centered defaults.',
  },
];
---

<section class="currently">
  <div class="currently__inner">
    <SectionMarker index="02" label="Currently working on">
      <span class="currently__wink" aria-hidden="true" slot="suffix">
        *
      </span>
    </SectionMarker>

    <ul class="currently__list">
      {items.map((item) => (
        <li class="currently__item">
          <span class="currently__image" aria-hidden="true">
            <!-- TODO: replace with a real process/progress image once photography exists (PROJECT_BRIEF.md Section 6) -->
          </span>
          <span class="currently__tag" aria-hidden="true">
            [ in progress ]
          </span>
          <h3 class="currently__title">{item.title}</h3>
          <p class="currently__description">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const items = document.querySelectorAll<HTMLElement>('.currently__item');
  if (items.length && !prefersReducedMotion()) {
    // A plain staggered settle - this section had no entrance motion at
    // all before the redesign pass; one quiet, shared reveal per item is
    // enough here, the image placeholders are the visual interest, not
    // the motion.
    gsap.set(items, { autoAlpha: 0, y: 24 });
    gsap.to(items, {
      autoAlpha: 1,
      y: 0,
      duration: 0.7,
      ease: 'power2.out',
      stagger: 0.12,
      scrollTrigger: { trigger: '.currently__list', start: 'top 85%' },
    });
  }
</script>

<style>
  .currently {
    padding-block: var(--space-section);
  }

  .currently__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .currently__wink {
    display: inline-block;
    color: var(--color-accent-signal);
    transform: rotate(-8deg);
  }

  .currently__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-48) var(--space-32);
    margin-top: var(--space-48);
  }

  .currently__item {
    display: flex;
    flex-direction: column;
  }

  .currently__image {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    border-radius: var(--radius-image);
  }

  .currently__tag {
    margin-top: var(--space-24);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
  }

  .currently__title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.25rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .currently__description {
    margin-top: 0.6rem;
    max-width: 38ch;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .currently__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
