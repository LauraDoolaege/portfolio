---
// A key insight in massive type ("We assumed X, but testing proved Y"). Breaks out of the
// 65ch reading column so it can't be missed while scrolling. Optional source line underneath.
interface Props {
  source?: string;
  // "md" for long statements such as How Might We questions
  size?: 'lg' | 'md';
}

const { source, size = 'lg' } = Astro.props;
---

<blockquote class:list={['pullquote', `pullquote--${size}`]}>
  <div class="pullquote__text">
    <slot />
  </div>
  {source && <footer class="pullquote__source">{source}</footer>}
</blockquote>

<style>
  .pullquote {
    margin: clamp(1.75rem, 1.25rem + 2vw, 3rem) 0;
  }

  .pullquote__text {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1rem + 6vw, 6.5rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    text-wrap: balance;
  }

  /* Markdown wraps the text in a <p>; it must take the quote's type, not the article's paragraph style */
  .pullquote__text :global(p) {
    max-width: none;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
  }

  .pullquote--md .pullquote__text {
    max-width: 32ch;
    font-size: clamp(1.375rem, 1.1rem + 1.1vw, 1.875rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .pullquote__source {
    margin-top: clamp(1rem, 0.75rem + 1vw, 2rem);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
</style>
