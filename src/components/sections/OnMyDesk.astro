---
// Section 03: what's on the desk right now. A rule under the title, then the two projects side by side (focus as a small
// label, the name, a few lines), with a hairline between them; stacked on phones.

const items = [
  {
    title: 'Ray Skincare',
    focus: '3D / Blender',
    description:
      'Translating a brand aesthetic into a 3D animated header. Exploring shading, texturing, and compositions in Blender.',
  },
  {
    title: 'Designing for Hedgehogs',
    focus: 'More than human design',
    description:
      'Researching non-human centric design. Mapping behaviors of actors you cannot communicate with directly to design beyond the human experience.',
  },
];
---

<section class="sec" aria-labelledby="desk-title">
  <div class="container">
    <header class="sec__head desk__head">
      <h2 id="desk-title" class="sec-title" data-reveal>
        On my desk right now
      </h2>
    </header>

    <ul class="desk__ledger">
      {items.map((item) => (
        <li class="desk__row" data-reveal>
          <p class="tag desk__focus">{item.focus}</p>
          <h3 class="desk__title">{item.title}</h3>
          <p class="desk__text">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* One rule under the title, then the two projects side by side, set the same way: the focus as a small label above,
     the name, then a few lines. On wide screens a vertical hairline sits between them; on phones they stack. */
  .desk__head {
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-bottom: var(--hairline);
    margin-bottom: 0;
  }

  .desk__ledger {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .desk__row {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
  }

  .desk__row + .desk__row {
    border-top: var(--hairline);
  }

  .desk__focus {
    padding: 0;
    color: var(--text-muted);
  }

  .desk__title {
    font-size: var(--text-title);
    font-weight: var(--weight-bold);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .desk__text {
    max-width: 44ch;
    font-size: var(--text-paragraph);
    font-weight: var(--weight-light);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .desk__ledger {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .desk__row {
      padding-inline: clamp(1.5rem, 1rem + 2vw, 3rem);
    }

    .desk__row:first-child {
      padding-left: 0;
    }

    .desk__row + .desk__row {
      border-top: 0;
      border-left: var(--hairline);
    }
  }
</style>
