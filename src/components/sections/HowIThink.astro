---
// Homepage "How I think" (PROJECT_BRIEF.md Section 4, item 5): a narrative
// intro followed by 3 cards. The card titles are exact, final copy from
// the brief. The intro line's exact wording isn't in the brief (only the
// card titles are quoted there) — the sentence below is a structural
// placeholder pending the Website Structure doc's real copy, same caveat
// as Hero's own open decisions.
//
// Cards use accent-soft (PROJECT_BRIEF.md Section 3 palette table: "card
// washes" is a named, locked use for this token) to read as a distinct
// triptych against the porcelain/chalk sections around them — this is the
// suggested "CardTriptych" component (Section 7), scoped to this section
// since nothing else needs it yet.
import SectionMarker from '../ui/SectionMarker.astro';

const principles = [
  { number: '01', title: 'Understand before designing' },
  { number: '02', title: 'Creative, but defendable' },
  { number: '03', title: 'Make it make sense' },
];
---

<section class="how-i-think">
  <div class="how-i-think__inner">
    <SectionMarker index="05" label="How I think" />

    <!-- TODO: replace with the exact intro line from the Website Structure doc once available -->
    <p class="how-i-think__intro">A few principles that shape how I approach a brief.</p>

    <ul class="how-i-think__grid">
      {principles.map((item) => (
        <li class="how-i-think__card">
          <span class="how-i-think__number" aria-hidden="true">
            {item.number}
          </span>
          <h3 class="how-i-think__title">{item.title}</h3>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .how-i-think {
    padding-block: var(--space-section);
  }

  .how-i-think__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .how-i-think__intro {
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .how-i-think__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .how-i-think__card {
    padding: 2.5rem 2rem;
    background: var(--color-accent-soft);
    border-radius: var(--radius-image);
  }

  @media (min-width: 900px) {
    .how-i-think__card:nth-child(2) {
      transform: translateY(-1.5rem);
    }
  }

  .how-i-think__number {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
  }

  .how-i-think__title {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .how-i-think__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
