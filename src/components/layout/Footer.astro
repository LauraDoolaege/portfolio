---
// Footer: one-line massive greeting sized to the container, the ask, and a links row.
// TODO: replace the "#" hrefs with the real LinkedIn URL and CV PDF path.
import Button from '../ui/Button.astro';
import Signature from '../ui/Signature.astro';
const email = 'laura.doolaege@student.howest.be';
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__fit">
      <p class="footer__greeting" aria-label="Nice to meet you!">
        <span class="footer__mask">
          <span class="footer__line">Nice to meet you!</span>
        </span>
      </p>
    </div>

    <div class="footer__sign">
      <p class="footer__ask subtitle">
        Looking for a 12 to 14 week internship from February to May 2027. Preferably with a strong
        focus on user experience design, interaction design, digital design.
      </p>
      <Signature class="footer__signature" />
    </div>

    <div class="footer__links">
      <Button variant="link" href={`mailto:${email}`}>
        {email}
      </Button>
      <Button variant="link" href="#" target="_blank" rel="noopener">
        LinkedIn
      </Button>
      <Button href="#" icon="down" data-magnetic>
        Download CV
      </Button>
      <p class="footer__legal">© Laura Doolaege, 2026</p>
    </div>

    <!-- Phones: the same three links as big, soft, outlined tiles that are easy to hit with a thumb -->
    <div class="footer__tiles">
      <a class="tile tile--wide" href={`mailto:${email}`}>
        <span class="tile__text">
          <span class="tile__label tag">Email</span>
          <span class="tile__value">{email}</span>
        </span>
        <svg class="tile__icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M3 9L9 3M4 3h5v5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </a>
      <a class="tile" href="#" target="_blank" rel="noopener">
        <span class="tile__text">
          <span class="tile__label tag">Say hi</span>
          <span class="tile__value">LinkedIn</span>
        </span>
        <svg class="tile__icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M3 9L9 3M4 3h5v5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </a>
      <a class="tile" href="#">
        <span class="tile__text">
          <span class="tile__label tag">PDF</span>
          <span class="tile__value">Download CV</span>
        </span>
        <svg class="tile__icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M6 1.5v6.5M3.5 5.5L6 8l2.5-2.5M1.5 10.5h9"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </a>
      <p class="footer__legal footer__legal--phone">© Laura Doolaege, 2026</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    /* Bottom padding leaves room for the fixed theme toggle (bottom-right) so it never sits on the legal line */
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 5rem) 5rem;
  }

  /* The line is ~7.5em wide, so size it from its own container (cqw) to fill exactly the container width at any viewport. */
  .footer__fit {
    container-type: inline-size;
  }

  .footer__greeting {
    /* Sized to fit the container with a little room: at 13.3cqw the line ran ~4% wider than its box and was clipped */
    font-size: 12.6cqw;
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    white-space: nowrap;
  }

  .footer__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  .footer__line {
    display: block;
  }

  .footer__sign {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .footer__ask {
    max-width: 36ch;
  }

  :global(.footer__signature) {
    width: clamp(6rem, 14vw, 12rem);
    height: auto;
    margin-left: auto;
    margin-right: clamp(0rem, 3vw, 4rem);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem clamp(1.5rem, 1rem + 2vw, 3rem);
    margin-top: clamp(3rem, 2rem + 5vw, 7rem);
    font-size: var(--text-body);
  }

  .footer__legal {
    margin-left: auto;
    color: var(--text-muted);
  }

  .footer__tiles {
    display: none;
  }

  /* Phones: text links in a wrapping row are fiddly, so the links become tiles (the address gets a full-width one) */
  @media (max-width: 699px) {
    .footer__links {
      display: none;
    }

    .footer__tiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 2.5rem;
    }

    .tile {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 0.75rem;
      min-height: 5rem;
      padding: 1rem 1.1rem;
      border: var(--hairline);
      border-radius: var(--radius);
      transition: background-color 0.3s var(--ease-out);
    }

    .tile:active {
      background: var(--tag-fill);
    }

    .tile--wide {
      grid-column: 1 / -1;
    }

    .tile__text {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: 0;
    }

    .tile__label {
      padding: 0;
      color: var(--text-muted);
    }

    .tile__value {
      font-size: var(--text-body);
      font-weight: var(--weight-medium);
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .tile__icon {
      flex: none;
      width: 1rem;
      height: 1rem;
    }

    .footer__legal--phone {
      grid-column: 1 / -1;
      margin: 0.75rem 0 0;
    }
  }

  @media (min-width: 700px) {
    .footer__legal--phone {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const line = document.querySelector<HTMLElement>('.footer__line');

  if (line && !prefersReducedMotion()) {
    // Set in JS so no-JS visitors still see the greeting.
    gsap.set(line, { yPercent: 105 });

    ScrollTrigger.create({
      trigger: '.footer__greeting',
      start: 'top 98%',
      once: true,
      onEnter: () => gsap.to(line, { yPercent: 0, duration: 1.4, ease: 'expo.out' }),
    });
  }
</script>
