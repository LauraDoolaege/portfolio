---
// Section 03: what's on the desk right now. Same rows as the philosophy section: the project on the
// left, its focus and a line about it in the rail.
import SectionLabel from '../ui/SectionLabel.astro';

const items = [
  {
    title: 'Ray Skincare',
    focus: '3D / Blender',
    description:
      'Translating a brand aesthetic into a 3D animated header. Exploring shading, texturing, and compositions in Blender.',
  },
  {
    title: 'Designing for Hedgehogs',
    focus: 'Non-human UX',
    description:
      'Researching non-human centric design. Mapping behaviors of actors you cannot communicate with directly to design beyond the human experience.',
  },
];
---

<section class="sec" aria-labelledby="desk-title">
  <div class="container">
    <header class="sec__head">
      <SectionLabel num="03" text="On my desk" data-reveal />
      <h2 id="desk-title" class="sec-title" data-reveal>
        On my desk right now
      </h2>
    </header>

    <ul>
      {items.map((item) => (
        <li class="row" data-reveal>
          <h3 class="lede">{item.title}</h3>
          <div class="row__rail">
            <p class="tag">{item.focus}</p>
            <p class="text">{item.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
