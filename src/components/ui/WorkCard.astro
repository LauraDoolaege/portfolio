---
// One project in the homepage work grid: the image at the group's fixed ratio, a hairline, then everything to read
// below it: title and type on one line, a few lines about the project, and its tools as chips.
// Without a cover yet, the image slot is a flat placeholder so the grid stays whole. Links to the case study.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/url';

interface Props {
  project: CollectionEntry<'works'>;
  /** Image sizes hint for the grid this card sits in */
  sizes: string;
}

const { project: p, sizes } = Astro.props;
const TYPE_LABEL = { ux: 'UX Strategy', visual: 'Visual Exploration' } as const;
const cover = p.data.coverImage;
const href = withBase(`/works/${p.id}`);
const tools = p.data.tools.slice(0, 3);
---

<li class="card" data-reveal>
  <a class="card__link" href={href}>
    <div class="card__media">
      {cover ? (
        <Image
          class="card__img"
          src={cover}
          alt={`${p.data.title}: cover`}
          widths={[400, 700, 1000, 1400]}
          sizes={sizes}
        />
      ) : (
        <div class="card__img card__img--empty" aria-hidden="true"></div>
      )}
      <span class="card__cta" aria-hidden="true">
        <span class="card__cta-label">
          View project
          <svg class="card__cta-icon" viewBox="0 0 12 12" fill="none">
            <path
              d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="square"
            />
          </svg>
        </span>
      </span>
    </div>
    <div class="card__body">
      <header class="card__top">
        <h4 class="card__title">{p.data.title}</h4>
        <p class="card__type">{TYPE_LABEL[p.data.type]}</p>
      </header>
      <p class="card__desc">{p.data.description}</p>
    </div>
    <ul class="card__tags" aria-label="Tools">
      {tools.map((t) => (
        <li class="card__chip">{t}</li>
      ))}
    </ul>
  </a>
</li>

<style>
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .card__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
  }

  .card__type {
    flex: none;
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  /* Every cover in a group is cropped to the same ratio (--ratio, set by the grid), so edges and baselines line up.
     Soft mask, spotlight and grain come from .card__media in global.css; the pan (x/y) and resting scale are GSAP's. */
  .card__media {
    aspect-ratio: var(--ratio, 4 / 3);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .card__img--empty {
    background: var(--frame-bg);
  }

  /* Hover call to action: a veil in the page background colour (light or dark) that arrives as sand, the same hard-edged wipe through #sand-dispersion as the
     button fill (--fill is registered in global.css), then the label fades in over it. Hover-capable devices only. */
  .card__cta {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: none;
    place-items: center;
    pointer-events: none;
  }

  .card__cta::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--bg-primary) 62%, transparent) var(--fill),
      transparent calc(var(--fill) + 45%)
    );
    filter: url(#sand-dispersion);
    transition: --fill 0.8s var(--ease-out);
  }

  .card__cta-label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: #c25e3e;
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
    font-weight: var(--weight-heavy);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .card__cta-icon {
    width: 0.8em;
    height: 0.8em;
  }

  @media (hover: hover) {
    .card__cta {
      display: grid;
    }

    .card__link:hover .card__cta::before,
    .card__link:focus-visible .card__cta::before {
      --fill: 100%;
    }

    .card__link:hover .card__cta-label,
    .card__link:focus-visible .card__cta-label {
      opacity: 1;
      transform: none;
      transition-delay: 0.25s;
    }
  }

  /* Everything to read sits under the line */
  .card__body {
    position: relative;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: var(--hairline);
  }

  .card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 52ch;
    font-size: var(--text-body);
    font-weight: var(--weight-light);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .card__chip {
    padding: 0.4em 0.8em;
    border: var(--hairline);
    font-size: var(--text-small);
    line-height: 1.2;
    color: var(--text-muted);
  }
</style>
