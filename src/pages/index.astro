---
// Homepage: nav + hero (step 2).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import WhyHow from '../components/sections/WhyHow.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
---

<BaseLayout title="Laura Doolaege" description="Laura's portfolio: digital development & design.">
  <div class="page">
    <Header />
    <Hero />
    <WhyHow />
    <SelectedWork />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
</style>
