---
// About page "How I work" (PROJECT_BRIEF.md Section 4/5, item 3): the
// analog-first process description. Copy is final, supplied directly by
// the user, kept verbatim except one em dash rewritten as a colon (see
// AboutStory's frontmatter comment - same reason).
//
// Was deliberately the one still section on this page (no scroll reveal,
// no grid break) - a page needs a quiet beat between its louder ones.
// Redesign pass (explicit feedback that the page's sections "feel too
// stale or too condensed"): this one specifically had zero imagery and
// zero motion, which read as underbuilt rather than "deliberately quiet"
// once the rest of the page gained placeholders and reveals of their
// own. It now gets a small scattered collage of image placeholders next
// to the text - a literal, not decorative, visualization of the copy's
// own language ("paper, whiteboards, sticky notes, messy diagrams"),
// which is what earns it a moment rather than staying the one section
// with nothing to look at. The scatter/settle motion echoes AboutDrives'
// own device one section below (tilted cards easing into their resting
// angle) rather than inventing a third animation recipe on one page.
import SectionMarker from '../ui/SectionMarker.astro';

const notes = [{ rotate: -4 }, { rotate: 3 }, { rotate: -2 }];
---

<section class="about-process">
  <div class="about-process__inner">
    <SectionMarker index="03" label="How I work" />

    <div class="about-process__row">
      <div class="about-process__column">
        <p class="about-process__lead">I like starting analog.</p>

        <p>
          Paper, whiteboards, sticky notes, messy diagrams: anything that lets ideas move faster
          than my concern for how they look.
        </p>

        <p>
          I especially enjoy collaborative ideation: getting different perspectives in the room,
          throwing ideas around, combining them and challenging each other's assumptions.
        </p>

        <p>
          Once the messy thinking starts to make sense, I move into digital tools and prototypes.
        </p>
      </div>

      <ul class="about-process__notes" aria-hidden="true">
        {notes.map((note) => (
          <li class="about-process__note" style={`--rotate: ${note.rotate}deg`}>
            <!-- TODO: replace with a real process/whiteboard/sticky-note image once photography exists (PROJECT_BRIEF.md Section 6) -->
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const notes = document.querySelectorAll<HTMLElement>('.about-process__note');
  if (notes.length && !prefersReducedMotion()) {
    notes.forEach((note, index) => {
      const targetRotate = note.style.getPropertyValue('--rotate');
      gsap.set(note, { autoAlpha: 0, y: 16, rotate: 0 });
      gsap.to(note, {
        autoAlpha: 1,
        y: 0,
        rotate: targetRotate,
        duration: 0.5,
        ease: 'back.out(1.2)',
        delay: index * 0.1,
        scrollTrigger: { trigger: note, start: 'top 92%' },
      });
    });
  }
</script>

<style>
  .about-process {
    padding-block: var(--space-section);
    /* Plate boundary - see AboutStory's matching rule for why. */
    border-top: var(--border-hairline) solid var(--color-text-secondary);
  }

  .about-process__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .about-process__row {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-24);
    align-items: start;
  }

  .about-process__column {
    grid-column: 2 / 8;
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-leading);
    color: var(--color-ink);
  }

  .about-process__lead {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.5vw + 1.25rem, 2.25rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .about-process__notes {
    grid-column: 9 / 13;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16);
  }

  .about-process__note {
    rotate: var(--rotate);
    aspect-ratio: 1;
    background: var(--color-bg-secondary);
    border: var(--border-hairline) solid var(--color-text-secondary);
    box-shadow: 0 10px 20px -14px rgb(23 21 15 / 0.3);
  }

  /* First tile spans both columns and sits taller - reads as the "main"
     sheet of paper with two smaller sticky notes layered around it,
     rather than three identical tiles in a grid. */
  .about-process__note:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }

  @media (max-width: 1023px) {
    .about-process__column {
      grid-column: 1 / 8;
    }

    .about-process__notes {
      grid-column: 8 / 13;
    }
  }

  @media (max-width: 639px) {
    .about-process__inner {
      padding-inline: 1.5rem;
    }

    .about-process__row {
      grid-template-columns: 1fr;
    }

    .about-process__column {
      grid-column: 1;
    }

    .about-process__notes {
      grid-column: 1;
      margin-top: var(--space-32);
      max-width: 20rem;
    }
  }
</style>
