---
// New section, explicit request: "at some point, I will have to also
// tell them what tools I use... think of a way to show it, use your
// judgement to add it to a section that makes sense for recruiters."
// Placed directly after "How I work" - a recruiter reading About already
// has process fit on their mind right there, so a toolkit list lands
// while that's still the active question, rather than being tacked onto
// the very end of the page as an afterthought.
//
// No real tool list was supplied yet ("I will have to also tell them" -
// a future action, not content given now), so this ships as a real,
// working section with clearly-labeled placeholder chips - the same
// "placeholder, not invented content" rule this project already applies
// to project titles/images (CLAUDE.md "Content") - rather than guessing
// at specific software names as fact. Swap the `tools` array below for
// the real list once supplied; the layout doesn't need to change.
//
// Reuses Tag.astro's own bracketed-label device (locked sitewide, see
// CLAUDE.md "Design system") instead of inventing a chip/pill style -
// tools read the same as the role tags already used across the site.
import SectionMarker from '../ui/SectionMarker.astro';
import Tag from '../ui/Tag.astro';

// TODO: replace with the real toolkit once supplied - keep the category
// grouping if it still fits, or flatten to one list if it doesn't.
const groups = [
  {
    label: 'Design',
    tools: ['Tool', 'Tool', 'Tool'],
  },
  {
    label: 'Prototyping & motion',
    tools: ['Tool', 'Tool'],
  },
  {
    label: 'Development',
    tools: ['Tool', 'Tool', 'Tool'],
  },
];
---

<section class="about-tools">
  <div class="about-tools__inner">
    <SectionMarker index="04" label="Tools I work with" />

    <div class="about-tools__groups">
      {groups.map((group) => (
        <div class="about-tools__group">
          <h3 class="about-tools__group-label">{group.label}</h3>
          <ul class="about-tools__list">
            {group.tools.map((tool) => (
              <li>
                <Tag>{tool}</Tag>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../../utils/motion';

  const groups = document.querySelectorAll<HTMLElement>('.about-tools__group');
  if (groups.length && !prefersReducedMotion()) {
    gsap.set(groups, { autoAlpha: 0, y: 16 });
    gsap.to(groups, {
      autoAlpha: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      stagger: 0.1,
      scrollTrigger: { trigger: '.about-tools__groups', start: 'top 88%' },
    });
  }
</script>

<style>
  .about-tools {
    padding-block: var(--space-section);
    border-top: var(--border-hairline) solid var(--color-text-secondary);
  }

  .about-tools__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-outer);
  }

  .about-tools__groups {
    margin-top: var(--space-48);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-32);
  }

  .about-tools__group-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .about-tools__list {
    margin-top: var(--space-16);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-16);
  }

  @media (max-width: 767px) {
    .about-tools__groups {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }
  }

  @media (max-width: 639px) {
    .about-tools__inner {
      padding-inline: 1.5rem;
    }
  }
</style>
