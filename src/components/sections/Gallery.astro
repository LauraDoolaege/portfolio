---
// Homepage "Gallery of older works / process screenshots" (PROJECT_BRIEF.md
// Section 4, item 3). No real images exist yet (Section 6) - flat gray
// placeholders, a sparse few tagged "[ process ]" to signal the
// documentary imagery mode (Section 3) without inventing specific content.
//
// Interaction model (explicit, detailed request - this is the third pass
// on this section, and each one replaced the previous mechanism rather
// than layering on top of it):
//
// The section pins in the viewport while the page scrolls through it: at
// rest, the big "Gallery" watermark fills roughly half the width on the
// left with just the first couple of tiles overlapping its tail end;
// scrolling down feeds that scroll input into a GSAP ScrollTrigger scrub
// instead of moving the page, sliding the tile track across (revealing
// the rest of the images) while the watermark slides out of the way to
// the left in the same motion; scrolling back up reverses it exactly
// (scrub ties the animation directly to scroll position, so "restore on
// scroll-back" is what scrub already does, not something built
// separately). Once the track finishes travelling, the pin releases and
// the page continues normally into "Currently working on."
//
// This replaced the previous build's independent auto-scrolling/
// draggable marquee (see AGENTS.md for that pass's own history) - once
// page scroll itself drives the horizontal motion, a separate auto-drift
// or drag-to-scroll gesture on the strip would fight the same input, so
// that whole mechanism (the infinite 3x-duplicated loop, scrollLeft
// accumulator, pointer-drag handlers) is gone, not layered under this.
// The hover-only bob survives from that pass unchanged (see below) -
// it's an orthogonal, tactile detail, not part of the scroll mechanism.
//
// Reduced motion: no pin, no scrub, no scroll-hijack of any kind - the
// track instead becomes a plain native-scrollable strip
// (overflow-x: auto), so every tile stays reachable without any
// scroll-driven motion. That's a functional equivalent with the motion
// removed, the same principle applied everywhere else in this project.
import SectionMarker from '../ui/SectionMarker.astro';

const TOTAL = 15;
const ASPECTS = ['wide', 'tall', 'square'] as const;
const FLOATS = ['up', 'flat', 'down'] as const;

const tiles = Array.from({ length: TOTAL }, (_, i) => ({
  number: String(i + 1).padStart(2, '0'),
  caption: i % 4 === 0 ? 'process' : undefined,
  aspectClass: ASPECTS[i % ASPECTS.length],
  // Offset by 1 from the aspect cycle so the two patterns don't lock
  // step and repeat identically every 3 tiles.
  floatClass: FLOATS[(i + 1) % FLOATS.length],
}));
---

<section class="gallery">
  <div class="gallery__inner">
    <SectionMarker index="03" label="Gallery" />
  </div>

  <div class="gallery__stage">
    <div class="gallery__viewport" data-total={TOTAL}>
      <ul class="gallery__track">
        <li class="gallery__hint" aria-hidden="true">
          Scroll
        </li>
        {tiles.map((tile, i) => (
          <li
            class={`gallery__tile gallery__tile--${tile.aspectClass} gallery__tile--${tile.floatClass}`}
            style={`z-index: ${i + 1}`}
          >
            <button
              type="button"
              class="gallery__trigger"
              data-index={i}
              aria-label={`View image ${tile.number} of ${TOTAL} larger`}
            >
              <span class="gallery__placeholder">
                {tile.caption && <span class="gallery__caption">[ {tile.caption} ]</span>}
                <span class="gallery__expand" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none">
                    <path
                      d="M2 6V2H6M10 2H14V6M14 10V14H10M6 14H2V10"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="gallery__progress" aria-hidden="true">
      <span class="gallery__progress-bar"></span>
    </div>
  </div>
</section>

<!--
  Deliberately a sibling of <section class="gallery">, not nested inside
  it: GSAP's pin sets an inline transform on whatever it pins while
  pinned (even an identity one), and any transform - not just a moving
  one - makes that element the containing block for its `position: fixed`
  descendants (same family of bug as AGENTS.md's stacking-context note on
  Hero's parallax). The whole section is the pin target now (see the
  script - title and stage pin together), so the cursor has to live
  outside the section entirely, not just outside .gallery__stage like
  before.

  Two elements, not one: GSAP's x/y follow (script) writes an inline
  `transform` on the outer .gallery__cursor every frame, which would
  silently override a CSS `transform: scale()` on the same element - the
  is-active state's scale-in never actually took effect once GSAP had
  touched the property, another instance of the same "GSAP vs static
  transform" conflict documented elsewhere in this file. The inner
  .gallery__cursor-inner instead owns the CSS transform/opacity for the
  hover state, so the two never fight over the same property.
-->
<div class="gallery__cursor" aria-hidden="true">
  <span class="gallery__cursor-inner">View</span>
</div>

<!--
  Same reasoning as the cursor above for living outside <section
  class="gallery"> - a fixed, full-viewport element, so it can't be a
  descendant of anything GSAP might transform while pinning. The "hole"
  is a single small box-shadow trick (0 0 0 9999px), not a page-wide dim
  layer plus a raised tile: the hovered tile never needs its own z-index
  above this at all, since a box-shadow never paints inside its own
  element's box - whatever's genuinely underneath that rectangle (the
  real tile, in normal DOM order) just shows through unobscured, while
  everywhere else on the page goes dark. Positioned/sized to match
  whichever trigger is hovered, per direct request ("when one card is
  hovered it should be clear that this is in focus, with the rest of the
  page temporarily darkening, like in the image preview" - i.e. the
  lightbox's own full-viewport backdrop, reused here as a hover cue).
-->
<div class="gallery__spotlight" aria-hidden="true"></div>

<div
  class="lightbox"
  id="gallery-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  hidden
>
  <button type="button" class="lightbox__backdrop" aria-label="Close image viewer"></button>

  <!--
    Close/prev/next are pinned to the lightbox's own (viewport) edges, not
    laid out as flex-siblings of the image: a flex row of [prev, image,
    next] adds each control's width on top of the image's own width, which
    stopped fitting in a phone-width viewport (the next button measured
    outside the 390px viewport entirely - a real bug, caught via
    getBoundingClientRect, not visual guesswork). Pinning to the edges
    means the controls' position never depends on the image's size.
  -->
  <button type="button" class="lightbox__close" aria-label="Close">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M4 4L12 12M12 4L4 12"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
      />
    </svg>
  </button>

  <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Previous image">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M13 8H3M3 8L6.75 4.25M3 8L6.75 11.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Next image">
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M3 8H13M13 8L9.25 4.25M13 8L9.25 11.75"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <div class="lightbox__stage">
    <span class="lightbox__placeholder">
      <span class="lightbox__number" aria-hidden="true"></span>
    </span>
    <p class="lightbox__counter">
      <span class="lightbox__current">1</span> / <span>{TOTAL}</span>
    </p>
  </div>
</div>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../utils/motion';

  const section = document.querySelector<HTMLElement>('.gallery');
  const inner = document.querySelector<HTMLElement>('.gallery__inner');
  const stage = document.querySelector<HTMLElement>('.gallery__stage');
  const viewport = document.querySelector<HTMLElement>('.gallery__viewport');
  const track = document.querySelector<HTMLElement>('.gallery__track');
  const progressBar = document.querySelector<HTMLElement>('.gallery__progress-bar');
  const cursor = document.querySelector<HTMLElement>('.gallery__cursor');
  const spotlight = document.querySelector<HTMLElement>('.gallery__spotlight');
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxStage = lightbox?.querySelector<HTMLElement>('.lightbox__stage');
  const lightboxPlaceholder = lightbox?.querySelector<HTMLElement>('.lightbox__placeholder');
  const lightboxCounter = lightbox?.querySelector<HTMLElement>('.lightbox__counter');
  const numberEl = lightbox?.querySelector<HTMLElement>('.lightbox__number');
  const currentEl = lightbox?.querySelector<HTMLElement>('.lightbox__current');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__close');
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__nav--prev');
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__nav--next');
  const backdrop = lightbox?.querySelector<HTMLButtonElement>('.lightbox__backdrop');

  if (
    section &&
    inner &&
    stage &&
    viewport &&
    track &&
    lightbox &&
    lightboxStage &&
    lightboxPlaceholder &&
    lightboxCounter &&
    numberEl &&
    currentEl &&
    closeBtn &&
    prevBtn &&
    nextBtn &&
    backdrop
  ) {
    const reduceMotion = prefersReducedMotion();
    const total = Number(viewport.dataset.total || '0');

    // Whichever trigger currently has the pointer inside it, per the
    // shared tracker set up below (alongside the hover-driven effects
    // further down) - read from the pin's own onUpdate to cut hover
    // state short the instant scrolling moves the track. See that
    // tracker's own comment for why this needs to exist at all.
    let hoveredTrigger: HTMLElement | null = null;

    if (reduceMotion) {
      // No pin, no scrub, no scroll-hijack - a plain native horizontal
      // strip instead, so every tile stays reachable with zero
      // scroll-driven motion (see the file header comment).
      viewport.classList.add('gallery__viewport--static');

      // Progress line still tracks position, just driven by the native
      // scroll position instead of a ScrollTrigger - same "functional
      // equivalent, motion removed" idea: the line itself doesn't move
      // under motion, it just reflects a value.
      if (progressBar) {
        const syncProgress = () => {
          const max = viewport.scrollWidth - viewport.clientWidth;
          const progress = max > 0 ? viewport.scrollLeft / max : 0;
          progressBar.style.transform = `scaleX(${progress})`;
        };
        viewport.addEventListener('scroll', syncProgress, { passive: true });
        syncProgress();
      }
    } else {
      // --- Scroll-linked stack, v2: the track still slides the whole
      // way across, exactly like the original strip did (see this
      // section's earlier passes) - the difference is that once a
      // tile's own natural, track-adjusted position reaches the first
      // tile's spot, it locks there instead of continuing to slide off
      // to the left with everything else, so it visibly piles on top of
      // the first tile rather than sliding past it.
      //
      // The first version of this pass (tiles individually tweened onto
      // a *fixed* target with the track itself frozen) broke down past
      // ~5 tiles: with the track no longer moving, every tile beyond
      // whichever ones fit in the original viewport-width strip started
      // out far off past the right edge - each one's own entrance still
      // played correctly once its turn came, but getting there took a
      // long stretch of scroll with nothing visibly happening, since
      // nothing was bringing the next tile within reach ahead of time.
      // Per direct follow-up ("the scroll should still move to the
      // left, as should the deck of images... so there are no huge
      // gaps") - this version keeps the track's own continuous motion,
      // which is what actually keeps the queue arriving at a steady
      // pace, and layers the "lock onto the first tile" behavior on
      // top of it instead of replacing it.
      //
      // The math: tile 0's own local x is set every tick to exactly
      // cancel however far the track has moved (`startInset - trackX`),
      // which is what makes it - and only it - stay visually fixed at
      // its starting screen position for the entire scroll, the one
      // anchor everything else piles onto. Every other tile rides along
      // with the track uncorrected (localX: 0) until the scroll
      // progress reaches its own `arrival` value - the exact progress
      // at which its natural (track-adjusted) position first coincides
      // with tile 0's fixed spot, solved once from the tiles' own
      // static layout positions - at which point it switches to the
      // same kind of compensation tile 0 uses, anchoring it at that
      // same fixed spot for the rest of the scroll. Continuous by
      // construction (both branches agree at progress === arrival), so
      // there's no jump the moment a tile locks in.
      const startInset = parseFloat(getComputedStyle(inner).paddingLeft) || 0;
      const triggers = Array.from(viewport.querySelectorAll<HTMLElement>('.gallery__trigger'));
      const tiles = triggers.map((trigger) => trigger.closest<HTMLElement>('.gallery__tile'));

      const measure = () => {
        const trackEndX = -(track.scrollWidth - viewport.clientWidth);
        return { trackStartX: startInset, trackEndX, travel: startInset - trackEndX };
      };

      // Progress (0..1) at which each tile's natural position reaches
      // tile 0's fixed spot. Recomputed on every ScrollTrigger refresh
      // (resize), same as `measure()` - these depend on the tiles' own
      // offsetLeft, which the responsive tile width can change.
      const computeArrivals = () => {
        const { trackStartX, trackEndX } = measure();
        const denom = trackEndX - trackStartX;
        const tile0Left = tiles[0]?.offsetLeft ?? 0;
        return tiles.map((tile) => {
          if (!tile || denom === 0) return 0;
          return (tile0Left - tile.offsetLeft) / denom;
        });
      };

      let arrivals = computeArrivals();
      const SETTLE = 0.02; // fraction of total scroll the shrink/tilt eases over, right as the next tile locks in

      gsap.set(track, { x: measure().trackStartX });

      ScrollTrigger.create({
        // The whole section (title included), not just the stage, is
        // both the trigger and the pin target - per direct feedback
        // that the title was scrolling away from the gallery while
        // only the tile strip stayed pinned. Pinning the section keeps
        // the title and the strip locked together for the whole scrub,
        // exactly like the trigger's own top-level Astro markup groups
        // them. "top top" - the pin engages once the section's own top
        // reaches the top of the viewport - reads as "once the section
        // is into full view" for this section's height, and pinning
        // the section (which starts higher up the page than the stage
        // alone did) reaches that point with less scrolling than
        // before, without needing a separate earlier-start hack.
        trigger: section,
        start: 'top top',
        end: () => `+=${measure().travel}`,
        pin: true,
        scrub: 1,
        invalidateOnRefresh: true,
        onRefresh: () => {
          arrivals = computeArrivals();
        },
        onUpdate: (self) => {
          const { trackStartX, trackEndX } = measure();
          const trackX = trackStartX + self.progress * (trackEndX - trackStartX);
          gsap.set(track, { x: trackX });

          if (progressBar) progressBar.style.transform = `scaleX(${self.progress})`;
          // Scrolling moves tiles under the cursor without ever firing a
          // pointer event (the mouse itself hasn't moved), so nothing
          // would otherwise tell a hovered tile's bob-pause, mouse-shift,
          // cursor, or spotlight that it's no longer actually under the
          // pointer - they'd stay frozen mid-tween, pointed at stale
          // geometry, or (for the spotlight) visibly drift away still
          // glued to a tile that moved somewhere else. Dispatching a
          // real pointerleave here reuses each effect's own existing
          // cleanup below rather than duplicating it - every scroll tick
          // is treated as an implicit "stopped hovering," and nothing
          // re-engages until an actual pointermove says otherwise.
          if (hoveredTrigger) {
            hoveredTrigger.dispatchEvent(new PointerEvent('pointerleave'));
            hoveredTrigger = null;
          }

          triggers.forEach((trigger, i) => {
            const arrival = arrivals[i];
            const x =
              self.progress >= arrival ? -(self.progress - arrival) * (trackEndX - trackStartX) : 0;

            // The tile being covered shrinks and tilts rather than just
            // sitting still underneath, easing in right as the next one
            // locks into place - the last tile has no successor, so it
            // never gets covered and stays full-size. Alternating the
            // rotation direction per index keeps the growing pile from
            // all leaning the same way, which read as mechanical rather
            // than like a loosely stacked deck.
            const nextArrival = arrivals[i + 1];
            let scale = 1;
            let rotation = 0;
            if (nextArrival !== undefined) {
              const t = Math.min(1, Math.max(0, (self.progress - (nextArrival - SETTLE)) / SETTLE));
              scale = 1 - t * 0.1;
              rotation = t * (i % 2 === 0 ? -4 : 4);
            }

            gsap.set(trigger, { x, scale, rotation });
          });
        },
      });
    }

    // Tracks which trigger the pointer is actually inside, purely so the
    // pin's onUpdate above has something to dispatch a synthetic
    // pointerleave at when the track scrolls out from under a stationary
    // cursor - not an effect of its own, just bookkeeping the hover
    // effects below don't otherwise need each other to know about.
    //
    // Also lifts the hovered tile's z-index above the whole stack while
    // it's active, so hovering a partially-covered tile brings it fully
    // into view instead of leaving it stuck under its neighbor - the
    // deck-of-cards overlap (see .gallery__tile's own CSS comment) means
    // most tiles start out partly hidden, so this is what makes each one
    // actually reachable to look at, not just a decorative stacking
    // effect. Each tile's own resting z-index (set server-side, per
    // index) is read once up front and restored on pointerleave, rather
    // than cleared outright - clearing it would leave the tile with no
    // z-index at all instead of putting it back in its place in the deck.
    if (!reduceMotion) {
      viewport.querySelectorAll<HTMLElement>('.gallery__trigger').forEach((trigger) => {
        const tile = trigger.closest<HTMLElement>('.gallery__tile');
        const restingZIndex = tile?.style.zIndex ?? '';

        trigger.addEventListener('pointerenter', () => {
          hoveredTrigger = trigger;
          if (tile) tile.style.zIndex = '100';
        });
        trigger.addEventListener('pointerleave', () => {
          if (hoveredTrigger === trigger) hoveredTrigger = null;
          if (tile) tile.style.zIndex = restingZIndex;
        });
      });
    }

    // Continuous "breathing" bob: every tile's trigger (not the tile
    // itself - see the file header comment on why) drifts a few px up
    // and down in a slow, soft loop for as long as the page is open, not
    // just while the section is hovered - per direct request, hovering a
    // specific tile should freeze only that one, while the rest keep
    // breathing. A per-tile duration offset keeps them from moving in
    // perfect unison, which would read as one mechanical pulse instead
    // of something organic. Independent of the scroll-pin above - both
    // can run at once without conflict (different elements, different
    // GSAP properties).
    if (!reduceMotion) {
      const triggers = Array.from(viewport.querySelectorAll<HTMLElement>('.gallery__trigger'));
      const bobTweens = triggers.map((el, i) =>
        gsap.to(el, {
          y: 7,
          duration: 2.4 + (i % 5) * 0.2,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true,
        }),
      );

      // Pausing (not killing) freezes the tile exactly where it is in its
      // cycle; resuming continues from that same point rather than
      // restarting or snapping back to a rest position, so the freeze
      // itself reads as "this one stopped," not as a separate animation.
      triggers.forEach((trigger, i) => {
        trigger.addEventListener('pointerenter', () => bobTweens[i].pause());
        trigger.addEventListener('pointerleave', () => bobTweens[i].resume());
      });
    }

    // Mouse-magnetic tile shift, per direct request ("like a lot of
    // Awwwards type websites, the images kind of shift to the mouse
    // position") - the placeholder drifts a few px toward wherever the
    // cursor sits within the tile, on top of its existing hover scale.
    // Same technique and gating as ProjectCard.astro's version (see that
    // file's own comment); gallery tiles don't have ProjectCard's
    // separate frame/image split, so the shift and scale both land on
    // .gallery__placeholder directly - it already owns overflow: hidden
    // and the border/radius, and moving the whole thing a few px is the
    // same "the card leans toward you" read the Awwwards reference has,
    // just without an inner image layer to isolate it to yet.
    if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      const SHIFT_RANGE = 16;

      viewport.querySelectorAll<HTMLElement>('.gallery__trigger').forEach((trigger) => {
        const placeholder = trigger.querySelector<HTMLElement>('.gallery__placeholder');
        if (!placeholder) return;

        const moveX = gsap.quickTo(placeholder, 'x', { duration: 0.5, ease: 'power3.out' });
        const moveY = gsap.quickTo(placeholder, 'y', { duration: 0.5, ease: 'power3.out' });

        trigger.addEventListener('pointerenter', () => {
          gsap.to(placeholder, { scale: 1.05, duration: 0.5, ease: 'power2.out' });
        });
        trigger.addEventListener('pointermove', (event) => {
          const rect = trigger.getBoundingClientRect();
          const relX = (event.clientX - rect.left) / rect.width - 0.5;
          const relY = (event.clientY - rect.top) / rect.height - 0.5;
          moveX(relX * SHIFT_RANGE);
          moveY(relY * SHIFT_RANGE);
        });
        trigger.addEventListener('pointerleave', () => {
          gsap.to(placeholder, { x: 0, y: 0, scale: 1, duration: 0.6, ease: 'power3.out' });
        });
      });
    }

    // Custom "View" cursor: a small circle that follows the pointer and
    // only appears over a tile, replacing the system cursor there. Gated
    // on a fine pointer (mouse/trackpad) as well as reduced motion - on
    // touch there's no hover to react to, and the lag below is motion
    // that reduced-motion users didn't ask for.
    //
    // Listeners are bound per-trigger, not delegated via a single
    // viewport-level pointermove: binding directly to the element that's
    // actually supposed to trigger the cursor is simpler to reason about
    // and doesn't depend on event bubbling still working the way this
    // first version assumed. On pointerenter the cursor snaps to the
    // entry point immediately (gsap.set, not the eased quickTo) before
    // switching to the smooth follow for movement within the tile - the
    // first version let quickTo ease in from wherever it last was
    // (often (0,0), off in the corner), which read as broken rather than
    // as a deliberate lag.
    if (!reduceMotion && cursor && window.matchMedia('(pointer: fine)').matches) {
      viewport.classList.add('gallery__viewport--custom-cursor');
      const moveX = gsap.quickTo(cursor, 'x', { duration: 0.35, ease: 'power3.out' });
      const moveY = gsap.quickTo(cursor, 'y', { duration: 0.35, ease: 'power3.out' });

      viewport.querySelectorAll<HTMLElement>('.gallery__trigger').forEach((trigger) => {
        trigger.addEventListener('pointerenter', (event) => {
          gsap.set(cursor, { x: event.clientX, y: event.clientY });
          cursor.classList.add('is-active');
        });
        trigger.addEventListener('pointermove', (event) => {
          moveX(event.clientX);
          moveY(event.clientY);
        });
        trigger.addEventListener('pointerleave', () => cursor.classList.remove('is-active'));
      });
    }

    // Spotlight: dims the rest of the page while a tile is hovered, so
    // that one tile reads as clearly in focus - per direct request,
    // echoing the lightbox's own full-viewport backdrop as a hover cue
    // rather than inventing a separate visual language for it. Gated the
    // same way as the custom cursor - reduced motion and touch both skip
    // it, since it's a decorative focus cue, not something the gallery
    // depends on to stay usable.
    //
    // Tracked on a gsap.ticker loop rather than positioned once on
    // pointerenter: the mouse-magnetic shift above moves and scales the
    // placeholder continuously while it's hovered, and a one-time
    // snapshot of the trigger's own (unmoving) rect drifted out of sync
    // with it almost immediately - confirmed visually, the hole sat still
    // while the tile shifted out from under it. Reading the placeholder's
    // own getBoundingClientRect() every frame instead means the hole
    // always matches whatever's actually on screen, including that
    // shift and its scale, without the spotlight needing to know
    // anything about how the placeholder got there.
    if (!reduceMotion && spotlight && window.matchMedia('(pointer: fine)').matches) {
      let activePlaceholder: HTMLElement | null = null;

      const syncSpotlight = () => {
        if (!activePlaceholder) return;
        const rect = activePlaceholder.getBoundingClientRect();
        spotlight.style.left = `${rect.left}px`;
        spotlight.style.top = `${rect.top}px`;
        spotlight.style.width = `${rect.width}px`;
        spotlight.style.height = `${rect.height}px`;
      };

      viewport.querySelectorAll<HTMLElement>('.gallery__trigger').forEach((trigger) => {
        trigger.addEventListener('pointerenter', () => {
          activePlaceholder = trigger.querySelector<HTMLElement>('.gallery__placeholder');
          syncSpotlight();
          gsap.ticker.add(syncSpotlight);
          spotlight.classList.add('is-active');
        });
        trigger.addEventListener('pointerleave', () => {
          gsap.ticker.remove(syncSpotlight);
          activePlaceholder = null;
          spotlight.classList.remove('is-active');
        });
      });
    }

    // --- Lightbox ---
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const label = (i: number) => String(i + 1).padStart(2, '0');

    const render = () => {
      numberEl.textContent = `[ ${label(currentIndex)} ]`;
      currentEl.textContent = String(currentIndex + 1);
    };

    const step = (delta: number) => {
      currentIndex = (currentIndex + delta + total) % total;
      render();
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeLightbox();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'Tab') {
        const focusable = [closeBtn, prevBtn, nextBtn];
        const activeIndex = focusable.indexOf(document.activeElement as HTMLButtonElement);
        event.preventDefault();
        const dir = event.shiftKey ? -1 : 1;
        const nextFocus = focusable[(activeIndex + dir + focusable.length) % focusable.length];
        nextFocus?.focus();
      }
    };

    // FLIP (First/Last/Invert/Play): reads the origin tile's current box
    // ("first"), diffs it against the lightbox image's own natural,
    // already-laid-out box ("last"), and plays that difference as a
    // transform. The browser never actually renders an intermediate
    // layout state - only a GPU transform tween - which is what makes a
    // FLIP read as one continuous, physical motion ("the card becomes the
    // detail view") instead of two separate effects (a fade plus an
    // unrelated move) layered on top of each other. Center-to-center deltas
    // rather than edge deltas, since the placeholder's own transform-origin
    // is centered - matching origins on both sides of the diff is what
    // keeps the math correct.
    const flipDelta = (fromEl: HTMLElement, toEl: HTMLElement) => {
      const from = fromEl.getBoundingClientRect();
      const to = toEl.getBoundingClientRect();
      return {
        x: from.left + from.width / 2 - (to.left + to.width / 2),
        y: from.top + from.height / 2 - (to.top + to.height / 2),
        scaleX: from.width / to.width,
        scaleY: from.height / to.height,
      };
    };

    // The tile currently associated with whichever image is on screen -
    // looked up fresh by data-index rather than trusting the trigger the
    // lightbox was originally opened from, so closing after stepping to a
    // different image (prev/next) flies back into the right tile, not
    // wherever the very first click happened to land.
    const currentTrigger = () =>
      viewport.querySelector<HTMLElement>(`.gallery__trigger[data-index="${currentIndex}"]`);

    function closeLightbox() {
      const finish = () => {
        lightbox!.hidden = true;
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
        gsap.set(lightboxPlaceholder!, { clearProps: 'transform' });
        lastFocused?.focus();
      };
      if (!reduceMotion) {
        const origin = currentTrigger()?.querySelector<HTMLElement>('.gallery__placeholder');
        const chrome = [closeBtn, prevBtn, nextBtn, lightboxCounter];
        gsap.to(backdrop!, { opacity: 0, duration: 0.35, ease: 'sine.inOut' });
        gsap.to(chrome, { opacity: 0, duration: 0.25, ease: 'sine.inOut' });
        if (origin) {
          gsap.to(lightboxPlaceholder!, {
            ...flipDelta(origin, lightboxPlaceholder!),
            duration: 0.5,
            ease: 'power3.inOut',
            onComplete: finish,
          });
        } else {
          // Origin tile isn't in the DOM for some reason - fall back to a
          // plain fade rather than leaving the placeholder stuck mid-animation.
          gsap.to(lightboxPlaceholder!, { opacity: 0, duration: 0.35, onComplete: finish });
        }
      } else {
        finish();
      }
    }

    const openLightbox = (index: number, trigger: HTMLElement) => {
      currentIndex = index;
      lastFocused = trigger;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';

      if (!reduceMotion) {
        // Already-hovered state shouldn't linger, visually hidden but
        // still "active," underneath the now-opaque lightbox - including
        // the clicked tile's own mouse-shift, which otherwise has no
        // event to reset it from (opening the lightbox doesn't itself
        // move the pointer, so the tile it's covering never gets a
        // pointerleave to snap back to neutral on its own).
        cursor?.classList.remove('is-active');
        spotlight?.classList.remove('is-active');
        gsap.set(viewport.querySelectorAll('.gallery__placeholder'), { x: 0, y: 0, scale: 1 });

        // Backdrop + chrome fade in as before; the image itself never
        // fades (stays at opacity: 1 throughout) - it's already fully
        // visible the instant the tile was clicked, it just grows into
        // its final position/size, so fading it too would read as two
        // competing motions instead of one.
        gsap.set(backdrop, { opacity: 0 });
        gsap.set([closeBtn, prevBtn, nextBtn, lightboxCounter], { opacity: 0 });
        gsap.to(backdrop, { opacity: 1, duration: 0.4, ease: 'sine.inOut' });
        gsap.to([closeBtn, prevBtn, nextBtn, lightboxCounter], {
          opacity: 1,
          duration: 0.4,
          ease: 'sine.inOut',
          delay: 0.15,
        });

        const origin = trigger.querySelector<HTMLElement>('.gallery__placeholder') ?? trigger;
        gsap.set(lightboxPlaceholder, flipDelta(origin, lightboxPlaceholder!));
        gsap.to(lightboxPlaceholder, {
          x: 0,
          y: 0,
          scaleX: 1,
          scaleY: 1,
          duration: 0.65,
          ease: 'power3.out',
        });
      }
      closeBtn.focus();
      document.addEventListener('keydown', onKeydown);
    };

    viewport.querySelectorAll<HTMLButtonElement>('.gallery__trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        openLightbox(Number(trigger.dataset.index), trigger);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    backdrop.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
  }
</script>

